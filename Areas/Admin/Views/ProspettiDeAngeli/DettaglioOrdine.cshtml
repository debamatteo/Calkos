                </div>




            </div>

            @* ============================================================
               Prima RIGA TOTALI
               ============================================================ *@
            <div class="row g-3 mt-2">

                <!-- Totale Fisso = (ValoreProvvigioneFissa1* Quantita)+(ValoreProvvigioneFissa1 * Quantita)+( [8% Fissa] * Quantita) -->
                <div class="col-md-3">
                    <label class="form-label fw-bold">Totale Fisso</label>
                    <div class="input-group">
                        <input type="number"
                               step="any"
                               id="TotaleFissoProvvigioneDisplay"
                               class="form-control input-readonly"
                               readonly
                               value="@FDisplay(Model.TotaleFissoProvvigione, 3)"
                               title="Totale Fisso = ([1,5% fissa] * Quantita)+([3% Fissa] * Quantita)+( [8% Fissa] * Quantita)" />
                        <button type="button" id="toggleTotaleFissoProvvigione" class="btn btn-success">
                            <i class="bi bi-lock-fill"></i>
                        </button>
                    </div>
                    <input type="hidden" id="TotaleFissoProvvigione" name="TotaleFissoProvvigione" value="@FTecnico(Model.TotaleFissoProvvigione, 6)" />
                </div>

                <!-- Delta=Differenza
                    Delta = Vendita - (Materiale + Lavorazione con commissione)
                    Delta = PrezzoVendita – PrezzoConLavorazione
                -->
                <div class="col-md-3">
                    <label class="form-label fw-bold">Differenza</label>
                    <div class="input-group">
                        <input type="number"
                               step="any"
                               id="DifferenzaDisplay"
                               class="form-control input-readonly"
                               readonly
