                        </button>
                    </div>

                    <input type="hidden"
                           id="ValoreProvvigioneFissa1"
                           name="ValoreProvvigioneFissa1"
                           value="@FTecnico(Model.ValoreProvvigioneFissa1, 6)" />
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-bold">3% Fissa</label>
                    <div class="input-group">
                        <input type="number"
                               step="any"
                               id="ValoreProvvigioneFissa2Display"
                               class="form-control input-readonly"
                               readonly
