@section Scripts {
    <script>
        $(document).ready(function () {

            /**
             * ============================================================
             * CENTRALIZZAZIONE ANTIFORGERY
             * Aggiunge automaticamente il token CSRF a tutte le chiamate
             * AJAX jQuery, evitando di doverlo passare manualmente ogni volta.
             * ============================================================
             */
            $.ajaxSetup({
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                }
            });

            /**
             * ============================================================
             * IMPOSTAZIONE INIZIALE FLAG INDICATORE MAGGIORAZIONE
             * Necessario perché la select HTML non mantiene il valore
             * selezionato automaticamente: va impostato via JS dal Model.
             * ============================================================
             */
            $("#FlagIndicatoreMaggiorazione").val(
                "@(Model.FlagIndicatoreMaggiorazione == null
                                                                    ? ""
                                                                    : (Model.FlagIndicatoreMaggiorazione.Value ? "true" : "false"))");

    /**
     * ============================================================
     * CONFIGURAZIONE DECIMALI CENTRALIZZATA
     * Deve essere allineata con le costanti C# in cima alla view:
     *   DECIMALI_TECNICI  → usati nei campi hidden (inviati al server)
     *   DECIMALI_DISPLAY  → usati nei campi visibili all'utente
     * ============================================================
     */


            const DECIMALI_TECNICI = 4;
            const DECIMALI_DISPLAY = 4;

            // 13/05/2026 — MODIFICA: aggiunto Number.EPSILON prima di toFixed.
            // Problema: V8 (Chrome/Edge) rappresenta alcune moltiplicazioni decimali
            // con errore IEEE 754. Esempio: 14.85*0.015 = 0.22274999999999998
            // (appena sotto 0.22275), quindi toFixed(4) arrotonda a 0.2227 invece di 0.2228.
            // Excel e C# Decimal usano aritmetica a precisione fissa e producono 0.2228.
            // I valori nel DB sono stati calcolati da C# con MidpointRounding.AwayFromZero
            // (equivalente all'half-up di Excel), quindi JS deve replicare lo stesso risultato.
            // Number.EPSILON = 2.22e-16 compensa l'errore di rappresentazione IEEE 754
            // senza alcun impatto sui valori già esatti (es. 1.22 + 2.22e-16 ≈ 1.22).
            // Verificato in console browser:
            //   (0.22274999999999998).toFixed(4)                  → "0.2227" ✗
            //   (0.22274999999999998 + Number.EPSILON).toFixed(4) → "0.2228" ✓
            // Stessa modifica applicata su DettaglioOrdine.cshtml di ElektraWire e Cobral.
            function roundTec(v) {
            return Number((toNum(v) + Number.EPSILON).toFixed(DECIMALI_TECNICI));
            }

            function roundDisplay(v) {
            return Number((toNum(v) + Number.EPSILON).toFixed(DECIMALI_DISPLAY));
            }


            /**
             * ============================================================
             * HELPER NUMERICI
             * ============================================================
             */

            /**
             * toNum — conversione grezza stringa → numero.
             * Gestisce: null, undefined, stringa vuota, virgola decimale.
             * Restituisce sempre 0 in caso di fallimento (mai NaN).
             */
            function toNum(v) {
                if (v === null || v === undefined) return 0;
                if (typeof v === "string") {
                    v = v.replace(',', '.').trim();
                    if (v === "") return 0;
                }
                const n = parseFloat(v);
                return isNaN(n) ? 0 : n;
            }

            /**
             * safeNum — bonifica un valore già letto (variabile JS o $(this).val()).
             * Uso: safeNum($(this).val())  oppure  safeNum(miaVariabile)
             * Accetta un fallback opzionale (default: 0).
             */
            function safeNum(v, fallback) {
                if (fallback === undefined) fallback = 0;
                if (v === null || v === undefined) return fallback;
                if (typeof v === "string") {
                    v = v.replace(',', '.').trim();
                    if (v === "") return fallback;
                }
                const n = parseFloat(v);
                if (isNaN(n) || !isFinite(n)) return fallback;
                return n;
            }

            /**
             * safeField — legge un campo jQuery dal DOM e lo bonifica.
             * Uso: safeField("#MioCampo")  invece di  toNum($("#MioCampo").val())
             * Emette un warning in console se il selettore non trova nulla.
             */
            function safeField(selector, fallback) {
                if (fallback === undefined) fallback = 0;
                const el = $(selector);
                if (el.length === 0) {
                    console.warn("safeField: campo non trovato →", selector);
                    return fallback;
                }
                return safeNum(el.val(), fallback);
            }

            /**
             * ============================================================
             * REGOLA DI SCELTA TRA safeNum e safeField
             * ============================================================
             *
             *  safeField("#MioCampo")   → quando leggi direttamente dal DOM
             *  safeNum($(this).val())   → quando hai già il valore in una variabile
             *
             *  Mnemonica: vedi il cancelletto "#"? → safeField.
             *             Hai già il valore? → safeNum.
             */

            /**
             * ============================================================
             * VARIABILI DI STATO LUCCHETTI
             * true  = calcolo automatico attivo (lucchetto chiuso, verde)
             * false = valore forzato manualmente (lucchetto aperto, rosso)
             *
             * NOTA su Perc_Delta_Provvigione:
             * NON ha un lock di calcolo perché NON è un campo calcolato.
             * È un valore inserito manualmente dall'utente (estratto da
             * formula Excel ma non ricalcolato automaticamente dalla view).
             * Il suo lucchetto gestisce solo l'editabilità UI.
             * Partecipa ai calcoli SOLO come input di TotaleVariabileProvvigione.
             *
             * Tutti i lock partono true e vengono corretti da rilevaDivergenze()
             * prima del primo ricalcolaTutto().
             * ============================================================
             */
            let lockValoreProvvigioneVariabile   = true;
            let lockValoreProvvigioneFissa1      = true;
            let lockValoreProvvigioneFissa2      = true;
            let lockValoreProvvigioneFissa3      = true;
            let lockDifferenza                   = true;
            let lockTotaleFissoProvvigione       = true;
            let lockTotaleVariabileProvvigione   = true;
            let lockTotaleProvvigioneDaFatturare = true;
            let lockProvAgente                   = true;
           // 2a — variabile lock (nel blocco variabili di stato):
            let lockPrezzoConLavorazione         = true;// 13/05/2026 — AGGIUNTA: lock per PrezzoConLavorazione.campo calcolato (CostoLavorazione + Prezzo)

        /**
                   * ============================================================
                   * FUNZIONI DI CALCOLO PURE (senza side-effect)
                   * Queste funzioni SOLO calcolano e restituiscono il valore.
                   * Non scrivono nulla nel DOM. Servono a due scopi:
                   *   1. Essere chiamate da rilevaDivergenze() al caricamento
                   *      per capire se un campo è stato forzato nel DB.
                   *   2. Essere richiamate dalle funzioni "ricalcola*" che
                   *      invece scrivono nel DOM.
                   *
                   * CONVENZIONI DeAngeli:
                   *   PercentualeProvvigioneVariabile → formato intero (es. 5 = 5%) → dividi per 100 nel calcolo.
                   *                                     È un INPUT DELL'UTENTE, non calcolato dalla view.
                   *   Perc_Delta_Provvigione          → formato intero (es. 40 = 40%) → dividi per 100 nel calcolo.
                   *                                     È un INPUT MANUALE, non calcolato dalla view.
                   *   FlagIndicatoreMaggiorazione     → "true"/"false" come stringa (valore della select).
                   * ============================================================
                   */

                    function calcola_ValoreProvvigioneVariabile() {
                        const percVar  = safeField("#PercentualeProvvigioneVariabile");
                        const costoLav = safeField("#PrezzoConLavorazione");
                        return roundTec(percVar === 0 ? 0 : costoLav * (percVar / 100));
                    }
                    
                    //Modifica 1 — aggiungere la funzione pura Subito dopo calcola_ValoreProvvigioneVariabile, aggiungi:
                    // 13/05/2026 — AGGIUNTA: funzione pura per PrezzoConLavorazione.
                    // In Excel: PrezzoConLavorazione = CostoLavorazione + Prezzo (Lavorazione + Materiale Euro di riferimento).
                    // Ha il proprio lock: se forzato nel DB, rilevaDivergenze() apre il lucchetto e ricalcolaTutto() non lo sovrascrive.
                    function calcola_PrezzoConLavorazione() {
                        return roundTec(safeField("#CostoLavorazione") + safeField("#Prezzo"));
                    }





                  function calcola_ValoreProvvigioneFissa1() {
                      const qtaOrdine    = ($("#QuantitaOrdine").val() || "").toLowerCase();
                      const prezzoVendita = safeField("#PrezzoVendita");
                      const aliquotaVar  = safeField("#PercentualeProvvigioneVariabile");
                      const prezzo       = safeField("#Prezzo");
                      const materiale    = ($("#IdMateriale option:selected").text() || "").toLowerCase();
                      const prezzoConLav = safeField("#PrezzoConLavorazione");

                      if (qtaOrdine === "si") {
                          return roundTec(prezzoVendita * 0.015);
                      }
                      if (aliquotaVar >= 5 && prezzo !== 0) {
                          if (materiale.includes("rame smaltato")) return roundTec(prezzoVendita * 0.015);
                          if (materiale.includes("rame"))          return roundTec(prezzoConLav * 0.015);
                      }
                      return 0;
                  }

                  function calcola_ValoreProvvigioneFissa2() {
                      const prezzo        = safeField("#Prezzo");
                      const materiale     = ($("#IdMateriale option:selected").text() || "").toLowerCase();
                      const prezzoConLav  = safeField("#PrezzoConLavorazione");
                      const prezzoVendita = safeField("#PrezzoVendita");

                      if (prezzo === 0) return 0;

                      let totale = 0;
                      if (materiale.includes("alluminio"))          totale += prezzoConLav  * 0.03;
                      if (materiale.includes("alluminio smaltato")) totale += prezzoVendita * 0.03;
                      return roundTec(totale);
                  }

                  function calcola_ValoreProvvigioneFissa3() {
                      const materiale   = ($("#IdMateriale option:selected").text() || "").toLowerCase();
                      const aliquotaVar = safeField("#PercentualeProvvigioneVariabile");
                      const costoLav    = safeField("#CostoLavorazione");
                      const isEligibile = (!materiale.includes("alluminio") && aliquotaVar < 5);
                      return roundTec(isEligibile ? costoLav * 0.08 : 0);
                  }

                  // function calcola_Differenza() {
                  //     const vendita   = safeField("#PrezzoVendita");
                  //     const costo      = safeField("#PrezzoConLavorazione");
                  //     const qtaOrdine = safeField("#QuantitaOrdine");
                  //     const flagQ     = ($("#FlagIndicatoreMaggiorazione").val() || "").toLowerCase();

                  //     if (flagQ === "true")                        return 0;
                  //     if (qtaOrdine !== 0 && qtaOrdine < 500)      return 0;
                  //     if (costo > vendita)                         return 0;
                  //     return roundTec(vendita - costo);
                  // }



                    /**
                    * DIFFERENZA (DELTA) - LOG DETTAGLIATO
                    */
                    function calcola_Differenza() {
                        const vendita   = safeField("#PrezzoVendita");
                        const costo      = safeField("#PrezzoConLavorazione");
                        const qtaOrdine = safeField("#QuantitaOrdine");
                        const flagQ     = ($("#FlagIndicatoreMaggiorazione").val() || "").toLowerCase();
                        if (flagQ === "true") {
                        log("LOG PURE - Differenza: BLOCCO [FlagIndicatoreMaggiorazione=true], ritorno 0");
                        return 0;
                        }
                        if (qtaOrdine !== 0 && qtaOrdine < 500) {
                        log("LOG PURE - Differenza: BLOCCO [Quantità " + qtaOrdine + " < 500], ritorno 0");
                        return 0;
                        }
                        if (costo > vendita) {
                        log("LOG PURE - Differenza: BLOCCO [Costo " + costo + " > Vendita " + vendita + "], ritorno 0");
                        return 0;
                        }

                        const ris = roundTec(vendita - costo);
                        log("LOG PURE - Differenza: CALCOLO ESEGUITO (" + vendita + " - " + costo + ") = " + ris);
                        return ris;
                    }



                  function calcola_TotaleFissoProvvigione() {
                      const qta = safeField("#Quantita");
                      const f1  = safeField("#ValoreProvvigioneFissa1");


                      const f2  = safeField("#ValoreProvvigioneFissa2");
                      const f3  = safeField("#ValoreProvvigioneFissa3");
                      return roundTec((f1 + f2 + f3) * qta);
                  }

                  function calcola_TotaleVariabileProvvigione() {
                      const delta = safeField("#Differenza");
                      const kg    = safeField("#Quantita");
                      const perc  = safeField("#Perc_Delta_Provvigione");
                      return roundTec(delta * kg * (perc / 100));
                  }

                  function calcola_TotaleProvvigioneDaFatturare() {
                      return roundTec(
                          safeField("#TotaleFissoProvvigione") +
                          safeField("#TotaleVariabileProvvigione")
                      );
                  }

                  /**
                   * ============================================================
                   * FUNZIONI DI RICALCOLO (con side-effect: scrivono nel DOM)
                   * ============================================================
                   */


                     // 13/05/2026 — AGGIUNTA: ricalcolo PrezzoConLavorazione.2b — funzione ricalcola (subito prima di ricalcolaValoreProvvigioneVariabile):
                    // Scrive nel campo #PrezzoConLavorazione (che è asp-for, non Display/Hidden)
                    // perché in questo modulo il campo è un input diretto nel form,
                    // non una coppia Display/Hidden come gli altri campi calcolati.
                    // La cascata: PrezzoConLavorazione → ValoreProvvigioneVariabile
                    //                                  → ValoreProvvigioneFissa1/2/3
                    //                                  → Differenza → TotaleVariabile → TotaleFattura
                    // viene gestita chiamando ricalcolaTutto() che riesegue tutta la pipeline.
        function ricalcolaPrezzoConLavorazione() {
                              if (!lockPrezzoConLavorazione) return;
                              const tec = calcola_PrezzoConLavorazione();
                              log("Calcolo PrezzoConLavorazione: [CostoLav](" + safeField("#CostoLavorazione") +
                                  ") + [Prezzo](" + safeField("#Prezzo") + ") = " + tec);
                              // 13/05/2026 — scrive sia sul Display (visibile) che sull'Hidden (POST),
                              // identico a tutti gli altri campi calcolati con lucchetto.
                              $("#PrezzoConLavorazioneDisplay").val(tec);
                              $("#PrezzoConLavorazione").val(tec);
                          }


                  function ricalcolaValoreProvvigioneVariabile() {
                      if (!lockValoreProvvigioneVariabile) return;
                      const tec = calcola_ValoreProvvigioneVariabile();
                      log("Calcolo ValoreProvvigioneVariabile: [PrezzoConLavorazione](" + safeField("#PrezzoConLavorazione") + ") * ([PercProvvVar](" + safeField("#PercentualeProvvigioneVariabile") + ") / 100) = " + tec);
                      $("#ValoreProvvigioneVariabileDisplay").val(roundDisplay(tec));
                      $("#ValoreProvvigioneVariabile").val(tec);
                  }

                  function ricalcolaValoreProvvigioneFissa1() {
                      if (!lockValoreProvvigioneFissa1) return;
                      const tec = calcola_ValoreProvvigioneFissa1();
                      log("Calcolo ValoreProvvigioneFissa1: [QtaOrdine](" + ($("#QuantitaOrdine").val() || "") + "), [Materiale](" + ($("#IdMateriale option:selected").text() || "") + ") → Risultato: " + tec);
                      $("#ValoreProvvigioneFissa1Display").val(roundDisplay(tec));
                      $("#ValoreProvvigioneFissa1").val(tec);
                      ricalcolaTotaleFissoProvvigione();
                  }

                  function ricalcolaValoreProvvigioneFissa2() {
                      if (!lockValoreProvvigioneFissa2) return;
                      const tec = calcola_ValoreProvvigioneFissa2();
                      log("Calcolo ValoreProvvigioneFissa2: [Materiale](" + ($("#IdMateriale option:selected").text() || "") + ") → Risultato: " + tec);
                      $("#ValoreProvvigioneFissa2Display").val(roundDisplay(tec));
                      $("#ValoreProvvigioneFissa2").val(tec);
                      ricalcolaTotaleFissoProvvigione();
                  }

                  function ricalcolaValoreProvvigioneFissa3() {
                      if (!lockValoreProvvigioneFissa3) return;
                      const tec = calcola_ValoreProvvigioneFissa3();
                      log("Calcolo ValoreProvvigioneFissa3: [Materiale](" + ($("#IdMateriale option:selected").text() || "") + "), [AliquotaVar](" + safeField("#PercentualeProvvigioneVariabile") + ") → Risultato: " + tec);
                      $("#ValoreProvvigioneFissa3Display").val(roundDisplay(tec));
                      $("#ValoreProvvigioneFissa3").val(tec);
                      ricalcolaTotaleFissoProvvigione();
                  }

                  function ricalcolaDifferenza() {
                      if (!lockDifferenza) return;
