                        <button type="button" id="toggleValoreProvvigioneFissa3" class="btn btn-success">
                            <i class="bi bi-lock-fill"></i>
                        </button>
                    </div>

                    <input type="hidden"
                           id="ValoreProvvigioneFissa3"
