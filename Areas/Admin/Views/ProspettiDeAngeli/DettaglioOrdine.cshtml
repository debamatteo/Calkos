            /**
             * ============================================================
             * ricalcolaTutto — punto di ingresso principale
             * Chiamato da tutti gli event listener sui campi di input.
             *
             * Ordine di esecuzione rispettando le dipendenze:
             *   1. ValoreProvvigioneVariabile  (dipende da PrezzoConLavorazione, PercentualeProvvigioneVariabile)
             *   2. ValoreProvvigioneFissa1/2/3 (dipendono da materiale, prezzi, flag)
             *      └─ TotaleFissoProvvigione   (chiamato in cascata da ciascuna)
             *         └─ TotaleProvvigioneDaFatturare (chiamato in cascata)
             *   3. Differenza                  (dipende da PrezzoVendita, PrezzoConLavorazione, flag, qtaOrdine)
             *      └─ TotaleVariabileProvvigione (chiamato in cascata)
             *         └─ TotaleProvvigioneDaFatturare (chiamato in cascata)
             *   4. TotaleFissoProvvigione esplicito (per aggiornare con Quantita cambiata)
             *   5. TotaleProvvigioneDaFatturare esplicito (foglia finale, sicurezza)
             *
             * NOTA: i campi con lucchetto aperto (lock = false) vengono
             * ignorati automaticamente dalla loro funzione ricalcola*.
             * ============================================================
             */
                function ricalcolaTutto() {//2c — aggiornare ricalcolaTutto
                        log(">>> AVVIO RICALCOLO GLOBALE");
                        log("PrezzoVendita:", safeField("#PrezzoVendita"));
                        log("Prezzo:", safeField("#Prezzo"));
                        log("CostoLavorazione:", safeField("#CostoLavorazione"));
                        log("PrezzoConLavorazione:", safeField("#PrezzoConLavorazione"));
                        log("Quantita:", safeField("#Quantita"));
                        log("QuantitaOrdine:", safeField("#QuantitaOrdine"));
