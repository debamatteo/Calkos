                        </button>
                    </div>
                    <input type="hidden" id="ValoreProvvigioneVariabile" name="ValoreProvvigioneVariabile" value="@FTecnico(Model.ValoreProvvigioneVariabile, 6)" />
                </div>

                <div class="col-md-3">
