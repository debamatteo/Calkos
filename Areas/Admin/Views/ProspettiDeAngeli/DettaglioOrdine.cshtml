                               title="Provvigione Fissa 3%" />
                        <button type="button" id="toggleValoreProvvigioneFissa2" class="btn btn-success">
                            <i class="bi bi-lock-fill"></i>
                        </button>
                    </div>

                    <input type="hidden"
                           id="ValoreProvvigioneFissa2"
                           name="ValoreProvvigioneFissa2"
                           value="@FTecnico(Model.ValoreProvvigioneFissa2, 6)" />
                </div>


                <div class="col-md-3">
