                        </button>
                    </div>
                    <input type="hidden" id="PrezzoConLavorazione" name="PrezzoConLavorazione" value="@FormatDecimal(Model.PrezzoConLavorazione, 6)" />
                </div>

                @* Vendita --PrezzoVendita*@
                <div class="col-md-2">
                    <label class="form-label fw-bold">Vendita</label>
                    @if (isAdmin)
