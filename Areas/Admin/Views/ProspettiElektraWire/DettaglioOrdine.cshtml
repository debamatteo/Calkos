                    <label class="form-label fw-bold required-label">Quantita</label>
                    @if (isAdmin)
                    {
                        <input asp-for="Quantita" id="Quantita" type="number" step="any" class="form-control" value="@FDisplay(Model.Quantita, 3)" />
                    }
                    else
                    {
                        <input asp-for="Quantita" id="Quantita" type="number" step="any" class="form-control input-readonly" readonly="readonly" value="@FDisplay(Model.Quantita, 3)" />
                    }
                    <span asp-validation-for="Quantita" class="text-danger small"></span>
                </div>


                @*  Lavorazione--CostoLavorazione *@
                <div class="col-md-2">
                    <label class="form-label fw-bold">Lavorazione</label>
                    @if (isAdmin)
                    {
                        <input asp-for="CostoLavorazione" id="CostoLavorazione" type="number" step="any" class="form-control" value="@FDisplay(Model.CostoLavorazione, 3)" />
                    }
                    else
                    {
                        <input asp-for="CostoLavorazione" id="CostoLavorazione" type="number" step="any" class="form-control input-readonly" readonly="readonly" value="@FDisplay(Model.CostoLavorazione, 3)" />
                    }
                    <span asp-validation-for="CostoLavorazione" class="text-danger small"></span>
                </div>

                @* Base --PrezzoBase*@
                <div class="col-md-2">
                    <label class="form-label fw-bold">Base</label>
                    @if (isAdmin)
                    {
                        <input asp-for="PrezzoBase" id="PrezzoBase" type="number" step="any" class="form-control" value="@FDisplay(Model.PrezzoBase, 3)" />
                    }
                    else
                    {
                        <input asp-for="PrezzoBase" id="PrezzoBase" type="number" step="any" class="form-control input-readonly" readonly="readonly" value="@FDisplay(Model.PrezzoBase, 3)" />
                    }
                    <span asp-validation-for="PrezzoBase" class="text-danger small"></span>
                </div>

                @* Colonna H	Totale Mat+Lav	[Campo DB PrezzoConLavorazione]
                Formula	E13+G13
                Formula	PrezzoConLavorazione	=CostoLavorazione+Prezzo
                E		Lav	—	Campo DB	CostoLavorazione
                G		Base	—	Campo DB	Prezzo *@

                <div class="col-md-2">
                    <label class="form-label fw-bold">Totale Mat+Lav</label>
                    <div class="input-group">
                        <input type="number"
                               step="any"
                               id="PrezzoConLavorazioneDisplay"
                               class="form-control input-readonly"
