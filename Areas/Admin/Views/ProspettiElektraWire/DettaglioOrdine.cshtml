                <div class="row g-3">


                    @* --------------------------------------------------------------------------------

                    O	Commisioni fisse 	[3%]	
                    Campo DB	ValUnitProvvigioneFissa_03	
                    FORMULA=SE(F6="rame";0;I6*3%);FORMULA=SE(Materiale=[rame];0;Vendita*3%)
