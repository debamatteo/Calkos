                    </div>

                    @* --------------------------------------------------------------------------------
                    P	Commisioni fisse 	[3% < Delta]
                    Campo DB	Delta1ProvvigioneFissa_03	
                    FORMULA =SE(O6<J6;O6;0)
                    FORMULA =SE([3%]<Delta;[3%];0)
                    FORMULA DB =SE(ValUnitProvvigioneFissa_03<Delta;ValUnitProvvigioneFissa_03;0)

                    O	Commisioni fisse 	[3%]	Campo DB	ValUnitProvvigioneFissa_03
                    J		Delta	—	Campo DB	DeltaMargine	
                     [3% Min Delta]<
                    -------------------------------------------------------------------------------- *@

                    <div class="col-md-2">
                        <label class="form-label fw-bold">[3% &lt Delta]</label>
                        <div class="input-group">
                            <input type="number"
                                   step="any"
                                   id="Delta1ProvvigioneFissa_03Display"
                                   class="form-control input-readonly"
                                   readonly
                                   value="@FDisplay(Model.Delta1ProvvigioneFissa_03, 3)"
                                   title="Delta1ProvvigioneFissa_03 = SE(Materiale = [rame];Valore 0; Altrimenti Vendita * 3%)" />
                            <button type="button" id="toggleDelta1ProvvigioneFissa_03" class="btn btn-success">
                                <i class="bi bi-lock-fill"></i>
                            </button>
                        </div>
                        <input type="hidden" id="Delta1ProvvigioneFissa_03" name="Delta1ProvvigioneFissa_03" value="@FormatDecimal(Model.Delta1ProvvigioneFissa_03, 6)" />
                    </div>

                    @* --------------------------------------------------------------------------------
                    Q	Commisioni fisse 	[3% > Delta]
                    Campo DB	Delta2ProvvigioneFissa_03
                    FORMULA	=SE(J6>O6;0;J6);FORMULA	=SE(Delta>[3%];0;Delta)
                    FORMULA	=SE(DeltaMargine>ValUnitProvvigioneFissa_03;0;DeltaMargine)

                    O	Commisioni fisse 	[3%]		Campo DB	ValUnitProvvigioneFissa_03
                    J		Delta	—	Campo DB	DeltaMargine	
                    -------------------------------------------------------------------------------- *@

                    <div class="col-md-2">
                        <label class="form-label fw-bold">[3% Mag Delta]</label>
                        <div class="input-group">
                            <input type="number"
                                   step="any"
                                   id="Delta2ProvvigioneFissa_03Display"
                                   class="form-control input-readonly"
                                   readonly
                                   value="@FDisplay(Model.Delta2ProvvigioneFissa_03, 3)"
                                   title="Delta2ProvvigioneFissa_03 = SE(Delta(Margine) >[3%];Valore=0 altrimenti Delta)" />
                            <button type="button" id="toggleDelta2ProvvigioneFissa_03" class="btn btn-success">
                                <i class="bi bi-lock-fill"></i>
                            </button>
                        </div>
                        <input type="hidden" id="Delta2ProvvigioneFissa_03" name="Delta2ProvvigioneFissa_03" value="@FormatDecimal(Model.Delta2ProvvigioneFissa_03, 6)" />
                    </div>


                    @* --------------------------------------------------------------------------------
                    R	Commisioni fisse 	[3% fissa]
                    Campo DB	TotProvvigioneFissa_03
                    FORMULA=P6*D6 ; FORMULA=[3% < Delta	]*KG
                    FORMULA DB =TotProvvigioneFissa_03*Quantita

                    P	Commisioni fisse 	[3% < Delta	]Campo DB	Delta1ProvvigioneFissa_03
                    D		KG	—	Campo DB	Quantita	—
                    -------------------------------------------------------------------------------- *@

                    <div class="col-md-2">
                        <label class="form-label fw-bold">[3% fissa]</label>
                        <div class="input-group">
                            <input type="number"
                                   step="any"
                                   id="TotProvvigioneFissa_03Display"
                                   class="form-control input-readonly"
                                   readonly
                                   value="@FDisplay(Model.TotProvvigioneFissa_03, 3)"
                                   title="[3% < Delta] * KG" />
                            <button type="button" id="toggleTotProvvigioneFissa_03" class="btn btn-success">
                                <i class="bi bi-lock-fill"></i>
                            </button>
                        </div>
                        <input type="hidden" id="TotProvvigioneFissa_03" name="TotProvvigioneFissa_03" value="@FormatDecimal(Model.TotProvvigioneFissa_03, 6)" />
                    </div>


                    @*                      --------------------------------------------------------------------------------
                    S		[Quota fissa 1,5%]	—
                    Campo DB	ValQuotaFissa_1_5
