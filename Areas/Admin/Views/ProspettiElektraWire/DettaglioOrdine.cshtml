                        <input asp-for="PrezzoVendita" id="PrezzoVendita" type="number" step="any" class="form-control" value="@FDisplay(Model.PrezzoVendita, 3)" />
                    }
                    else
                    {
                        <input asp-for="PrezzoVendita" id="PrezzoVendita" type="number" step="any" class="form-control input-readonly" readonly="readonly" value="@FDisplay(Model.PrezzoVendita, 3)" />
                    }
                    <span asp-validation-for="PrezzoVendita" class="text-danger small"></span>
                </div>


            </div>



            @* ============================================================
               SEZIONE: PREZZI VENDITA
               ============================================================ *@
            <h5 class="fw-bold mt-4">Calcoli Provvigione </h5>
            <div class="row g-3">

                @*  Delta	/	DeltaMargine *@
                <!--
                FORMULA = I-H (Vendita- "Totale Mat+Lav")
                PrezzoVendita-PrezzoConLavorazione
                I		Vendita	—	Campo DB	PrezzoVendita
                H		"Totale Mat+Lav""	—	Campo DB	PrezzoConLavorazione
                -->

                <div class="col-md-2">
                    <label class="form-label fw-bold">Delta (Margine)</label>
                    <div class="input-group">
                        <input type="number"
                               step="any"
                               id="DeltaMargineDisplay" @* <-- Cambiato da DeltaDisplay *@
                               class="form-control input-readonly"
                               readonly
                               value="@FDisplay(Model.DeltaMargine ?? 0, 3)"
                               title="Delta(Margine) =(Vendita- [Totale Mat+Lav])" />
                        <button type="button" id="toggleDelta" class="btn btn-success">
                            <i class="bi bi-lock-fill"></i>
                        </button>
                    </div>
                    @* Cambia l'id da "Delta" a "DeltaMargine" *@
                    <input type="hidden" id="DeltaMargine" name="DeltaMargine" value="@FormatDecimal(Model.DeltaMargine, 6)" />
                </div>


                @* Colonna K	Commisioni fisse 	1,50%	0,015 (soglia)
            Campo DB	ValUnitProvvigioneFissa1_5
            FORMULA =SE(F6="alluminio";0;I6*1,5%)
            SE(Materiale="alluminio";0;Vendita*1,5%)
            F		Materiale	—	Campo DB	Materiale	—
            I		Vendita	—	Campo DB	PrezzoVendita	— *@

                <div class="col-md-2">
                    <label class="form-label fw-bold">[1,50%]</label>
                    <div class="input-group">
                        <input type="number"
                               step="any"
                               id="ValUnitProvvigioneFissa1_5Display"
                               class="form-control input-readonly"
                               readonly
                               value="@FDisplay(Model.ValUnitProvvigioneFissa1_5, 3)"
                               title="ValUnitProvvigioneFissa1_5 = SE(Materiale='alluminio';Valore 0;altrimenti Vendita*1,5%)" />
                        <button type="button" id="toggleValUnitProvvigioneFissa1_5" class="btn btn-success">
                            <i class="bi bi-lock-fill"></i>
                        </button>
                    </div>
                    <input type="hidden" id="ValUnitProvvigioneFissa1_5" name="ValUnitProvvigioneFissa1_5" value="@FormatDecimal(Model.ValUnitProvvigioneFissa1_5, 6)" />
                </div>

                @* --------------------------------------------------------------------------------                    
                    L	Commisioni fisse [1,50%] 
                    Campo DB Delta1ProvvigioneFissa1_5
                    FORMULA=SE(K6<J6;K6;0) ; SE([1,50%]<Delta;[1,50%];0)
                    FORMULA DB =SE(ValUnitProvvigioneFissa1_5<DeltaMargine;ValUnitProvvigioneFissa1_5;0)
                    K	Commisioni fisse 	1,50%	Campo DB	ValUnitProvvigioneFissa1_5
                    J   Delta	—	Campo DB	DeltaMargine
                    -----------------------------------------------------------------------------------
                    *@

                <div class="col-md-2">
                    <label class="form-label fw-bold">[1,5% &lt Delta]</label>
                    <div class="input-group">
                        <input type="number"
                               step="any"
                               id="Delta1ProvvigioneFissa1_5Display"
                               class="form-control input-readonly"
                               readonly
                               value="@FDisplay(Model.Delta1ProvvigioneFissa1_5, 3)"
                               title="Delta1ProvvigioneFissa1_5= SE([1,50%]< Delta(Margine);Valore [1,50%] altrimenti 0)" />
                        <button type="button" id="toggleDelta1ProvvigioneFissa1_5" class="btn btn-success">
                            <i class="bi bi-lock-fill"></i>
                        </button>
                    </div>
                    <input type="hidden" id="Delta1ProvvigioneFissa1_5" name="Delta1ProvvigioneFissa1_5" value="@FormatDecimal(Model.Delta1ProvvigioneFissa1_5, 6)" />
                </div>


                @* --------------------------------------------------------------------------------
                    M	Commisioni fisse 	[1,5%>Delta]
                    Campo DB Delta2ProvvigioneFissa1_5
                    FORMULA =SE(J6>K6;0;J6) ; FORMULA =SE(Delta>[1,50%];0;Delta)
                    FORMULA DB =SE(DeltaMargine>ValUnitProvvigioneFissa1_5;0;DeltaMargine)

                    K	Commisioni fisse 	[1,50%]	Campo DB	ValUnitProvvigioneFissa1_5
                    J		Delta	—	Campo DB	DeltaMargine
                    ----------------------------------------------------------------------------------
                     *@

                <div class="col-md-2">
                    <label class="form-label fw-bold">[1,5% > Delta]</label>
                    <div class="input-group">
                        <input type="number"
                               step="any"
                               id="Delta2ProvvigioneFissa1_5Display"
                               class="form-control input-readonly"
                               readonly
                               value="@FDisplay(Model.Delta2ProvvigioneFissa1_5, 3)"
                               title="Delta2ProvvigioneFissa1_5 = SE(Delta(Margine) > [1,50%]; Valore=0 ;Altrimenti Delta)" />
                        <button type="button" id="toggleDelta2ProvvigioneFissa1_5" class="btn btn-success">
                            <i class="bi bi-lock-fill"></i>
                        </button>
                    </div>
                    <input type="hidden" id="Delta2ProvvigioneFissa1_5" name="Delta2ProvvigioneFissa1_5" value="@FormatDecimal(Model.Delta2ProvvigioneFissa1_5, 6)" />
                </div>


                @* --------------------------------------------------------------------------------

                    N	Commisioni fisse 	[1,5% fissa]
                    Campo DB	TotProvvigioneFissa1_5
                    FORMULA=L6*D6; FORMULA=[1,50%<Delta]*KG 
                    FORMULA DB = Delta1ProvvigioneFissa1_5 * Quantita

                    L	Commisioni fisse 	[1,50%<Delta]	Campo DB	Delta1ProvvigioneFissa1_5
                    D	KG	—	Campo DB	Quantita
                    -------------------------------------------------------------------------------- *@


                <div class="col-md-2">
                    <label class="form-label fw-bold">[1,5% fissa]</label>
                    <div class="input-group">
                        <input type="number"
                               step="any"
                               id="TotProvvigioneFissa1_5Display"
                               class="form-control input-readonly"
                               readonly
