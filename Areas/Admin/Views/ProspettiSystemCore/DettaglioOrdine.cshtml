                </div>


                @*FORMULA =SE(H5=0;+D5*0,05;G5*H5)
                Questa formula decide come calcolare la  provvigione base (fissa):
                se non c'è una percentuale concordata "% Quota fissa"(Colonna H=0),
                prendo 5 centesimi per ogni chilo (Colonna D =KG) venduto.
                Se invece la percentuale c'è, prendo quella calcolata sul prezzo di vendita (Colonna "G" Vendita).
                H=% Quota fissa
                D =KG
                G = Prezzo Vendita *@

                @* ValoreQuotaFissa (Quota fissa € 0,10) *@
                <div class="col-md-2">
                    <label class="form-label fw-bold">Quota fissa € </label>
                    <div class="input-group">
                        <input type="number"
                               step="any"
                               id="ValoreQuotaFissaDisplay"
                               class="form-control input-readonly"
                               readonly
                               value="@FDisplay(Model.ValoreQuotaFissa, 3)"
                               title="Quota fissa: SE(% Quota fissa = 0) ALLORA ([Quota Euro KG] * KG) ALTRIMENTI (% Quota fissa * Prezzo Vendita)" />
                        <button type="button" id="toggleValoreQuotaFissa" class="btn btn-success">
                            <i class="bi bi-lock-fill"></i>
                        </button>
                    </div>
                    <input type="hidden" id="ValoreQuotaFissa" name="ValoreQuotaFissa" value="@FTecnico(Model.ValoreQuotaFissa, 6)" />
                </div>


                <!--
                FORMULA =SE(H5=0;G5-E5;0)
                Se % quota fissa = 0 → differenza (Vendita - Lav) , altrimenti 0
                H=% Quota fissa
                E= Costo Lavorazione (Lav)
                G = Prezzo Vendita (Vendita)
                -->
                <div class="col-md-2">
                    <label class="form-label fw-bold">Delta</label>
                    <div class="input-group">
                        <input type="number"
                               step="any"
                               id="DeltaDisplay"
