                        <button type="button" id="togglePerc_Delta_Provvigione" class="btn btn-success">
                            <i class="bi bi-lock-fill"></i>
                        </button>
                    </div>

                    <!-- VALORE TECNICO A 6 DECIMALI -->
                    @* CONVENZIONE: Perc_Delta_Provvigione è sempre salvata in percentuale intera
           Es: 50 = 50%  →  nel calcolo si divide sempre per 100
           Questa convenzione vale per DB, hidden, display e controller. *@
                    <input type="hidden"
                           id="Perc_Delta_Provvigione"
                           name="Perc_Delta_Provvigione"
                           value="@FTecnico(Model.Perc_Delta_Provvigione)" />
                </div>

                @* Totale provv variabile = TotaleProvvigioneVariabile *@
                @* CALCOLO  "Totale provv variabile"
       Campo DB= TotaleProvvigioneVariabile
       (J5*0,5)*D5  50% del delta moltiplicato per i Kg
       J=Delta
       D =KG
       Il valore 50% è salvato nel database nel campo Perc_Delta_Provvigione *@

                <div class="col-md-3">
                    <label class="form-label fw-bold">Totale Provv Variabile</label>
                    <div class="input-group">
                        <input type="number"
                               step="any"
                               id="TotaleProvvigioneVariabileDisplay"
                               class="form-control input-readonly"
                               readonly
                               value="@FDisplay(Model.TotaleProvvigioneVariabile, 3)"
                               title="Totale provv variabile = (Delta * [Perc. Delta Provv.]) * KG" />
                        <button type="button" id="toggleTotaleProvvigioneVariabile" class="btn btn-success">
                            <i class="bi bi-lock-fill"></i>
                        </button>
                    </div>
                    <input type="hidden"
                           id="TotaleProvvigioneVariabile"
                           name="TotaleProvvigioneVariabile"
                           value="@FTecnico(Model.TotaleProvvigioneVariabile, 6)" />
                </div>

                @* Totalone= TotaleProvvigione *@
                @* CALCOLO  "Totalone"
       Campo DB= TotaleProvvigione
       I5+K5    Somma quota fissa + provvigione variabile
       I=Quota fissa € 0,10
       K=Totale provv variabile *@

                <div class="col-md-3">
                    <label class="form-label fw-bold">Totalone</label>
                    <div class="input-group">
                        <input type="number"
                               step="any"
                               id="TotaleProvvigioneDisplay"
                               class="form-control input-readonly"
                               readonly
                               value="@FDisplay(Model.TotaleProvvigione, 3)"
                               title="Totalone = Quota fissa € + Totale provv variabile" />
                        <button type="button" id="toggleTotaleProvvigione" class="btn btn-success">
                            <i class="bi bi-lock-fill"></i>
                        </button>
                    </div>
                    <input type="hidden"
                           id="TotaleProvvigione"
                           name="TotaleProvvigione"
                           value="@FTecnico(Model.TotaleProvvigione, 6)" />
                </div>

                @* Totale Provvigioni= TotaleProvvigioneDaFatturare *@
                @* CALCOLO  "Totale Provvigioni"
                   Campo DB= TotaleProvvigioneDaFatturare
                   SE(H5=0;SE(L5>G5;L5;G5);L5)
                   Se H% = 0 → prende il maggiore tra Totalone e Vendita, altrimenti Totalone
                   H= % Quota fissa
                   L= Totale
                   G = Prezzo Vendita (Vendita) *@

                <div class="col-md-3">
                    <label class="form-label fw-bold">Totale Provvigioni</label>
                    <div class="input-group">
                        <input type="number"
                               step="any"
                               id="TotaleProvvigioneDaFatturareDisplay"
                               class="form-control input-readonly"
                               readonly
                               value="@FDisplay(Model.TotaleProvvigioneDaFatturare, 3)"
                               title="Se [% Quota fissa] è zero, calcola il maggiore tra Totalone e Prezzo Vendita; altrimenti usa il Totale" />
                        <button type="button" id="toggleTotaleProvvigioneDaFatturare" class="btn btn-success">
                            <i class="bi bi-lock-fill"></i>
                        </button>
                    </div>
                    <input type="hidden"
                           id="TotaleProvvigioneDaFatturare"
                           name="TotaleProvvigioneDaFatturare"
                           value="@FTecnico(Model.TotaleProvvigioneDaFatturare, 6)" />
                </div>

            </div>



            @* 
            ============================================================
            SEZIONE: DATE
            ============================================================ *@

            <h5 class="fw-bold mt-4">Date</h5>

            <div class="row g-3">
                @* Data Consegna Ipotetica *@
                <div class="col-md-4">
                    <label class="form-label fw-bold">Data Consegna</label>
                    <input asp-for="DataConsegna" type="date" class="form-control" />
                </div>
                @* Data Scadenza  *@
                <div class="col-md-4">
                    <label class="form-label fw-bold">Scadenza</label>
                    <input asp-for="Scadenza" type="date" class="form-control" />
                </div>

            </div>

            @* ============================================================
               SEZIONE: AGENTE E PAGAMENTO
               ============================================================ *@
            <h5 class="fw-bold mt-4">Agente e Pagamento</h5>
            <div class="row g-3">

                <div class="col-md-4">
                    @* Agente: select costruita manualmente (non con asp-items) per poter
                       aggiungere l'attributo data-percentuale su ogni option,
                       necessario per il calcolo client-side della provvigione.

                       FIX: ViewBag.Agenti castato a IEnumerable<AgenteSelectItem> in cima alla view.
                       Il controller popola ViewBag.Agenti con List<AgenteSelectItem>, tipo custom
                       che espone Id, Nome e PercentualeDefault.
                       Le proprietà usate nel foreach sono quindi:
                         a.Id               → value dell'option
                         a.Nome             → testo visibile dell'option
                         a.PercentualeDefault → attributo data-percentuale per il calcolo JS
                    *@
                    <label class="form-label fw-bold">Agente</label>
                    <select id="IdAgente" name="IdAgente" class="form-select">
                        @foreach (var a in agenti)
                        {
                            bool isSelected = (Model?.IdAgente.ToString() == a.Id.ToString());
                            <option value="@a.Id"
                                    data-percentuale="@a.PercentualeDefault"
                                    selected="@(isSelected ? "selected" : null)">
                                @a.Nome
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-4">
                    @* 28/04/2026 *@
                    @* ProvvigioneAgente: recuperata via AJAX dal controller al cambio di Agente o Cliente.
                    Campo readonly di default, sbloccabile da Admin tramite il lucchetto.
                    Formattiamo con F3 + InvariantCulture per type="number". *@
                    <label class="form-label fw-bold">Provvigione Agente (%)</label>
                    <i class="bi bi-info-circle-fill text-danger ms-2" style="font-size: 1.2rem;" title="Inserire la percentuale in formato umano: 5 significa 5%, NON 0,05"></i>
                    <div class="input-group">
                        @{
                            
                            string provValue = FTecnico(Model.ProvvigioneAgente);
                        }
                        @* Campo visibile: solo id (niente name) per evitare doppio invio nel POST.
                        Il name="ProvvigioneAgente" è sull'hidden qui sotto, che è l'unico
                        che partecipa al binding del controller. *@
                        <input id="ProvvigioneAgenteDisplay"
                               type="number"
                               step="any"
                               class="form-control input-readonly"
                               readonly="readonly"
                               value="@provValue" />
                        @if (isAdmin)
                        {
                            <button type="button" id="toggleProvAgente" class="btn btn-success">
                                <i class="bi bi-lock-fill"></i>
                            </button>
                        }
                    </div>
                    @* Hidden: porta il valore al POST esattamente come tutti gli altri campi calcolati
                        (es. TotaleFissoProvvigione, Differenza, ecc.).
                        Il JS lo aggiorna in sincronia con il Display. *@
                    <input type="hidden"
                           id="ProvvigioneAgente"
                           name="ProvvigioneAgente"
                           value="@provValue" />
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold">Tipo Pagamento</label>
                    <select asp-for="IdTipoPagamento" class="form-select"
                            asp-items="@(ViewBag.TipiPagamento as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)">
                    </select>
                </div>

            </div>




            @* ============================================================
               SEZIONE: ALTRI CAMPI (collapsible)
               Generata via Reflection su tutte le proprietà del modello
               non già presenti nelle sezioni precedenti.
               Usa FormatDecimal per i campi decimal (3 decimali = precisione tecnica Cobral).
               ============================================================ *@
            <h5 class="fw-bold mt-4">Altri Campi</h5>
            <button class="btn btn-outline-primary mb-3" type="button"
                    data-bs-toggle="collapse" data-bs-target="#tecnici">
                Mostra / Nascondi Altri Campi
            </button>

            <div class="collapse" id="tecnici">
                <div class="row g-3">
                    @foreach (var prop in typeof(CalkosManager.Domain.Entities.ProspettoSystemCore).GetProperties())
                    {
                        @* Lista completa dei campi da escludere dalla sezione "Altri Campi"
                           perché già gestiti nelle sezioni precedenti o non rilevanti per l'utente
                           SE un campo è presente nell Array SKIP NON verrà visualizzato nella sezione Altri Campi
                           
                           *@                     
                           
                           
                                       var skip = new[] {
                                        "IdCliente", "IdMateriale", "IdUnitaMisura", "NumeroOrdine", "NumeroDDT", "NumeroFattura", "Misure", "Quantita", "Kg", "PrezzoVendita", "CostoLavorazione", "PercentualeQuotaFissa", "ValoreQuotaFissa",
                                        "TotaleProvvigioneVariabile", "TotaleProvvigione", "TotaleProvvigioneDaFatturare",
                                        "Delta", "Perc_Delta_Provvigione", "QuotaCentesimiPerKg", "IdAgente", "IdTipoPagamento", "ProvvigioneAgente", "DataConsegna", "Scadenza", "Fatturare", "IsProcessed", "UniqueKey",

                                        "IdProspettoSystemCore", "IdMandatario", "IdFileImportato", "IdImportSystemCore", "DataInserimento", "DataModifica", "Utente", "Anno", "Mese",
                                        "Fatturata", "DataFatturazione",
                                        "IsDeleted", "RagioneSociale", "DescrizioneMateriale", "UnitaMisura", "AgenteDescrizione", "PercentualeDefaultAgente", "TipoPagamento"
                                        };

                        if (skip.Contains(prop.Name)) continue;

                        bool isDecimal = prop.PropertyType == typeof(decimal) || prop.PropertyType == typeof(decimal?);
                        string inputType = isDecimal ? "number" :
                        (prop.PropertyType == typeof(int?) || prop.PropertyType == typeof(int)) ? "number" :
                        (prop.PropertyType == typeof(DateTime?) || prop.PropertyType == typeof(DateTime)) ? "date" : "text";

                        @* step="any" per tutti i decimal tecnici Cobral (massima precisione) *@
                        string stepAttr = isDecimal ? "step=any" : "";

                        var rawValue = prop.GetValue(Model);
                        string formattedValue;

                        if (isDecimal)
                        {
                            formattedValue = FDisplay(rawValue); //formattedValue = FormatDecimal(rawValue, 3);
                        }
                        else if (inputType == "date" && rawValue is DateTime dt)
                        {
                            formattedValue = dt.ToString("yyyy-MM-dd");
                        }
                        else
                        {
                            formattedValue = rawValue?.ToString() ?? "";
                        }

                        <div class="col-md-4">
                            <label class="form-label fw-bold">@prop.Name</label>
                            <input class="form-control"
                                   name="@prop.Name"
                                   id="@prop.Name"
                                   type="@inputType"
                                   @stepAttr
                                   value="@formattedValue" />
                        </div>
                    }
                </div>
            </div>




            <hr />

            <div class="d-flex justify-content-between mt-3">
                <a href="/Admin/ProspettiSystemCore/ListaOrdini" class="btn btn-secondary">Torna alla lista</a>
                <button type="submit" class="btn btn-primary">Salva modifiche</button>
            </div>

        </form>

    </div>
</div>

@*LOGICA DI COBRAL 09/05/2026*@

@section Scripts {
    <script>
        $(document).ready(function () {

            /**
             * ============================================================
             * CENTRALIZZAZIONE ANTIFORGERY
             * Aggiunge automaticamente il token CSRF a tutte le chiamate
             * AJAX jQuery, evitando di doverlo passare manualmente ogni volta.
             * ============================================================
             */
            $.ajaxSetup({
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                }
            });

            /**
             * ============================================================
             * CONFIGURAZIONE DECIMALI CENTRALIZZATA
             * Deve essere allineata con le costanti C# in cima alla view:
             *   DECIMALI_TECNICI  → usati nei campi hidden (inviati al server)
             *   DECIMALI_DISPLAY  → usati nei campi visibili all'utente
             * ============================================================
             */
                    const DECIMALI_TECNICI = 4;
                    const DECIMALI_DISPLAY = 4;

                    // 13/05/2026 — MODIFICA: aggiunto Number.EPSILON prima di toFixed. Stessa modifica applicata su ElektraWire, Cobral e DeAngeli.
                    function roundTec(v) {
                        return Number((toNum(v) + Number.EPSILON).toFixed(DECIMALI_TECNICI));
                    }

                    function roundDisplay(v) {
                        return Number((toNum(v) + Number.EPSILON).toFixed(DECIMALI_DISPLAY));
                    }
            /**
             * ============================================================
             * HELPER NUMERICI
             * ============================================================
             */

            /**
             * toNum — conversione grezza stringa → numero.
             * Gestisce: null, undefined, stringa vuota, virgola decimale.
             * Restituisce sempre 0 in caso di fallimento (mai NaN).
             */
            function toNum(v) {
                if (v === null || v === undefined) return 0;
                if (typeof v === "string") {
                    v = v.replace(',', '.').trim();
                    if (v === "") return 0;
                }
                const n = parseFloat(v);
                return isNaN(n) ? 0 : n;
            }

            /**
             * safeNum — bonifica un valore già letto (variabile JS o $(this).val()).
             * Uso: safeNum($(this).val())  oppure  safeNum(miaVariabile)
             * Accetta un fallback opzionale (default: 0).
             */
            function safeNum(v, fallback) {
                if (fallback === undefined) fallback = 0;
                if (v === null || v === undefined) return fallback;
                if (typeof v === "string") {
                    v = v.replace(',', '.').trim();
                    if (v === "") return fallback;
                }
                const n = parseFloat(v);
                if (isNaN(n) || !isFinite(n)) return fallback;
                return n;
            }

            /**
             * safeField — legge un campo jQuery dal DOM e lo bonifica.
             * Uso: safeField("#MioCampo")  invece di  toNum($("#MioCampo").val())
             * Emette un warning in console se il selettore non trova nulla.
             */
            function safeField(selector, fallback) {
                if (fallback === undefined) fallback = 0;
                const el = $(selector);
                if (el.length === 0) {
                    console.warn("safeField: campo non trovato →", selector);
                    return fallback;
                }
                return safeNum(el.val(), fallback);
            }

            /**
             * ============================================================
             * REGOLA DI SCELTA TRA safeNum e safeField
             * ============================================================
             *
             *  safeField("#MioCampo")       → quando leggi direttamente dal DOM
             *  safeNum($(this).val())       → quando hai già il valore in una variabile
             *  safeNum(miaVariabile)        → stessa cosa
             *
             *  Mnemonica: vedi il cancelletto "#"? → safeField.
             *             Hai già il valore? → safeNum.
             */

            /**
             * ============================================================
             * VARIABILI DI STATO LUCCHETTI
             * true  = calcolo automatico attivo (lucchetto chiuso, verde)
             * false = valore forzato manualmente (lucchetto aperto, rosso)
             *
             * Tutti partono true e vengono corretti da rilevaDivergenze()
             * prima del primo ricalcolaTutto().
             * ============================================================
             */
            let lockQuotaCentesimiPerKg          = true;
            let lockValoreQuotaFissa             = true;
            let lockDelta                        = true;
            let lockPerc_Delta_Provvigione       = true;
            let lockTotaleProvvigioneVariabile   = true;
            let lockTotaleProvvigione            = true;
            let lockTotaleProvvigioneDaFatturare = true;
            let lockProvAgente                   = true;

            /**
             * ============================================================
             * FUNZIONI DI CALCOLO PURE (senza side-effect)
             * Queste funzioni SOLO calcolano e restituiscono il valore.
             * Non scrivono nulla nel DOM. Servono a due scopi:
             *   1. Essere chiamate da rilevaDivergenze() al caricamento
             *      per capire se un campo è stato forzato nel DB.
             *   2. Essere richiamate dalle funzioni "ricalcola*" che
             *      invece scrivono nel DOM.
             *
             * CONVENZIONI PERCENTUALI SystemCore:
             *   PercentualeQuotaFissa  → formato intero (es. 5 = 5%)  → dividi per 100 nel calcolo
             *   Perc_Delta_Provvigione → formato intero (es. 50 = 50%) → dividi per 100 nel calcolo
             * ============================================================
             */

            // QuotaCentesimiPerKg non ha una formula, è un dato base.
            // Non serve una funzione pura per lui.

            /**
             * ValoreQuotaFissa:
             *   SE(% Quota fissa = 0) → QuotaEuroKg * Kg
             *   ALTRIMENTI            → PrezzoVendita * (% / 100)
             */
            function calcola_ValoreQuotaFissa() {
                const perc        = safeField("#PercentualeQuotaFissa");
                const kg          = safeField("#Quantita");
                const quotaEuroKg = safeField("#QuotaCentesimiPerKg");
                const vendita     = safeField("#Prezzo");

                return roundTec(
                    perc === 0
                        ? kg * quotaEuroKg
                        : vendita * (perc / 100)
                );
            }

            /**
             * Delta:
             *   SE(% Quota fissa = 0) → PrezzoVendita - CostoLavorazione
             *   ALTRIMENTI            → 0
             */
            function calcola_Delta() {
                const perc    = safeField("#PercentualeQuotaFissa");
                const vendita = safeField("#Prezzo");
                const lav     = safeField("#CostoLavorazione");

                return roundTec(perc === 0 ? vendita - lav : 0);
            }

            /**
             * TotaleProvvigioneVariabile:
             *   (Delta * Perc_Delta_Provvigione / 100) * Kg
             *
             * ATTENZIONE: Perc_Delta_Provvigione è in formato intero (50 = 50%),
             * quindi si divide per 100. Non modificare questa divisione.
             */
            function calcola_TotaleProvvigioneVariabile() {
                const delta    = safeField("#Delta");
                const percDelta = safeField("#Perc_Delta_Provvigione");
                const kg       = safeField("#Quantita");

                return roundTec(delta * (percDelta / 100) * kg);
            }

            /**
             * TotaleProvvigione (Totalone):
             *   ValoreQuotaFissa + TotaleProvvigioneVariabile
             */
            function calcola_TotaleProvvigione() {
                return roundTec(
                    safeField("#ValoreQuotaFissa") +
                    safeField("#TotaleProvvigioneVariabile")
                );
            }

            /**
             * TotaleProvvigioneDaFatturare:
             *   SE(% Quota fissa = 0) → MAX(Totalone, PrezzoVendita)
             *   ALTRIMENTI            → Totalone
             */
            function calcola_TotaleProvvigioneDaFatturare() {
                const perc    = safeField("#PercentualeQuotaFissa");
                const tot     = safeField("#TotaleProvvigione");
                const vendita = safeField("#Prezzo");

                return roundTec(
                    perc === 0
                        ? (tot > vendita ? tot : vendita)
                        : tot
                );
            }

            /**
             * ============================================================
             * FUNZIONI DI RICALCOLO (con side-effect: scrivono nel DOM)
             * Ogni funzione:
             *   1. Controlla se il lucchetto è chiuso (lock = true).
             *      Se aperto, non fa nulla (il valore è stato forzato).
             *   2. Usa la corrispondente funzione pura per calcolare.
             *   3. Aggiorna Display (visibile) e Hidden (inviato al server).
             * ============================================================
             */

            function ricalcolaValoreQuotaFissa() {
                if (!lockValoreQuotaFissa) return;
                const tec = calcola_ValoreQuotaFissa();
                const vis = roundDisplay(tec);
                log("Calcolo ValoreQuotaFissa: perc=" + safeField("#PercentualeQuotaFissa") +
                    " kg=" + safeField("#Quantita") + " quotaKg=" + safeField("#QuotaCentesimiPerKg") +
                    " vendita=" + safeField("#Prezzo") + " → " + tec);
                $("#ValoreQuotaFissaDisplay").val(vis);
                $("#ValoreQuotaFissa").val(tec);
            }

            function ricalcolaDelta() {
                if (!lockDelta) return;
                const tec = calcola_Delta();
                const vis = roundDisplay(tec);
                log("Calcolo Delta: perc=" + safeField("#PercentualeQuotaFissa") +
                    " vendita=" + safeField("#Prezzo") + " lav=" + safeField("#CostoLavorazione") +
                    " → " + tec);
                $("#DeltaDisplay").val(vis);
                $("#Delta").val(tec);
                // Delta è input di TotaleProvvigioneVariabile → propaga
                ricalcolaTotaleProvvigioneVariabile();
            }

            function ricalcolaTotaleProvvigioneVariabile() {
                if (!lockTotaleProvvigioneVariabile) return;
                const tec = calcola_TotaleProvvigioneVariabile();
                const vis = roundDisplay(tec);
                log("Calcolo TotProvVariabile: delta=" + safeField("#Delta") +
                    " percDelta=" + safeField("#Perc_Delta_Provvigione") +
                    " kg=" + safeField("#Quantita") + " → " + tec);
                $("#TotaleProvvigioneVariabileDisplay").val(vis);
                $("#TotaleProvvigioneVariabile").val(tec);
                // TotaleProvvigioneVariabile è input di TotaleProvvigione → propaga
                ricalcolaTotaleProvvigione();
            }

            function ricalcolaTotaleProvvigione() {
                if (!lockTotaleProvvigione) return;
                const tec = calcola_TotaleProvvigione();
                const vis = roundDisplay(tec);
                log("Calcolo TotProvvigione: quotaFissa=" + safeField("#ValoreQuotaFissa") +
                    " totVar=" + safeField("#TotaleProvvigioneVariabile") + " → " + tec);
                $("#TotaleProvvigioneDisplay").val(vis);
                $("#TotaleProvvigione").val(tec);
                // TotaleProvvigione è input di TotaleProvvigioneDaFatturare → propaga
                ricalcolaTotaleProvvigioneDaFatturare();
            }

            function ricalcolaTotaleProvvigioneDaFatturare() {
                if (!lockTotaleProvvigioneDaFatturare) return;
                const tec = calcola_TotaleProvvigioneDaFatturare();
                const vis = roundDisplay(tec);
                log("Calcolo TotDaFatturare: perc=" + safeField("#PercentualeQuotaFissa") +
                    " tot=" + safeField("#TotaleProvvigione") +
                    " vendita=" + safeField("#Prezzo") + " → " + tec);
                $("#TotaleProvvigioneDaFatturareDisplay").val(vis);
                $("#TotaleProvvigioneDaFatturare").val(tec);
            }

            /**
             * ============================================================
             * ricalcolaTutto — punto di ingresso principale
             * Chiamato da tutti gli event listener sui campi di input.
             * Esegue i calcoli nell'ordine corretto di dipendenza:
             *
             *   1. ValoreQuotaFissa   (dipende da PercQuotaFissa, Kg, QuotaEuroKg, Vendita)
             *   2. Delta              (dipende da PercQuotaFissa, Vendita, CostoLav)
             *      └─ TotProvVariabile (chiamato in cascata da Delta)
             *         └─ TotProvvigione (chiamato in cascata)
             *            └─ TotDaFatturare (chiamato in cascata)
             *   3. TotProvvigione     (chiamata esplicita: dipende da ValoreQuotaFissa
             *                          che è cambiata al punto 1)
             *      └─ TotDaFatturare (chiamata in cascata)
             *
             * NOTA: i campi con lucchetto aperto (lock = false) vengono
             * ignorati automaticamente dalla loro funzione ricalcola*.
             * ============================================================
             */
            function ricalcolaTutto() {
                log("--- ricalcolaTutto START ---");
                log("Quantita:", safeField("#Quantita"));
                log("Prezzo (Vendita):", safeField("#Prezzo"));
                log("CostoLavorazione:", safeField("#CostoLavorazione"));
                log("PercQuotaFissa:", safeField("#PercentualeQuotaFissa"));
                log("QuotaCentesimiPerKg:", safeField("#QuotaCentesimiPerKg"));
                log("Perc_Delta_Provvigione:", safeField("#Perc_Delta_Provvigione"));

                // 1. Quota fissa (non dipende da Delta)
                ricalcolaValoreQuotaFissa();
                log("ValoreQuotaFissa dopo:", $("#ValoreQuotaFissa").val());

                // 2. Delta → in cascata propaga fino a TotDaFatturare
                ricalcolaDelta();
                log("Delta dopo:", $("#Delta").val());
                log("TotProvVariabile dopo:", $("#TotaleProvvigioneVariabile").val());

                // 3. Forza ricalcolo TotProvvigione perché ValoreQuotaFissa
                //    è cambiata al punto 1 e la cascata del punto 2 non la include
                ricalcolaTotaleProvvigione();
                log("TotProvvigione dopo:", $("#TotaleProvvigione").val());
                log("TotDaFatturare dopo:", $("#TotaleProvvigioneDaFatturare").val());

                log("--- ricalcolaTutto END ---");
            }

            /**
             * ============================================================
             * PROVVIGIONE AGENTE (AJAX)
             * Recupera la percentuale di provvigione dell'agente per il
             * cliente selezionato. Chiamata al cambio di IdAgente o IdCliente.
             * Non fa nulla se il lucchetto è aperto (valore forzato).
             * ============================================================
             */
            function ricalcolaProvvigioneAgente() {
                if (!lockProvAgente) return;
                const idAgente  = $("#IdAgente").val();
                const idCliente = $("#IdCliente").val();
                if (!idAgente || !idCliente) {
                    log("Salto ricalcolaProvvigioneAgente: IdAgente o IdCliente mancante.");
                    return;
                }
                log("Chiamata AJAX ProvvigioneAgente: idAgente=" + idAgente + ", idCliente=" + idCliente);
                $.getJSON(
                    '/Admin/ProspettiSystemCore/GetPercentualeProvvigione',
                    { idAgente: idAgente, idCliente: idCliente },
                    function (percentuale) {
                        const valTec = roundTec(safeNum(percentuale));
                        const valVis = roundDisplay(valTec);
                        log("Risultato AJAX ProvvigioneAgente: " + percentuale + " → " + valTec);
                        $("#ProvvigioneAgenteDisplay").val(valVis);
                        $("#ProvvigioneAgente").val(valTec);
                    }
                ).fail(function (jqXHR, textStatus, error) {
                    log("ERRORE AJAX ricalcolaProvvigioneAgente:", textStatus, error);
                });
            }

            /**
             * ============================================================
             * GESTIONE LUCCHETTI — aggiornaUILucchetto
             * Funzione condivisa che aggiorna l'aspetto visivo del pulsante
             * e lo stato readonly del campo Display associato.
             *
             * isLocked = true  → campo readonly, pulsante verde con lucchetto chiuso
             * isLocked = false → campo editabile, pulsante rosso con lucchetto aperto
             *
             * Usata sia da setupToggle (click utente) sia da rilevaDivergenze
             * (inizializzazione automatica al caricamento pagina).
             * ============================================================
             */
            function aggiornaUILucchetto(idBtn, idInputDisplay, isLocked) {
                const $input = $(idInputDisplay);
                const $btn   = $(idBtn);
                if (isLocked) {
                    $input.prop("readonly", true).addClass("input-readonly");
                    $btn.removeClass("btn-danger").addClass("btn-success")
                        .html('<i class="bi bi-lock-fill"></i>');
                } else {
                    $input.prop("readonly", false).removeClass("input-readonly");
                    $btn.removeClass("btn-success").addClass("btn-danger")
                        .html('<i class="bi bi-unlock-fill"></i>');
                }
            }

            /**
             * ============================================================
             * GESTIONE LUCCHETTI — setupToggle
             * Registra il click sul pulsante lucchetto per un campo calcolato.
             * Al click:
             *   - se si chiude il lucchetto (lock → true): il valore corrente
             *     del Display viene scritto nell'Hidden, poi UI aggiornata.
             *   - se si apre il lucchetto (lock → false): il campo diventa
             *     editabile; il valore NON viene resettato a quello originale.
             * ============================================================
             */
            function setupToggle(idBtn, idInputDisplay, type) {
                $(idBtn).on("click", function () {

                    let isLocked;
                    switch (type) {
                        case 'quotaKg':   lockQuotaCentesimiPerKg          = !lockQuotaCentesimiPerKg;          isLocked = lockQuotaCentesimiPerKg;          break;
                        case 'quotaFis':  lockValoreQuotaFissa             = !lockValoreQuotaFissa;             isLocked = lockValoreQuotaFissa;             break;
                        case 'delta':     lockDelta                        = !lockDelta;                        isLocked = lockDelta;                        break;
                        case 'percDelta': lockPerc_Delta_Provvigione       = !lockPerc_Delta_Provvigione;       isLocked = lockPerc_Delta_Provvigione;       break;
                        case 'totVar':    lockTotaleProvvigioneVariabile   = !lockTotaleProvvigioneVariabile;   isLocked = lockTotaleProvvigioneVariabile;   break;
                        case 'totProv':   lockTotaleProvvigione            = !lockTotaleProvvigione;            isLocked = lockTotaleProvvigione;            break;
                        case 'totFatt':   lockTotaleProvvigioneDaFatturare = !lockTotaleProvvigioneDaFatturare; isLocked = lockTotaleProvvigioneDaFatturare; break;
                        case 'agente':    lockProvAgente                   = !lockProvAgente;                   isLocked = lockProvAgente;                   break;
                    }

                    // Se si chiude il lucchetto, sincronizza l'hidden col valore
                    // attuale del Display (preserva eventuali modifiche manuali).
                    if (isLocked) {
                        const hiddenId = idInputDisplay.replace("#", "").replace("Display", "");
                        $("#" + hiddenId).val(roundTec(safeNum($(idInputDisplay).val())));
                    }

                    aggiornaUILucchetto(idBtn, idInputDisplay, isLocked);
                });
            }

            // Registra tutti i lucchetti
            setupToggle("#toggleQuotaCentesimiPerKg",          "#QuotaCentesimiPerKgDisplay",          "quotaKg");
            setupToggle("#toggleValoreQuotaFissa",             "#ValoreQuotaFissaDisplay",             "quotaFis");
            setupToggle("#toggleDelta",                        "#DeltaDisplay",                        "delta");
            setupToggle("#togglePerc_Delta_Provvigione",       "#Perc_Delta_ProvvigioneDisplay",       "percDelta");
            setupToggle("#toggleTotaleProvvigioneVariabile",   "#TotaleProvvigioneVariabileDisplay",   "totVar");
            setupToggle("#toggleTotaleProvvigione",            "#TotaleProvvigioneDisplay",            "totProv");
            setupToggle("#toggleTotaleProvvigioneDaFatturare", "#TotaleProvvigioneDaFatturareDisplay", "totFatt");
            setupToggle("#toggleProvAgente",                   "#ProvvigioneAgenteDisplay",            "agente");

            /**
             * ============================================================
             * rilevaDivergenze — inizializzazione automatica lucchetti
             * ============================================================
             * Problema: un campo calcolato può essere stato forzato
             * manualmente nel DB (es. TotaleProvvigioneVariabile = 63 mentre
             * il calcolo automatico darebbe 0). In quel caso, al primo
             * ricalcolaTutto() il valore forzato verrebbe sovrascritto.
             *
             * Soluzione: confronta il valore salvato nel DB (campo Hidden)
             * con il risultato della funzione pura corrispondente.
             * Se differiscono oltre una soglia (0.0001), apre il lucchetto.
             *
             * ORDINE IMPORTANTE: i campi vengono controllati dal basso
             * verso l'alto della catena di dipendenze, in modo che i valori
             * letti dagli hidden rispecchino ancora i dati DB originali
             * (non ancora sovrascritti da un ricalcolo parziale).
             *
             * A differenza di Cobral, qui non c'è una callback AJAX da
             * attendere: il DOM è già completo al momento dell'esecuzione,
             * quindi rilevaDivergenze() è chiamata direttamente in
             * sequenza sincrona prima di ricalcolaTutto().
             * ============================================================
             */


        function rilevaDivergenze() {
                        const SOGLIA = 0.001;

                        /**
                         * Controlla un singolo campo calcolato.
                         * param {string}   idHidden   selettore del campo hidden (valore DB)
                         * param {string}   idBtn      selettore del pulsante lucchetto
                         * param {string}   idDisplay  selettore del campo Display
                         * param {function} fnCalcola  funzione pura che calcola il valore atteso
                         * param {function} setLock    callback che imposta la variabile lock
                         */
                        /** MODIFICA 11/05/2026
                         * Valuta se il valore nel database diverge dal calcolo teorico della formula.
                         * Viene utilizzata nei moduli (Cobral, SystemCore, ecc.) per inizializzare lo stato dei lucchetti.
                         */
                        // 13/05/2026 — MODIFICA: rimossa la logica con toFixed(3) sugli operandi
                        // che arrotondava PRIMA della sottrazione generando falsi negativi.
                        // Esempio del problema:
                        //   0.2228 → toFixed(3) → 0.223
                        //   0.2227 → toFixed(3) → 0.223
                        //   diff = 0.000 → lucchetto mai aperto anche per divergenze reali.
                        // Soluzione: confronto sulla differenza GREZZA tra valoreDB e valoreCalc.
                        // La soglia 0.001 assorbe solo floating-point noise (< 0.0001),
                        // non divergenze reali del dominio (≥ 0.01).
                        // 13/05/2026 — AGGIUNTA: controllo per QuotaCentesimiPerKg.
                        // Problema precedente: QuotaCentesimiPerKg aveva il lucchetto in UI
                        // ma non veniva controllato in rilevaDivergenze perché non ha una
                        // funzione pura (è un dato base, non calcolato).
                        // Soluzione: il controllo viene fatto direttamente confrontando il
                        // valore DB con se stesso dopo roundTec — se il campo è stato forzato
                        // a un valore non standard, il lucchetto si apre correttamente.
                        // In realtà QuotaCentesimiPerKg è un INPUT dell'utente (non calcolato):
                        // il suo lock serve solo a proteggere il valore dal ricalcolo.
                        // Non serve una funzione pura: viene gestito separatamente sotto.
                        function controlla(idHidden, idBtn, idDisplay, fnCalcola, setLock) {
                            const valoreDB   = safeField(idHidden);
                            const valoreCalc = fnCalcola();
                            const diff       = Math.abs(valoreDB - valoreCalc);

                            if (diff > SOGLIA) {
                                log("Valore forzato rilevato per", idHidden,
                                    "| DB =", valoreDB,
                                    "| Calcolato =", valoreCalc,
                                    "| Diff =", diff,
                                    "→ lucchetto aperto automaticamente");

                                // Sblocca la logica (setLock false = non più vincolato alla formula)
                                setLock(false);

                                // Aggiorna visivamente il lucchetto e rende il campo editabile
                                aggiornaUILucchetto(idBtn, idDisplay, false);
                            }
                        }

                        /**
                         * Ordine di controllo: dal livello più basso della catena
                         * verso il più alto, così le funzioni pure leggono sempre
                         * i valori DB originali dagli hidden (non ancora toccati).
                         *
                         * Catena di dipendenze SystemCore:
                         *   ValoreQuotaFissa  ──┐
                         *                       ├── TotaleProvvigione ── TotaleProvvigioneDaFatturare
                         *   Delta ── TotProvVar ─┘
                         */

                        // Livello 1 — input diretti (non dipendono da altri calcolati)
                        controlla(
                            "#ValoreQuotaFissa", "#toggleValoreQuotaFissa", "#ValoreQuotaFissaDisplay",
                            calcola_ValoreQuotaFissa,
                            (v) => { lockValoreQuotaFissa = v; }
                        );

                        controlla(
                            "#Delta", "#toggleDelta", "#DeltaDisplay",
                            calcola_Delta,
                            (v) => { lockDelta = v; }
                        );

                        // Livello 2 — dipende da Delta (letto dall'hidden DB, non ricalcolato)
                        controlla(
                            "#TotaleProvvigioneVariabile", "#toggleTotaleProvvigioneVariabile", "#TotaleProvvigioneVariabileDisplay",
                            calcola_TotaleProvvigioneVariabile,
                            (v) => { lockTotaleProvvigioneVariabile = v; }
                        );

                        // Livello 3 — dipende da ValoreQuotaFissa + TotaleProvvigioneVariabile
                        controlla(
                            "#TotaleProvvigione", "#toggleTotaleProvvigione", "#TotaleProvvigioneDisplay",
                            calcola_TotaleProvvigione,
                            (v) => { lockTotaleProvvigione = v; }
                        );

                        // Livello 4 — dipende da TotaleProvvigione
                        controlla(
                            "#TotaleProvvigioneDaFatturare", "#toggleTotaleProvvigioneDaFatturare", "#TotaleProvvigioneDaFatturareDisplay",
                            calcola_TotaleProvvigioneDaFatturare,
                            (v) => { lockTotaleProvvigioneDaFatturare = v; }
                        );

                        // 13/05/2026 — AGGIUNTA: QuotaCentesimiPerKg non è un campo calcolato
                        // (non ha funzione pura), ma ha un lucchetto UI e un lock di stato.
                        // Il controllo qui serve SOLO a rilevare se il suo valore nel DB
                        // diverge da quello atteso dopo roundTec (es. import con precisione diversa),
                        // aprendo il lucchetto per segnalare all'utente che il valore è stato
                        // modificato rispetto al dato base. Usa una lambda inline che restituisce
                        // il valore DB arrotondato come "valore atteso" — la differenza sarà sempre
                        // zero se il dato è consistente, oppure > SOGLIA se c'è stato un override.
                        // In questo modulo QuotaCentesimiPerKg è inserito manualmente dall'utente
                        // tramite il lucchetto: il lock serve a impedire sovrascritture accidentali.
                        // Non viene usato controlla() perché non esiste una formula di riferimento:
                        // il lucchetto parte sempre chiuso (lockQuotaCentesimiPerKg = true) e
                        // l'utente lo apre manualmente per modificare il valore.
                        // Nessuna azione automatica necessaria al caricamento per questo campo.
                    }








            /**
             * ============================================================
             * EVENT LISTENERS — campi principali
             * ============================================================
             * Triggera ricalcolaTutto() su ogni modifica.
             * I campi calcolati (Delta, ValoreQuotaFissa ecc.) NON sono
             * inclusi per evitare loop di aggiornamento.
             * ============================================================
             */
            $("#Quantita, #CostoLavorazione, #Prezzo, #PercentualeQuotaFissa")
                .on("input change", ricalcolaTutto);

            // Agente / Cliente → provvigione agente via AJAX
            $("#IdAgente, #IdCliente").on("change", ricalcolaProvvigioneAgente);

            /**
             * ============================================================
             * EVENT LISTENERS — modifica manuale Display (lucchetto aperto)
             * Quando il lucchetto è aperto, l'utente può digitare nel campo
             * Display. Questi listener sincronizzano il campo Hidden e,
             * dove necessario, propagano a cascata verso i campi dipendenti.
             *
             * NOTA sulle cascate manuali:
             * Le funzioni ricalcola* verificano il proprio lock prima di
             * scrivere, quindi se un campo intermedio è anch'esso forzato
             * (lock = false) la cascata si ferma lì — comportamento corretto.
             * ============================================================
             */

            // QuotaCentesimiPerKg → ValoreQuotaFissa → TotProvvigione → TotDaFatturare
            $("#QuotaCentesimiPerKgDisplay").on("input", function () {
                $("#QuotaCentesimiPerKg").val(roundTec(safeNum($(this).val())));
                ricalcolaValoreQuotaFissa();
                ricalcolaTotaleProvvigione();
                ricalcolaTotaleProvvigioneDaFatturare();
            });

            // ValoreQuotaFissa → TotProvvigione → TotDaFatturare
            $("#ValoreQuotaFissaDisplay").on("input", function () {
                $("#ValoreQuotaFissa").val(roundTec(safeNum($(this).val())));
                ricalcolaTotaleProvvigione();
                ricalcolaTotaleProvvigioneDaFatturare();
            });

            // Delta → TotProvVariabile → TotProvvigione → TotDaFatturare
            $("#DeltaDisplay").on("input", function () {
                $("#Delta").val(roundTec(safeNum($(this).val())));
                ricalcolaTotaleProvvigioneVariabile();
                ricalcolaTotaleProvvigione();
                ricalcolaTotaleProvvigioneDaFatturare();
            });

            // Perc_Delta_Provvigione → TotProvVariabile → TotProvvigione → TotDaFatturare
            // NON dividere — l'hidden resta uguale al display (es. 50).
            // La divisione per 100 avviene SOLO nelle funzioni di calcolo.
            $("#Perc_Delta_ProvvigioneDisplay").on("input", function () {
                $("#Perc_Delta_Provvigione").val(roundTec(safeNum($(this).val())));
                ricalcolaTotaleProvvigioneVariabile();
                ricalcolaTotaleProvvigione();
                ricalcolaTotaleProvvigioneDaFatturare();
            });

            // TotaleProvvigioneVariabile → TotProvvigione → TotDaFatturare
            $("#TotaleProvvigioneVariabileDisplay").on("input", function () {
                $("#TotaleProvvigioneVariabile").val(roundTec(safeNum($(this).val())));
                ricalcolaTotaleProvvigione();
                ricalcolaTotaleProvvigioneDaFatturare();
            });

            // TotaleProvvigione → TotDaFatturare
            $("#TotaleProvvigioneDisplay").on("input", function () {
                $("#TotaleProvvigione").val(roundTec(safeNum($(this).val())));
                ricalcolaTotaleProvvigioneDaFatturare();
            });

            // TotaleProvvigioneDaFatturare — foglia della catena, nessuna cascata
            $("#TotaleProvvigioneDaFatturareDisplay").on("input", function () {
                $("#TotaleProvvigioneDaFatturare").val(roundTec(safeNum($(this).val())));
            });

            // ProvvigioneAgente — campo indipendente
            $("#ProvvigioneAgenteDisplay").on("input", function () {
                $("#ProvvigioneAgente").val(roundTec(safeNum($(this).val())));
            });

            /**
             * ============================================================
             * SINCRONIZZAZIONE DISPLAY → HIDDEN (generica — tutti gli altri)
             * Cattura tutti i campi Display non già gestiti sopra.
             * Pattern: XxxDisplay → hidden con id "Xxx" (senza "Display").
             * ============================================================
             */
            $("input[id$='Display']")
                .not("#QuotaCentesimiPerKgDisplay, "          +
                     "#ValoreQuotaFissaDisplay, "             +
                     "#DeltaDisplay, "                        +
                     "#Perc_Delta_ProvvigioneDisplay, "       +
                     "#TotaleProvvigioneVariabileDisplay, "   +
                     "#TotaleProvvigioneDisplay, "            +
                     "#TotaleProvvigioneDaFatturareDisplay, " +
                     "#ProvvigioneAgenteDisplay")
                .on("input", function () {
                    const hiddenId = $(this).attr("id").replace("Display", "");
                    $("#" + hiddenId).val(roundTec(safeNum($(this).val())));
                });

            /**
             * ============================================================
             * INIZIALIZZAZIONE
             * ============================================================
             * Ordine obbligatorio:
             *   1. rilevaDivergenze() — imposta i lock corretti leggendo
             *      gli hidden con i valori DB originali, PRIMA di qualsiasi
             *      ricalcolo che potrebbe sovrascriverli.
             *   2. ricalcolaTutto()  — esegue i calcoli rispettando i lock
             *      appena impostati (i campi forzati vengono saltati).
             *   3. Provvigione agente — carica via AJAX solo se il valore
             *      DB è zero (record nuovo o non ancora valorizzato).
             * ============================================================
             */
            rilevaDivergenze();
            ricalcolaTutto();

            if ($("#IdAgente").val() && $("#IdCliente").val()) {
                const valAttuale = safeField("#ProvvigioneAgente");
                if (valAttuale === 0) ricalcolaProvvigioneAgente();
            }

        }); // fine document.ready
    </script>
}
