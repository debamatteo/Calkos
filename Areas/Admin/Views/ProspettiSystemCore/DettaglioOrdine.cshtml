                        <button type="button" id="toggleDelta" class="btn btn-success">
                            <i class="bi bi-lock-fill"></i>
                        </button>
                    </div>
                    <input type="hidden" id="Delta" name="Delta" value="@FTecnico(Model.Delta, 6)" />
                </div>


            </div>

            @* ============================================================
               RIGA PROVVIGIONI DA IMPLEMENTARE LE FORMULE DI CALCOLO 
               ============================================================ *@

            <div class="row g-3 mt-2">

                @*Perc_Delta_Provvigione*@
                <!-- Percentuale Delta Provvigione (estratta da Formula Excel)
                     usato nel calcolo di Totale provv variabile = TotaleProvvigioneVariabile -->
                <div class="col-md-3">
                    <label class="form-label fw-bold">Perc. Delta Provv. (%)</label>
                    <i class="bi bi-info-circle-fill text-danger ms-2"
                       style="font-size: 1.2rem;"
                       title="Inserire la percentuale in formato umano: 5 significa 5%, NON 0,05"></i>

                    <div class="input-group">

                        <!-- DISPLAY A 3 DECIMALI -->
