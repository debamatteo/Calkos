            @* ============================================================
               SEZIONE: PREZZI VENDITA
               ============================================================ *@
            <div class="row g-3">
                @* <h5 class="fw-bold mt-4">Quantità e Prezzi </h5>   *@       

                    @*  Prezzo di vendita--	PrezzoVendita
                    FORMULA N+O+P = Lavorazione + Base + CIT vendita
                    LavorazionePrezzoVendita      +	BaseVendita +	CITsuVendita *@

                <div class="col-md-2">
                    <label class="form-label fw-bold">Prezzo Vendita</label>
                    <div class="input-group">
                        <input type="number"
                               step="any"
                               id="PrezzoVenditaDisplay"
                               class="form-control input-readonly"
                               readonly
                               value="@FDisplay(Model.PrezzoVendita, 3)"
                               title="Lavorazione + Base + CIT" />
                        <button type="button" id="togglePrezzoVendita" class="btn btn-success">
                            <i class="bi bi-lock-fill"></i>
                        </button>
                    </div>
                    <input type="hidden" id="PrezzoVendita" name="PrezzoVendita" value="@FTecnico(Model.PrezzoVendita, 6)" />
                </div>



                @*  Delta	 — differenza vendita/acquisto, mai negativa *@

                <!--
                FORMULA =IF(Q-H<=0, 0, Q-H)
                SE (Prezzo Vendita-Prezzo <=0, 0, Prezzo Vendita-Prezzo )
                IF(Prezzo Vendita-PrezzoAcquisto<=0, 0, Prezzo Vendita-PrezzoAcquisto)
                H	Prezzo	--campo db	PrezzoAcquisto
                Q	Prezzo di vendita	-- campo db PrezzoVendita
                -->

                <div class="col-md-2">
                    <label class="form-label fw-bold">Delta</label>
                    <div class="input-group">
                        <input type="number"
                               step="any"
                               id="DeltaDisplay"
                               class="form-control input-readonly"
                               readonly
                               value="@FDisplay(Model.Delta, 3)"
                               title="SE (Prezzo Vendita-PrezzoAcquisto<=0)  Delta=0 Altrimenti Delta= (Prezzo Vendita-PrezzoAcquisto)" />
                        <button type="button" id="toggleDelta" class="btn btn-success">
                            <i class="bi bi-lock-fill"></i>
                        </button>
                    </div>
                    <input type="hidden" id="Delta" name="Delta" value="@FTecnico(Model.Delta, 6)" />
                </div>

                @*  Percentuale delta	— PercentualeDelta  *@
                <!-- Percentuale Delta Provvigione (estratta da Formula Excel)
                    usato nel calcolo di Totale provv variabile = TotaleVariabileProvvigione -->
                <div class="col-md-2">
                    <label class="form-label fw-bold">Percentuale Delta (%)</label>
                    <i class="bi bi-info-circle-fill text-danger ms-2" style="font-size: 1.2rem;" title="Inserire la percentuale in formato umano: 5 significa 5%, NON 0,05"></i>
                    <div class="input-group">

                        <!-- DISPLAY A 3 DECIMALI  -->
                        @* // il valore nel DB è già un numero intero percentuale (es. 50 = 50%)
                               // NON si moltiplica per 100: il Display mostra direttamente il valore salvato *@
                        <input type="number"
                               step="any"
                               id="PercentualeDeltaDisplay"
                               class="form-control input-readonly"
                               readonly
                              
                               value="@FDisplay(Model.PercentualeDelta)" 
                               title="Percentuale su Delta per Calcolo Totale provv variabile" />

                        <!-- Lucchetto -->
                        <button type="button" id="togglePercentualeDelta" class="btn btn-success">
                            <i class="bi bi-lock-fill"></i>
                        </button>
                    </div>

                    <!-- VALORE TECNICO A 6 DECIMALI  -->
                    <input type="hidden"
                           id="PercentualeDelta"
                           name="PercentualeDelta"
                           value="@FTecnico(Model.PercentualeDelta)" />

                           @*  <div style="color:red; font-weight:bold;">
                                DEBUG VIEW: @Model.PercentualeDelta
                            </div> *@
                </div>


                @* Totale provv variabile--	TotaleVariabileProvvigione *@
                @*  
                    Totale provv variabile	 = FORMULA (R*C)*S 
                    campo db TotaleVariabileProvvigione
                    R Delta --campo db  Delta            C	KG --campo db Quantita            S	Percentuale delta --campo db PercentualeDelta
                    FORMULA (Delta*KG)*Percentuale delta	        *
                    DB (Delta*Quantita)*PercentualeDelta	  *@

                <div class="col-md-2">
                    <label class="form-label fw-bold">Totale Provv Variabile</label>
                    <div class="input-group">
                        <input type="number"
                               step="any"
                               id="TotaleVariabileProvvigioneDisplay"
                               class="form-control input-readonly"
                               readonly
                               value="@FDisplay(Model.TotaleVariabileProvvigione, 3)"
                               title="Totale provv variabile = (Delta*KG) * Percentuale delta	" />
                        <button type="button" id="toggleTotaleVariabileProvvigione" class="btn btn-success">
                            <i class="bi bi-lock-fill"></i>
                        </button>
                    </div>
                    <input type="hidden" id="TotaleVariabileProvvigione" name="TotaleVariabileProvvigione" value="@FTecnico(Model.TotaleVariabileProvvigione, 6)" />
                </div>

                @* 
                    Totalone    -- TotaleProvvigione
                    FORMULA =J+M+T
                    (CIT €/Kg)+ (Commissioni)+(Totale provv variabile)
                    CIT_EUR_KG +   ValoreProvvigioneFissa +TotaleVariabileProvvigione
                    *@

                <div class="col-md-2">
                    <label class="form-label fw-bold">Totalone</label>
                    <div class="input-group">
                        <input type="number"
                               step="any"
                               id="TotaleProvvigioneDisplay"
                               class="form-control input-readonly"
                               readonly
                               value="@FDisplay(Model.TotaleProvvigione, 3)"
                               title="Totalone = (CIT €/Kg)+ (Commissioni)+(Totale provv variabile)" />
                        <button type="button" id="toggleTotaleProvvigione" class="btn btn-success">
                            <i class="bi bi-lock-fill"></i>
                        </button>
                    </div>
                    <input type="hidden" id="TotaleProvvigione" name="TotaleProvvigione" value="@FTecnico(Model.TotaleProvvigione, 6)" />
                </div>
            </div>




            @* ============================================================
               SEZIONE: AGENTE E PAGAMENTO
               ============================================================ *@
            <h5 class="fw-bold mt-4">Agente e Pagamento </h5>
            <div class="row g-3">

                <div class="col-md-2">
                    @* Agente: select costruita manualmente (non con asp-items) per poter
                       aggiungere l'attributo data-percentuale su ogni option,
                       necessario per il calcolo client-side della provvigione.

                       FIX: ViewBag.Agenti castato a IEnumerable<AgenteSelectItem> in cima alla view.
                       Il controller popola ViewBag.Agenti con List<AgenteSelectItem>, tipo custom
                       che espone Id, Nome e PercentualeDefault.
                       Le proprietà usate nel foreach sono quindi:
                         a.Id               → value dell'option
                         a.Nome             → testo visibile dell'option
                         a.PercentualeDefault → attributo data-percentuale per il calcolo JS
                    *@
                    <label class="form-label fw-bold">Agente</label>
                    <select id="IdAgente" name="IdAgente" class="form-select">
                        @foreach (var a in agenti)
                        {
                            bool isSelected = (Model?.IdAgente.ToString() == a.Id.ToString());
                            <option value="@a.Id"
                                    data-percentuale="@a.PercentualeDefault"
                                    selected="@(isSelected ? "selected" : null)">
                                @a.Nome
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    @* 28/04/2026 *@
                    @* ProvvigioneAgente: recuperata via AJAX dal controller al cambio di Agente o Cliente.
                    Campo readonly di default, sbloccabile da Admin tramite il lucchetto.
