@using Calkos.web.Models.DTO
@model CalkosManager.Domain.Entities.ProspettoCobral
@* ============================================================
   ANTIFORGERY TOKEN — Inserito UNA SOLA VOLTA qui in cima.
   Il token Antiforgery è una "chiave segreta" che il server genera per assicurarsi che la richiesta arrivi effettivamente dalla tua pagina web
   e non da un sito malevolo che tenta di eseguire azioni a nome dell'utente loggato.
   ============================================================ *@
@Html.AntiForgeryToken()

@{
    ViewData["Title"] = "Dettaglio Ordine COBRAL";
    bool isAdmin = User.IsInRole("Admin");

    @* ============================================================
       FIX cast ViewBag.Agenti → AgenteSelectItem
       Il controller CaricaLookup popola ViewBag.Agenti con List<AgenteSelectItem>
       (tipo custom che porta anche PercentualeDefault, non disponibile in SelectListItem).
       Il cast deve corrispondere esattamente al tipo prodotto dal controller,
       altrimenti "as" restituisce null silenziosamente e la select rimane vuota.
       ============================================================ *@
    var agenti = ViewBag.Agenti as IEnumerable<AgenteSelectItem>
                 ?? Enumerable.Empty<AgenteSelectItem>();
}

@* ============================================================
   HELPER LOCALE — FormatDecimal
   Accetta object? per compatibilità con i valori restituiti
   dalla Reflection nel blocco "Altri Campi".
   Forza il punto decimale (InvariantCulture) per i campi
   type="number" del browser, che non accetta la virgola.
   ============================================================ *@
@* @functions {
    public string FormatDecimal(object? valore, int decimali = 3)
    {
        if (valore == null || valore == DBNull.Value) return string.Empty;
        if (decimal.TryParse(valore.ToString(), out decimal d))
            return d.ToString("F" + decimali, System.Globalization.CultureInfo.InvariantCulture);
        return valore.ToString() ?? string.Empty;
    }
} *@
@functions {

    // ============================================================
    // CONFIGURAZIONE CENTRALIZZATA DECIMALI DELLA VIEW
    // Cambi qui e aggiorni tutta la pagina
    // ============================================================
    public const int DECIMALI_DISPLAY = 4;
    public const int DECIMALI_TECNICI = 4;

    public string FormatDecimal(object? valore, int decimali = DECIMALI_DISPLAY)
    {
        if (valore == null || valore == DBNull.Value)
            return string.Empty;

        if (decimal.TryParse(valore.ToString(), out decimal d))
        {
            return d.ToString(
                "F" + decimali,
                System.Globalization.CultureInfo.InvariantCulture
            );
        }

        return valore?.ToString() ?? string.Empty;
    }

    // ============================================================
    // DISPLAY UI
    // ============================================================
    public string FDisplay(object? valore, int decimali = 0)
    {
        //int decimali = 0 introdotto  solo per non cambiare decine di chiamate a FDisplay, ma in realtà ora è ridondante perché FormatDecimal ha già un default.
        return FormatDecimal(valore, DECIMALI_DISPLAY);
    }

    // ============================================================
    // VALORI TECNICI/HIDDEN
    // ============================================================
    public string FTecnico(object? valore, int decimali = 0)
    {
        //int decimali = 0 introdotto  solo per non cambiare decine di chiamate a FDisplay, ma in realtà ora è ridondante perché FormatDecimal ha già un default.
        return FormatDecimal(valore, DECIMALI_TECNICI);
    }
}
<div class="d-flex align-items-center mb-4">
    <h1 class="h3 fw-bold">Dettaglio Ordine COBRAL</h1>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="card shadow-sm border-0">
    <div class="card-body">

        <form asp-action="DettaglioOrdine" method="post">

            @* ============================================================
               RIEPILOGO ERRORI MODELSTATE
               Cicla su tutti i campi invalidi e stampa il nome
               della proprietà + il messaggio di validazione.
               ============================================================ *@
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger mt-3">
                    <h5 class="fw-bold">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        Attenzione: correggi i seguenti errori
                    </h5>
                    <ul>
                        @foreach (var modelState in ViewData.ModelState.Where(x => x.Value.Errors.Any()))
                        {
                            foreach (var error in modelState.Value.Errors)
                            {
                                <li><strong>@modelState.Key</strong>: @error.ErrorMessage</li>
                            }
                        }
                    </ul>
                </div>
            }

            @* Campo hidden obbligatorio per identificare il record in POST *@
            <input type="hidden" asp-for="IdProspettoCobral" />

            @* ============================================================
               SEZIONE: DATI DOCUMENTO
               ============================================================ *@
            <h5 class="fw-bold mt-3">Dati Documento</h5>
            <div class="row g-3">

                <div class="col-md-3">
                    @* NumeroOrdine: libero solo su record nuovo (ID=0) o duplicato.
                       Su record esistente viene bloccato in readonly per evitare
                       la modifica accidentale della chiave logica del documento. *@
                    <label class="form-label fw-bold required-label">Numero Ordine</label>
                    @if (Model.IdProspettoCobral == 0)
                    {
                        <input asp-for="NumeroOrdine" type="text" class="form-control" placeholder="Inserisci numero ordine..." />
                    }
                    else
                    {
                        <input asp-for="NumeroOrdine" type="text" class="form-control input-readonly" readonly="readonly" />
                    }
                    <span asp-validation-for="NumeroOrdine" class="text-danger small"></span>
                </div>

                <div class="col-md-3">
                    @* NumeroDDT: modificabile solo da Admin, in sola lettura per gli altri ruoli *@
                    <label class="form-label fw-bold">Numero DDT</label>
                    @if (isAdmin)
                    {
                        <input class="form-control" asp-for="NumeroDDT" type="text" />
                    }
                    else
                    {
                        <input asp-for="NumeroDDT" type="text" class="form-control input-readonly" readonly="readonly" />
                    }
                </div>

                <div class="col-md-3">
                    @* NumeroFattura: stessa logica di NumeroDDT *@
                    <label class="form-label fw-bold">Numero Fattura</label>
                    @if (isAdmin)
                    {
                        <input class="form-control" asp-for="NumeroFattura" type="text" />
                    }
                    else
                    {
                        <input asp-for="NumeroFattura" type="text" class="form-control input-readonly" readonly="readonly" />
                    }
                </div>

                <div class="col-md-3">
                    @* IdCliente: per i non-Admin la select è disabled (non invia il valore in POST),
                       quindi aggiungiamo un hidden field per garantire che il valore arrivi al server. *@
                    <label class="form-label fw-bold required-label">Cliente</label>
                    @if (isAdmin)
                    {
                        <select asp-for="IdCliente" asp-items="ViewBag.Clienti" class="form-select"></select>
                    }
                    else
                    {
                        <select asp-for="IdCliente" asp-items="ViewBag.Clienti" class="form-select input-readonly" disabled="disabled"></select>
                        <input type="hidden" asp-for="IdCliente" />
                    }
                    <span asp-validation-for="IdCliente" class="text-danger small"></span>
                </div>

            </div>

            @* ============================================================
               SEZIONE: QUANTITÀ E PREZZI
               ============================================================ *@
            <h5 class="fw-bold mt-4">Quantità e Prezzi</h5>
            <div class="row g-3">

                <div class="col-md-3">
                    @* IdMateriale: disabled per non-Admin → hidden field necessario per il POST *@
                    <label class="form-label fw-bold required-label">Materiale</label>
                    @if (isAdmin)
                    {
                        <select asp-for="IdMateriale" id="IdMateriale" asp-items="ViewBag.Materiali" class="form-select"></select>
                    }
                    else
                    {
                        <select asp-for="IdMateriale" id="IdMateriale" asp-items="ViewBag.Materiali" class="form-select input-readonly" disabled="disabled"></select>
                        <input type="hidden" asp-for="IdMateriale" />
                    }
                    <span asp-validation-for="IdMateriale" class="text-danger small"></span>
                </div>

                <div class="col-md-3">
                    @* IdUnitaMisura: stessa logica di IdMateriale *@
                    <label class="form-label fw-bold required-label">Unità di Misura</label>
                    @if (isAdmin)
                    {
                        <select asp-for="IdUnitaMisura" asp-items="ViewBag.UnitaMisura" class="form-select"></select>
                    }
                    else
                    {
                        <select asp-for="IdUnitaMisura" asp-items="ViewBag.UnitaMisura" class="form-select input-readonly" disabled="disabled"></select>
                        <input type="hidden" asp-for="IdUnitaMisura" />
                    }
                    <span asp-validation-for="IdUnitaMisura" class="text-danger small"></span>
                </div>

                <div class="col-md-2">
                    @* Quantita: FormatDecimal con 3 decimali (kg commerciali).
                       Input type="number" richiede il punto come separatore decimale,
                       da qui l'uso di InvariantCulture nel FormatDecimal. *@
                    <label class="form-label fw-bold required-label">Quantità (Kg)</label>
                    @if (isAdmin)
                    {
                        <input asp-for="Quantita" id="Quantita" type="number" step="any"
                               class="form-control"
                               value="@FDisplay(Model.Quantita, 3)" />
                    }
                    else
                    {
                        <input asp-for="Quantita" id="Quantita" type="number" step="any"
                               class="form-control input-readonly" readonly="readonly"
                               value="@FDisplay(Model.Quantita, 3)" />
                    }
                    <span asp-validation-for="Quantita" class="text-danger small"></span>
                </div>

                <div class="col-md-2">
                    <label class="form-label fw-bold required-label">Prezzo</label>
                    @if (isAdmin)
                    {
                        <input asp-for="Prezzo" id="Prezzo" type="number" step="any"
                               class="form-control"
                               value="@FDisplay(Model.Prezzo, 3)" />
                    }
                    else
                    {
                        <input asp-for="Prezzo" id="Prezzo" type="number" step="any"
                               class="form-control input-readonly" readonly="readonly"
                               value="@FDisplay(Model.Prezzo, 3)" />
                    }
                    <span asp-validation-for="Prezzo" class="text-danger small"></span>
                </div>

                <div class="col-md-2">
                    <label class="form-label fw-bold required-label">Data Riferimento Prezzo</label>
                    @if (isAdmin)
                    {
                        <input asp-for="DataRiferimentoPrezzo" type="date" class="form-control" />
                    }
                    else
                    {
                        <input asp-for="DataRiferimentoPrezzo" id="DataRiferimentoPrezzo" type="date"
                               class="form-control input-readonly" readonly="readonly" />
                    }
                    <span asp-validation-for="DataRiferimentoPrezzo" class="text-danger small"></span>
                </div>

            </div>

            @* ============================================================
               SEZIONE: LAVORAZIONI
               I campi "Display" sono visivi e readonly di default.
               I campi "Hidden" (es. id="PrLavSpess") sono quelli che
               vengono realmente inviati al server nel POST.
               Il pulsante lucchetto alterna tra calcolo automatico (locked)
               e inserimento manuale (unlocked), gestito dallo script.
               ============================================================ *@
            <h5 class="fw-bold mt-4">Lavorazioni</h5>
            <div class="row g-3">

                <div class="col-md-2">
                    @* Spessore: select popolata dinamicamente via AJAX in base al materiale selezionato *@
                    <label class="form-label fw-bold">Spessore</label>
                    <select id="Spessore" name="Spessore" class="form-select">
                        <option value="">-- seleziona --</option>
                    </select>
                </div>

                @* Hidden che trasporta il valore di Spessore salvato nel DB,
                   usato dallo script per pre-selezionare la option corretta dopo l'AJAX *@
                <input type="hidden" id="SpessoreSelezionato" value="@Model.Spessore" />

                <div class="col-md-2">
                    @* PrLavSpess (Prezzo Lavorazione Spessore):
                       = Lav.AlluminioSpessore + Lav.OttoneSpessore + Lav.RameSpessore + AltrePercentuali
                       Calcolato automaticamente (lock attivo) o inseribile manualmente (lock disattivo).
                       Il campo "Display" mostra il valore; il campo "Hidden" lo invia al server. *@
                    <label class="form-label fw-bold">Prz.Lav.Spessore</label>
                    <div class="input-group">
                        <input type="number"
                               step="any"
                               id="PrLavSpessDisplay"
                               class="form-control input-readonly"
                               readonly
                               value="@FDisplay(Model.PrLavSpess, 3)"
                               title="PrLavSpess = Lav.AlluminioSpessore + Lav.OttoneSpessore + Lav.RameSpessore + AltrePercentuali" />
                        <button type="button" id="togglePrLavSpess" class="btn btn-success">
                            <i class="bi bi-lock-fill"></i>
                        </button>
                    </div>
                    <input type="hidden" id="PrLavSpess" name="PrLavSpess" value="@FTecnico(Model.PrLavSpess, 6)" />
                </div>


                <div class="col-md-2">
                    @* Larghezza: select popolata dinamicamente via AJAX, come Spessore *@
                    <label class="form-label fw-bold">Larghezza</label>
                    <select id="Larghezza" name="Larghezza" class="form-select">
                        <option value="">-- seleziona --</option>
                    </select>
                </div>

                @* Hidden che trasporta il valore di Larghezza salvato nel DB *@
                <input type="hidden" id="LarghezzaSelezionata" value="@Model.Larghezza" />

                <div class="col-md-2">
                    @* PrLavLarg (Prezzo Lavorazione Larghezza):
                       = Lav.AlluminioLarghezza + Lav.OttoneLarghezza + Lav.RameLarghezza + Lav.BronzoLarghezza
                       Stessa logica Display/Hidden di PrLavSpess. *@
                    <label class="form-label fw-bold">Prz.Lav.Larghezza</label>
                    <div class="input-group">
                        <input type="number"
                               step="any"
                               id="PrLavLargDisplay"
                               class="form-control input-readonly"
                               readonly
                               value="@FDisplay(Model.PrLavLarg, 3)"
                               title="PrLavLarg = Lav.AlluminioLarghezza + Lav.OttoneLarghezza + Lav.RameLarghezza + Lav.BronzoLarghezza" />
                        <button type="button" id="togglePrLavLarg" class="btn btn-success">
                            <i class="bi bi-lock-fill"></i>
                        </button>
                    </div>

                    <input type="hidden" id="PrLavLarg" name="PrLavLarg" value="@FTecnico(Model.PrLavLarg, 6)" />
                </div>


                <div class="col-md-2">
                    @* value="@FDisplay(Model.PrLavTotale, 3)" *@ @* 21/05/2026 *@
                    @* PrLavTotale (Prezzo Lavorazione Totale):
                       = PrLavSpess + PrLavLarg + ExtraPrezzoKg + ExtraPrezzoStagnato
                       Viene aggiornato automaticamente ogni volta che cambiano i suoi componenti. *@
                    <label class="form-label fw-bold">Pr. Lav. Totale</label>
                    <div class="input-group">
                        <input type="number"
                               step="any"
                               id="PrLavTotaleDisplay"
                               class="form-control input-readonly"
                               readonly
                               value="@FDisplay(Model.PrLavTotale, 3)" 
                               title="PrLavTotale = PrLavSpess + PrLavLarg + ExtraPrezzoKg + ExtraPrezzoStagnato" />
                        <button type="button" id="togglePrLavTotale" class="btn btn-success">
                            <i class="bi bi-lock-fill"></i>
                        </button>
                    </div>
                    <input type="hidden" id="PrLavTotale" name="PrLavTotale" value="@FTecnico(Model.PrLavTotale, 6)" />
                </div>

            </div>

            @* ============================================================
               RIGA PROVVIGIONI, COMMISSIONI, PREZZI FINALI
               ============================================================ *@
            <div class="row g-3 mt-2">

                <div class="col-md-3">
                    @* Provvigione: commissione percentuale applicata al kg *@
                    <label class="form-label fw-bold">Provvigione</label>
                    @if (isAdmin)
                    {
                        <input asp-for="Provvigione" id="Provvigione" type="number" step="any"
                               class="form-control"
                               value="@FDisplay(Model.Provvigione, 3)" />
                    }
                    else
                    {
                        <input asp-for="Provvigione" id="Provvigione" type="number" step="any"
                               class="form-control input-readonly" readonly="readonly"
                               value="@FDisplay(Model.Provvigione, 3)" />
                    }
                </div>

                <div class="col-md-3">
                    @* ValoreCommissioni (€):
                       = Provvigione × Quantita
                       Calcolato automaticamente. Il campo Display è visivo,
                       il campo Hidden è quello che finisce nel database. *@
                    <label class="form-label fw-bold">Commissioni €</label>
                    <div class="input-group">
                        <input type="number"
                               step="any"
                               id="ValoreCommissioniDisplay"
                               class="form-control input-readonly"
                               readonly
                               value="@FDisplay(Model.ValoreCommissioni, 3)"
                               title="ValoreCommissioni = Provvigione × Quantita" />
                        <button type="button" id="toggleValoreCommissioni" class="btn btn-success">
                            <i class="bi bi-lock-fill"></i>
                        </button>
                    </div>
                    <input type="hidden" id="ValoreCommissioni" name="ValoreCommissioni" value="@FTecnico(Model.ValoreCommissioni, 6)" />
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-bold">Prezzo Vendita</label>
                    @if (isAdmin)
                    {
                        <input asp-for="PrezzoVendita" id="PrezzoVendita" type="number" step="any"
                               class="form-control"
                               value="@FDisplay(Model.PrezzoVendita, 3)" />
                    }
                    else
                    {
                        <input asp-for="PrezzoVendita" id="PrezzoVendita" type="number" step="any"
                               class="form-control input-readonly" readonly="readonly"
                               value="@FDisplay(Model.PrezzoVendita, 3)" />
                    }
                </div>

                <div class="col-md-3">
                    @* Differenza (margine finale):
                       = PrezzoVendita - PrLavTotale - Prezzo
                       Aggiornata automaticamente ad ogni variazione dei suoi componenti. *@
                    <label class="form-label fw-bold">Differenza</label>
                    <div class="input-group">
                        <input type="number"
                               step="any"
                               id="DifferenzaDisplay"
                               class="form-control input-readonly"
                               readonly
                               value="@FDisplay(Model.Differenza, 3)"
                               title="Differenza = PrezzoVendita - PrLavTotale - Prezzo" />
                        <button type="button" id="toggleDifferenza" class="btn btn-success">
                            <i class="bi bi-lock-fill"></i>
                        </button>
                    </div>
                    <input type="hidden" id="Differenza" name="Differenza" value="@FTecnico(Model.Differenza, 6)" />
                </div>

            </div>

            @* ============================================================
               SEZIONE: DATE
               ============================================================ *@
            <h5 class="fw-bold mt-4">Date</h5>
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label fw-bold">Data Consegna Ipotetica</label>
                    <input asp-for="DataConsegnaIpotetica" type="date" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">Scadenza</label>
                    <input asp-for="Scadenza" type="date" class="form-control" />
                </div>
            </div>



            @* ============================================================
               SEZIONE: AGENTE E PAGAMENTO
               ============================================================ *@
            <h5 class="fw-bold mt-4">Agente e Pagamento</h5>
            <div class="row g-3">

                <div class="col-md-4">
                    @* Agente: select costruita manualmente (non con asp-items) per poter
                       aggiungere l'attributo data-percentuale su ogni option,
                       necessario per il calcolo client-side della provvigione.

                       FIX: ViewBag.Agenti castato a IEnumerable<AgenteSelectItem> in cima alla view.
                       Il controller popola ViewBag.Agenti con List<AgenteSelectItem>, tipo custom
                       che espone Id, Nome e PercentualeDefault.
                       Le proprietà usate nel foreach sono quindi:
                         a.Id               → value dell'option
                         a.Nome             → testo visibile dell'option
                         a.PercentualeDefault → attributo data-percentuale per il calcolo JS
                    *@
                    <label class="form-label fw-bold">Agente</label>
                    <select id="IdAgente" name="IdAgente" class="form-select">
                        @foreach (var a in agenti)
                        {
                            bool isSelected = (Model?.IdAgente.ToString() == a.Id.ToString());
                            <option value="@a.Id"
                                    data-percentuale="@a.PercentualeDefault"
                                    selected="@(isSelected ? "selected" : null)">
                                @a.Nome
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-4">
                    @* ProvvigioneAgente: recuperata via AJAX dal controller al cambio di Agente o Cliente.
                       Campo readonly di default, sbloccabile da Admin tramite il lucchetto.
                       Formattiamo con F3 + InvariantCulture per type="number". *@
                    <label class="form-label fw-bold">Provvigione Agente (%)</label>
                    <i class="bi bi-info-circle-fill text-danger ms-2" style="font-size: 1.2rem;" title="Inserire la percentuale in formato umano: 5 significa 5%, NON 0,05"></i>
                    <div class="input-group">
                        @{
                            string provValue = FTecnico(Model.ProvvigioneAgente);
                        }
                        @* Campo visibile: solo id (niente name) per evitare doppio invio nel POST.
                           Il name="ProvvigioneAgente" è sull'hidden qui sotto, che è l'unico
                           che partecipa al binding del controller. *@
                        <input id="ProvvigioneAgenteDisplay"
                               type="number"
                               step="any"
                               class="form-control input-readonly"
                               readonly="readonly"
                               value="@provValue" />
                        @if (isAdmin)
                        {
                            <button type="button" id="toggleProvAgente" class="btn btn-success">
                                <i class="bi bi-lock-fill"></i>
                            </button>
                        }
                    </div>
                    @* Hidden: porta il valore al POST esattamente come tutti gli altri campi calcolati
                       (es. ValoreCommissioni, Differenza, ecc.).
                       Il JS lo aggiorna in sincronia con il Display. *@
                    <input type="hidden"
                           id="ProvvigioneAgente"
                           name="ProvvigioneAgente"
                           value="@provValue" />
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold">Tipo Pagamento</label>
                    <select asp-for="IdTipoPagamento" class="form-select"
                            asp-items="@(ViewBag.TipiPagamento as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)">
                    </select>
                </div>

            </div>


            @* ============================================================
               SEZIONE: ALTRI CAMPI (collapsible)
               Generata via Reflection su tutte le proprietà del modello
               non già presenti nelle sezioni precedenti.
               Usa FormatDecimal per i campi decimal (3 decimali = precisione tecnica Cobral).
               ============================================================ *@
            <div class="row g-3">
                <div class="col-md-2">

                    <h5 class="fw-bold mt-4">Altri Campi</h5>
                    <button class="btn btn-outline-primary mb-3" type="button"
                            data-bs-toggle="collapse" data-bs-target="#tecnici">
                        Mostra / Nascondi Altri Campi
                    </button>
                </div>
            </div>

            <div class="collapse" id="tecnici">
                <div class="card card-body bg-light">
                    @* Aggiunta card per pulizia visiva *@
                    <div class="row g-3">
                        @foreach (var prop in typeof(CalkosManager.Domain.Entities.ProspettoCobral).GetProperties())
                        {
                            @* Lista completa dei campi da escludere dalla sezione "Altri Campi"
                               perché già gestiti nelle sezioni precedenti o non rilevanti per l'utente *@
                            var skip = new[] {
                                                "IdProspettoCobral","IdFileImportato","IdImportCobral",
                                                "IdCliente","IdMateriale","IdUnitaMisura",
                                                "NumeroOrdine","NumeroDDT","NumeroFattura",
                                                "Quantita","Prezzo","ValoreCommissioni","PrezzoVendita","Differenza",
                                                "DataRiferimentoPrezzo","DataConsegnaIpotetica","Scadenza",
                                                "RagioneSociale","DescrizioneMateriale","UnitaMisura",
                                                "Agente","PercentualeDefaultAgente","ProvvigioneAgente","TipoPagamento",
                                                "IdAgente","IdTipoPagamento","IdMandatario",
                                                "PrLavLarg","PrLavTotale","DataModifica","Anno","Mese",
                                                "Utente","DataInserimento","Spessore","Larghezza",
                                                "Provvigione","PrLavSpess","IsDeleted","Fatturata", "DataFatturazione"
                                                };

                            if (skip.Contains(prop.Name)) continue;

                            bool isDecimal = prop.PropertyType == typeof(decimal) || prop.PropertyType == typeof(decimal?);
                            string inputType = isDecimal ? "number" :
                            (prop.PropertyType == typeof(int?) || prop.PropertyType == typeof(int)) ? "number" :
                            (prop.PropertyType == typeof(DateTime?) || prop.PropertyType == typeof(DateTime)) ? "date" : "text";

                            @* step="any" per tutti i decimal tecnici Cobral (massima precisione) *@
                            string stepAttr = isDecimal ? "step=any" : "";

                            var rawValue = prop.GetValue(Model);
                            string formattedValue;

                            if (isDecimal)
                            {
                                formattedValue = FormatDecimal(rawValue); //formattedValue = FormatDecimal(rawValue, 3);
                            }
                            else if (inputType == "date" && rawValue is DateTime dt)
                            {
                                formattedValue = dt.ToString("yyyy-MM-dd");
                            }
                            else
                            {
                                formattedValue = rawValue?.ToString() ?? "";
                            }

                            <div class="col-md-4">
                                <label class="form-label fw-bold">@prop.Name</label>
                                <input class="form-control"
                                       name="@prop.Name"
                                       id="@prop.Name"
                                       type="@inputType"
                                       @stepAttr
                                       value="@formattedValue" />
                            </div>
                        }
                    </div>
                </div>
            </div>

            <hr />

            <div class="d-flex justify-content-between mt-3">
                <a href="/Admin/ProspettiCobral/ListaOrdini" class="btn btn-secondary">Torna alla lista</a>
                <button type="submit" class="btn btn-primary">Salva modifiche</button>
            </div>

        </form>
    </div>
</div>
@* C:\Lavoro\Calkos\Calkos.web\Areas\Admin\Views\ProspettiCobral\DettaglioOrdine.cshtml *@

@* /**
 * ============================================================
 * PROMEMORIA PERCENTUALI — STANDARD COBRAL (CASO PROVVIGIONE)
 * ============================================================
 *
 * PROVVIGIONE 
 *
 * Formato utilizzato in COBRAL:
 *
 *   - Excel mostra:        0.07
 *   - DB salva:            0.07
 *   - Hidden contiene:     0.07
 *   - Display mostra:      0.07
 *   - Calcoli usano:       0.07 (nessuna divisione per 100)
 *
 * Significato:
 *   0.07 = 7%
 *
 * ATTENZIONE:
 *   Questo modulo NON usa il formato “50 → 50%”.
 *   Le percentuali sono già in formato decimale.
 *
 *   Usare SEMPRE il valore così com’è:
 *       prov = safeField("#Provvigione");   // es. 0.07
 *       valore = prov * Quantita;           // corretto
 *
 *   NON dividere per 100.
 *   NON moltiplicare per 100.
 *
 * ============================================================
 */ *@

@*LOGICA DI COBRAL 13/05/2026*@
@section Scripts {
    <script>
        $(document).ready(function () {

                  /**
                   * ============================================================
                   * CENTRALIZZAZIONE ANTIFORGERY
                   * Aggiunge automaticamente il token CSRF a tutte le chiamate
                   * AJAX jQuery, evitando di doverlo passare manualmente ogni volta.
                   * ============================================================
                   */
                  $.ajaxSetup({
                      headers: {
                          "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                      }
                  });

                  /**
                   * ============================================================
                   * CONFIGURAZIONE DECIMALI CENTRALIZZATA
                   * Cambia qui e aggiorni tutta la logica JS.
                   * Deve essere allineata con le costanti C# in cima alla view:
                   *   DECIMALI_TECNICI  → usati nei campi hidden (inviati al server)
                   *   DECIMALI_DISPLAY  → usati nei campi visibili all'utente
                   * ============================================================
                   */
                  const DECIMALI_TECNICI = 4;
                  const DECIMALI_DISPLAY = 4;

                  // 13/05/2026 — MODIFICA: aggiunto Number.EPSILON prima di toFixed.
                  // Problema: V8 (Chrome/Edge) rappresenta alcune moltiplicazioni decimali
                  // con errore IEEE 754. Esempio: 14.85*0.015 = 0.22274999999999998
                  // (appena sotto 0.22275), quindi toFixed(4) arrotonda a 0.2227 invece di 0.2228.
                  // Excel e C# Decimal usano aritmetica a precisione fissa e producono 0.2228.
                  // I valori nel DB sono stati calcolati da C# con MidpointRounding.AwayFromZero
                  // (equivalente all'half-up di Excel), quindi JS deve replicare lo stesso risultato.
                  // Number.EPSILON = 2.22e-16 compensa l'errore di rappresentazione IEEE 754
                  // senza alcun impatto sui valori già esatti (es. 1.22 + 2.22e-16 ≈ 1.22).
                  // Verificato in console browser:
                  //   (0.22274999999999998).toFixed(4)                  → "0.2227" ✗
                  //   (0.22274999999999998 + Number.EPSILON).toFixed(4) → "0.2228" ✓
                  // Stessa modifica applicata su DettaglioOrdine.cshtml di ElektraWire.
                  function roundTec(v) {
                      return Number((toNum(v) + Number.EPSILON).toFixed(DECIMALI_TECNICI));
                  }

                  function roundDisplay(v) {
                      return Number((toNum(v) + Number.EPSILON).toFixed(DECIMALI_DISPLAY));
                  }

                  /**
                   * ============================================================
                   * HELPER NUMERICI
                   * ============================================================
                   */

                  /**
                   * toNum — conversione grezza stringa → numero.
                   * Gestisce: null, undefined, stringa vuota, virgola decimale.
                   * Restituisce sempre 0 in caso di fallimento (mai NaN).
                   */
                  function toNum(v) {
                      if (v === null || v === undefined) return 0;
                      if (typeof v === "string") {
                          v = v.replace(',', '.').trim();
                          if (v === "") return 0;
                      }
                      const n = parseFloat(v);
                      return isNaN(n) ? 0 : n;
                  }

                  /**
                   * safeNum — bonifica un valore già letto (variabile JS o $(this).val()).
                   * Usa: safeNum($(this).val())  oppure  safeNum(miaVariabile)
                   * Accetta un fallback opzionale (default: 0).
                   */
                  function safeNum(v, fallback) {
                      if (fallback === undefined) fallback = 0;
                      if (v === null || v === undefined) return fallback;
                      if (typeof v === "string") {
                          v = v.replace(',', '.').trim();
                          if (v === "") return fallback;
                      }
                      const n = parseFloat(v);
                      if (isNaN(n) || !isFinite(n)) return fallback;
                      return n;
                  }

                  /**
                   * safeField — legge un campo jQuery dal DOM e lo bonifica.
                   * Usa: safeField("#MioCampo")  invece di  toNum($("#MioCampo").val())
                   * Emette un warning in console se il selettore non trova nulla.
                   */
                  function safeField(selector, fallback) {
                      if (fallback === undefined) fallback = 0;
                      const el = $(selector);
                      if (el.length === 0) {
                          console.warn("safeField: campo non trovato →", selector);
                          return fallback;
                      }
                      return safeNum(el.val(), fallback);
                  }

                  /**
                   * ============================================================
                   * REGOLA DI SCELTA TRA safeNum e safeField
                   * ============================================================
                   *
                   *  safeField("#MioCampo")       → quando leggi direttamente dal DOM
                   *  safeNum($(this).val())       → quando hai già il valore in una variabile
                   *  safeNum(miaVariabile)        → stessa cosa
                   *
                   *  Mnemonica: vedi il cancelletto "#"? → safeField.
                   *             Hai già il valore? → safeNum.
                   */

                  /**
                   * ============================================================
                   * VARIABILI DI STATO LUCCHETTI
                   * true  = calcolo automatico attivo (lucchetto chiuso, verde)
                   * false = valore forzato manualmente (lucchetto aperto, rosso)
                   *
                   * I lock per PrLavSpess, PrLavLarg, PrLavTotale vengono
                   * inizializzati a true e poi corretti da rilevaDivergenze()
                   * dopo il caricamento dei dati dal DOM.
                   * ============================================================
                   */
                  let lockValoreCommissioni = true;
                  let lockDifferenza        = true;
                  let lockPrLavSpess        = true;
                  let lockPrLavLarg         = true;
                  let lockPrLavTotale       = true;
                  let lockProvAgente        = true;

                  /**
                   * ============================================================
                   * FUNZIONI DI CALCOLO PURE (senza side-effect)
                   * Queste funzioni SOLO calcolano e restituiscono il valore.
                   * Non scrivono nulla nel DOM. Servono a due scopi:
                   *   1. Essere chiamate da rilevaDivergenze() al caricamento
                   *      per capire se un campo è stato forzato nel DB.
                   *   2. Essere chiamate dalle funzioni "ricalcola*" che invece
                   *      scrivono nel DOM.
                   * ============================================================
                   */

                  function calcolaPrLavSpessValore() {
                      return roundTec(
                          safeField("#AlluminioSpessore") +
                          safeField("#OttoneSpessore")    +
                          safeField("#RameSpessore")      +
                          safeField("#AltrePercentuali")
                      );
                  }

                  function calcolaPrLavLargValore() {
                      return roundTec(
                          safeField("#AlluminioLarghezza") +
                          safeField("#OttoneLarghezza")    +
                          safeField("#RameLarghezza")      +
                          safeField("#BronzoLarghezza")
                      );
                  }

                  function calcolaPrLavTotaleValore() {
                      return roundTec(
                          safeField("#PrLavSpess")          +
                          safeField("#PrLavLarg")            +
                          safeField("#ExtraPrezzoKg")        +
                          safeField("#ExtraPrezzoStagnato")
                      );
                  }

                  function calcolaValoreCommissioniValore() {
                      return roundTec(
                          safeField("#Provvigione") * safeField("#Quantita")
                      );
                  }

                  function calcolaDifferenzaValore() {
                      return roundTec(
                          safeField("#PrezzoVendita") -
                          safeField("#PrLavTotale")   -
                          safeField("#Prezzo")
                      );
                  }

                  /**
                   * ============================================================
                   * FUNZIONI DI RICALCOLO (con side-effect: scrivono nel DOM)
                   * Ogni funzione:
                   *   1. Controlla se il lucchetto è chiuso (lock = true).
                   *      Se aperto, non fa nulla (il valore è stato forzato).
                   *   2. Usa la corrispondente funzione "pura" per calcolare.
                   *   3. Aggiorna Display (visibile) e Hidden (inviato al server).
                   * ============================================================
                   */

                  // ValoreCommissioni = Provvigione × Quantita
                  function ricalcolaValoreCommissioni() {
                      if (!lockValoreCommissioni) return;

                      const valoreTec = calcolaValoreCommissioniValore();
                      const valoreVis = roundDisplay(valoreTec);

                      log("Calcolo ValoreCommissioni: [Prov](" + safeField("#Provvigione") +
                          ") * [Qta](" + safeField("#Quantita") + ") = " + valoreTec);

                      $("#ValoreCommissioniDisplay").val(valoreVis);
                      $("#ValoreCommissioni").val(valoreTec);
                  }

                  // Differenza = PrezzoVendita - PrLavTotale - Prezzo
                  function ricalcolaDifferenza() {
                      if (!lockDifferenza) return;

                      const valoreTec = calcolaDifferenzaValore();
                      const valoreVis = roundDisplay(valoreTec);

                      log("Calcolo Differenza: [PrezzoVendita](" + safeField("#PrezzoVendita") +
                          ") - [PrLavTotale](" + safeField("#PrLavTotale") +
                          ") - [Prezzo](" + safeField("#Prezzo") + ") = " + valoreTec);

                      $("#DifferenzaDisplay").val(valoreVis);
                      $("#Differenza").val(valoreTec);
                  }

                  // PrLavSpess = AlluminioSpessore + OttoneSpessore + RameSpessore + AltrePercentuali
                  function ricalcolaPrLavSpess() {
                      if (!lockPrLavSpess) return;

                      const a = safeField("#AlluminioSpessore");
                      const o = safeField("#OttoneSpessore");
                      const r = safeField("#RameSpessore");
                      const x = safeField("#AltrePercentuali");

                      const valoreTec = roundTec(a + o + r + x);
                      const valoreVis = roundDisplay(valoreTec);

                      log("Calcolo PrLavSpess: [Alu](" + a + ") + [Ott](" + o +
                          ") + [Ram](" + r + ") + [Altre](" + x + ") = " + valoreTec);

                      $("#PrLavSpessDisplay").val(valoreVis);
                      $("#PrLavSpess").val(valoreTec);

                      // PrLavTotale dipende da PrLavSpess → ricalcola a cascata
                      ricalcolaPrLavTotale();
                  }

                  // PrLavLarg = AlluminioLarghezza + OttoneLarghezza + RameLarghezza + BronzoLarghezza
                  function ricalcolaPrLavLarg() {
                      if (!lockPrLavLarg) return;

                      const a = safeField("#AlluminioLarghezza");
                      const o = safeField("#OttoneLarghezza");
                      const r = safeField("#RameLarghezza");
                      const b = safeField("#BronzoLarghezza");

                      const valoreTec = roundTec(a + o + r + b);
                      const valoreVis = roundDisplay(valoreTec);

                      log("Calcolo PrLavLarg: [Alu](" + a + ") + [Ott](" + o +
                          ") + [Ram](" + r + ") + [Bro](" + b + ") = " + valoreTec);

                      $("#PrLavLargDisplay").val(valoreVis);
                      $("#PrLavLarg").val(valoreTec);

                      // PrLavTotale dipende da PrLavLarg → ricalcola a cascata
                      ricalcolaPrLavTotale();
                  }

                  // PrLavTotale = PrLavSpess + PrLavLarg + ExtraPrezzoKg + ExtraPrezzoStagnato
                  function ricalcolaPrLavTotale() {
                      if (!lockPrLavTotale) return;

                      const sp   = safeField("#PrLavSpess");
                      const lg   = safeField("#PrLavLarg");
                      const exKg = safeField("#ExtraPrezzoKg");
                      const exSt = safeField("#ExtraPrezzoStagnato");

                      const valoreTec = roundTec(sp + lg + exKg + exSt);
                      const valoreVis = roundDisplay(valoreTec);

                      log("Calcolo PrLavTotale: [Spess](" + sp + ") + [Larg](" + lg +
                          ") + [ExtraKg](" + exKg + ") + [ExtraStagnato](" + exSt + ") = " + valoreTec);

                      $("#PrLavTotaleDisplay").val(valoreVis);
                      $("#PrLavTotale").val(valoreTec);

                      // Differenza dipende da PrLavTotale → ricalcola a cascata
                      ricalcolaDifferenza();
                  }

                  /**
                   * ============================================================
                   * ricalcolaTutto — punto di ingresso principale
                   * Chiamato da tutti gli event listener sui campi di input.
                   * Esegue i calcoli nell'ordine corretto di dipendenza:
                   *   1. ValoreCommissioni  (dipende da Provvigione, Quantita)
                   *   2. PrLavSpess         (dipende dai componenti spessore)
                   *      └─ PrLavTotale     (chiamato in cascata da PrLavSpess)
                   *         └─ Differenza   (chiamata in cascata da PrLavTotale)
                   *   3. PrLavLarg          (dipende dai componenti larghezza)
                   *      └─ PrLavTotale     (chiamato in cascata da PrLavLarg)
                   *         └─ Differenza   (chiamata in cascata da PrLavTotale)
                   *   4. PrLavTotale        (chiamata esplicita finale per sicurezza)
                   *      └─ Differenza      (chiamata in cascata)
                   *
                   * NOTA: i campi con lucchetto aperto (lock = false) vengono
                   * ignorati automaticamente dalla loro funzione ricalcola*.
                   * ============================================================
                   */
                  function ricalcolaTutto() {
                      log("--- ricalcolaTutto START ---");
                      log("Quantita:", safeField("#Quantita"));
                      log("Provvigione:", safeField("#Provvigione"));
                      log("PrezzoVendita:", safeField("#PrezzoVendita"));
                      log("Prezzo:", safeField("#Prezzo"));
                      log("PrLavSpess:", safeField("#PrLavSpess"));
                      log("PrLavLarg:", safeField("#PrLavLarg"));
                      log("PrLavTotale:", safeField("#PrLavTotale"));
                      log("ExtraPrezzoKg:", safeField("#ExtraPrezzoKg"));
                      log("ExtraPrezzoStagnato:", safeField("#ExtraPrezzoStagnato"));
                      log("IdAgente:", safeField("#IdAgente"));
                      log("IdCliente:", safeField("#IdCliente"));

                      ricalcolaValoreCommissioni();
                      log("ValoreCommissioni dopo:", $("#ValoreCommissioni").val());

                      ricalcolaPrLavSpess();
                      log("PrLavSpess dopo:", $("#PrLavSpess").val());

                      ricalcolaPrLavLarg();
                      log("PrLavLarg dopo:", $("#PrLavLarg").val());

                      ricalcolaPrLavTotale();
                      log("PrLavTotale dopo:", $("#PrLavTotale").val());

                      ricalcolaDifferenza();
                      log("Differenza dopo:", $("#Differenza").val());

                      log("--- ricalcolaTutto END ---");
                  }

                  /**
                   * ============================================================
                   * PROVVIGIONE AGENTE (AJAX)
                   * Recupera la percentuale di provvigione dell'agente per il
                   * cliente selezionato. Chiamata al cambio di IdAgente o IdCliente.
                   * Non fa nulla se il lucchetto è aperto (valore forzato).
                   * ============================================================
                   */
                  function ricalcolaProvvigioneAgente() {
                      if (!lockProvAgente) return;

                      const idAgente  = $("#IdAgente").val();
                      const idCliente = $("#IdCliente").val();

                      if (!idAgente || !idCliente) {
                          log("Salto ricalcolaProvvigioneAgente: IdAgente o IdCliente mancante.");
                          return;
                      }

                      log("Chiamata AJAX ProvvigioneAgente: idAgente=" + idAgente + ", idCliente=" + idCliente);

                      $.getJSON(
                          '/Admin/ProspettiCobral/GetPercentualeProvvigione',
                          { idAgente: idAgente, idCliente: idCliente },
                          function (percentuale) {
                              const valTec = roundTec(safeNum(percentuale));
                              const valVis = roundDisplay(valTec);

                              log("Risultato AJAX ProvvigioneAgente: Percentuale ricevuta=" +
                                  percentuale + " → Formattata=" + valTec);

                              $("#ProvvigioneAgenteDisplay").val(valVis);
                              $("#ProvvigioneAgente").val(valTec);
                          }
                      ).fail(function (jqXHR, textStatus, error) {
                          log("ERRORE AJAX ricalcolaProvvigioneAgente:", textStatus, error);
                      });
                  }

                  /**
                   * ============================================================
                   * GESTIONE LUCCHETTI — aggiornaUILucchetto
                   * Funzione condivisa che aggiorna l'aspetto visivo del pulsante
                   * e lo stato readonly del campo Display associato.
                   *
                   * isLocked = true  → campo readonly, pulsante verde con lucchetto chiuso
                   * isLocked = false → campo editabile, pulsante rosso con lucchetto aperto
                   *
                   * Usata sia da setupToggle (click utente) sia da rilevaDivergenze
                   * (inizializzazione automatica al caricamento pagina).
                   * ============================================================
                   */
                  function aggiornaUILucchetto(idBtn, idInputDisplay, isLocked) {
                      const $input = $(idInputDisplay);
                      const $btn   = $(idBtn);

                      if (isLocked) {
                          $input.prop("readonly", true).addClass("input-readonly");
                          $btn.removeClass("btn-danger").addClass("btn-success")
                              .html('<i class="bi bi-lock-fill"></i>');
                      } else {
                          $input.prop("readonly", false).removeClass("input-readonly");
                          $btn.removeClass("btn-success").addClass("btn-danger")
                              .html('<i class="bi bi-unlock-fill"></i>');
                      }
                  }

                  /**
                   * ============================================================
                   * GESTIONE LUCCHETTI — setupToggle
                   * Registra il click sul pulsante lucchetto per un campo calcolato.
                   * Al click:
                   *   - se si chiude il lucchetto (lock → true): il valore corrente
                   *     del Display viene scritto nell'Hidden, poi UI aggiornata.
                   *   - se si apre il lucchetto (lock → false): il campo diventa
                   *     editabile; il valore NON viene resettato a quello originale.
                   *
                   * Parametri:
                   *   idBtn          → selettore jQuery del pulsante (#toggleXxx)
                   *   idInputDisplay → selettore jQuery del campo Display (#XxxDisplay)
                   *   type           → stringa che identifica quale variabile lock gestire
                   * ============================================================
                   */
                  function setupToggle(idBtn, idInputDisplay, type) {
                      $(idBtn).on("click", function () {

                          // 1. Inverti lo stato del lock corretto
                          let isLocked;
                          switch (type) {
                              case 'spess': lockPrLavSpess        = !lockPrLavSpess;        isLocked = lockPrLavSpess;        break;
                              case 'larg':  lockPrLavLarg          = !lockPrLavLarg;          isLocked = lockPrLavLarg;          break;
                              case 'tot':   lockPrLavTotale         = !lockPrLavTotale;         isLocked = lockPrLavTotale;         break;
                              case 'comm':  lockValoreCommissioni   = !lockValoreCommissioni;   isLocked = lockValoreCommissioni;   break;
                              case 'diff':  lockDifferenza           = !lockDifferenza;           isLocked = lockDifferenza;           break;
                              case 'agente':lockProvAgente           = !lockProvAgente;           isLocked = lockProvAgente;           break;
                          }

                          // 2. Se si chiude il lucchetto, sincronizza l'hidden col valore
                          //    attuale del Display (preserva eventuali modifiche manuali).
                          if (isLocked) {
                              const hiddenId = idInputDisplay.replace("#", "").replace("Display", "");
                              $("#" + hiddenId).val(roundTec(safeNum($(idInputDisplay).val())));
                          }

                          // 3. Aggiorna aspetto visivo
                          aggiornaUILucchetto(idBtn, idInputDisplay, isLocked);
                      });
                  }

                  // Registra tutti i lucchetti
                  setupToggle("#togglePrLavSpess",          "#PrLavSpessDisplay",          'spess');
                  setupToggle("#togglePrLavLarg",            "#PrLavLargDisplay",            'larg');
                  setupToggle("#togglePrLavTotale",          "#PrLavTotaleDisplay",          'tot');
                  setupToggle("#toggleValoreCommissioni",    "#ValoreCommissioniDisplay",    'comm');
                  setupToggle("#toggleDifferenza",           "#DifferenzaDisplay",           'diff');
                  setupToggle("#toggleProvAgente",           "#ProvvigioneAgenteDisplay",    'agente');

                  /**
                   * ============================================================
                   * rilevaDivergenze — inizializzazione automatica lucchetti
                   * ============================================================
                   * Problema: un campo calcolato può essere stato forzato
                   * manualmente nel DB (es. PrLavSpess = 1.65 mentre la somma
                   * dei componenti vale 1.40). In quel caso, al primo ricalcolo
                   * il valore forzato verrebbe sovrascritto silenziosamente.
                   *
                   * Soluzione: al caricamento pagina, confronta il valore salvato
                   * nel DB (campo Hidden) con il valore che risulterebbe dal calcolo
                   * automatico. Se differiscono oltre una soglia (0.0001), apre
                   * automaticamente il lucchetto per proteggere il valore forzato.
                   *
                   * Deve essere chiamata DOPO caricaDimensioni() perché i campi
                   * "Altri Campi" (AlluminioSpessore ecc.) devono essere nel DOM
                   * e valorizzati prima del confronto.
                   *
                   * ATTENZIONE: viene chiamata dentro la callback AJAX di
                   * caricaDimensioni, così è garantito che i dati siano pronti.
                   * ============================================================
                   */
         function rilevaDivergenze() {
            const SOGLIA = 0.001;

            // 13/05/2026 — MODIFICA: rimossa la logica con toFixed(3) sugli operandi
            // che arrotondava PRIMA della sottrazione generando falsi negativi.
            // Soluzione: confronto sulla differenza GREZZA tra valoreDB e valoreCalc.
            // La soglia 0.001 assorbe solo floating-point noise (< 0.0001),
            // non divergenze reali del dominio (≥ 0.01).
            function controlla(idHidden, idBtn, idDisplay, fnCalcola, setLock) {
                const valoreDB   = safeField(idHidden);
                const valoreCalc = fnCalcola();
                const diff       = Math.abs(valoreDB - valoreCalc);

                if (diff > SOGLIA) {
                    log("⚠ Valore forzato rilevato per", idHidden,
                        "| DB =", valoreDB,
                        "| Calcolato =", valoreCalc,
                        "| Diff =", diff,
                        "→ lucchetto aperto automaticamente");
                    setLock(false);
                    aggiornaUILucchetto(idBtn, idDisplay, false);
                }
            }

            controlla(
                "#PrLavSpess", "#togglePrLavSpess", "#PrLavSpessDisplay",
                calcolaPrLavSpessValore,
                (v) => { lockPrLavSpess = v; }
            );

            controlla(
                "#PrLavLarg", "#togglePrLavLarg", "#PrLavLargDisplay",
                calcolaPrLavLargValore,
                (v) => { lockPrLavLarg = v; }
            );

            /**
             * PrLavTotale: il confronto usa i valori già eventualmente
             * corretti da PrLavSpess e PrLavLarg qui sopra, perché
             * calcolaPrLavTotaleValore() legge #PrLavSpess e #PrLavLarg
             * dal DOM (che rispecchiano ancora il valore DB a questo punto).
             */
            controlla(
                "#PrLavTotale", "#togglePrLavTotale", "#PrLavTotaleDisplay",
                calcolaPrLavTotaleValore,
                (v) => { lockPrLavTotale = v; }
            );

            // 13/05/2026 — AGGIUNTA: controllo ValoreCommissioni e Differenza.
            // Problema: rilevaDivergenze non controllava questi due campi, quindi
            // lockValoreCommissioni e lockDifferenza rimanevano sempre true anche
            // quando il valore nel DB era stato forzato manualmente.
            // Conseguenza: ricalcolaTutto() sovrascriveva il valore forzato
            // (es. ValoreCommissioni=145 veniva riscritto a 140.42).
            // Fix: aggiungere i controlla per entrambi i campi, usando le stesse
            // funzioni pure già esistenti calcolaValoreCommissioniValore() e
            // calcolaDifferenzaValore().
            controlla(
                "#ValoreCommissioni", "#toggleValoreCommissioni", "#ValoreCommissioniDisplay",
                calcolaValoreCommissioniValore,
                (v) => { lockValoreCommissioni = v; }
            );

            controlla(
                "#Differenza", "#toggleDifferenza", "#DifferenzaDisplay",
                calcolaDifferenzaValore,
                (v) => { lockDifferenza = v; }
            );
        }

                  /**
                   * ============================================================
                   * EVENT LISTENERS — campi principali
                   * ============================================================
                   * Triggera ricalcolaTutto() su ogni modifica.
                   * NON includere #PrLavSpess, #PrLavLarg, #PrLavTotale perché
                   * sono campi calcolati: ascoltarli creerebbe loop di aggiornamento.
                   * ============================================================
                   */
                  $("#Quantita, #Provvigione, #Prezzo, #PrezzoVendita, #ExtraPrezzoKg, #ExtraPrezzoStagnato, " +
                    "#AlluminioSpessore, #OttoneSpessore, #RameSpessore, #AltrePercentuali, " +
                    "#AlluminioLarghezza, #OttoneLarghezza, #RameLarghezza, #BronzoLarghezza")
                      .on("input change", ricalcolaTutto);

                  // Agente / Cliente → provvigione agente via AJAX
                  $("#IdAgente, #IdCliente").on("change", ricalcolaProvvigioneAgente);

                  /**
                   * ============================================================
                   * EVENT LISTENERS — modifica manuale Display (lucchetto aperto)
                   * Quando il lucchetto è aperto, l'utente può digitare direttamente
                   * nel campo Display. Questi listener sincronizzano il campo Hidden
                   * (quello che va in POST) e, dove necessario, propagano a cascata.
                   * ============================================================
                   */
                  $("#ValoreCommissioniDisplay").on("input", function () {
                      $("#ValoreCommissioni").val(roundTec(safeNum($(this).val())));
                  });

                  $("#DifferenzaDisplay").on("input", function () {
                      $("#Differenza").val(roundTec(safeNum($(this).val())));
                  });

                  // PrLavSpessDisplay → aggiorna hidden e propaga a PrLavTotale → Differenza
                  $("#PrLavSpessDisplay").on("input", function () {
                      $("#PrLavSpess").val(roundTec(safeNum($(this).val())));
                      ricalcolaPrLavTotale();
                  });

                  // PrLavLargDisplay → aggiorna hidden e propaga a PrLavTotale → Differenza
                  $("#PrLavLargDisplay").on("input", function () {
                      $("#PrLavLarg").val(roundTec(safeNum($(this).val())));
                      ricalcolaPrLavTotale();
                  });

                  // PrLavTotaleDisplay → aggiorna hidden e propaga a Differenza
                  $("#PrLavTotaleDisplay").on("input", function () {
                      $("#PrLavTotale").val(roundTec(safeNum($(this).val())));
                      ricalcolaDifferenza();
                  });

                  $("#ProvvigioneAgenteDisplay").on("input", function () {
                      $("#ProvvigioneAgente").val(roundTec(safeNum($(this).val())));
                  });

                  /**
                   * ============================================================
                   * SINCRONIZZAZIONE DISPLAY → HIDDEN (generica — tutti gli altri)
                   * Cattura tutti i campi Display non già gestiti sopra.
                   * Pattern: XxxDisplay → hidden con id "Xxx" (senza "Display").
                   * ============================================================
                   */
                  $("input[id$='Display']")
                      .not("#ValoreCommissioniDisplay, #DifferenzaDisplay, " +
                           "#PrLavSpessDisplay, #PrLavLargDisplay, " +
                           "#PrLavTotaleDisplay, #ProvvigioneAgenteDisplay")
                      .on("input", function () {
                          const hiddenId = $(this).attr("id").replace("Display", "");
                          $("#" + hiddenId).val(roundTec(safeNum($(this).val())));
                      });

                  /**
                   * ============================================================
                   * AJAX — CARICAMENTO DIMENSIONI MATERIALE
                   * Popola le select Spessore e Larghezza in base al materiale.
                   * Al completamento chiama rilevaDivergenze() per inizializzare
                   * correttamente i lucchetti DOPO che i campi "Altri Campi"
                   * (AlluminioSpessore ecc.) sono nel DOM e valorizzati.
                   * ============================================================
                   */
                  function caricaDimensioni(idMateriale, spessoreSel, larghezzaSel) {
                      if (!idMateriale) return;

                      $.getJSON(
                          '/Admin/ProspettiCobral/GetDimensioniMateriale',
                          { idMateriale: idMateriale },
                          function (data) {
                              const listaSpessori  = data.spessori  || data.Spessori  || [];
                              const listaLarghezze = data.larghezze || data.Larghezze || [];

                              /**
                               * normalize — normalizza un valore dimensione per il confronto.
                               * Rimuove "mm", gestisce i range "15,1 - 30" (prende il primo),
                               * converte virgola in punto.
                               */
                              function normalize(val) {
                                  if (!val) return "";
                                  let v = val.toString().trim().replace("mm", "").trim();
                                  if (v.includes("-")) v = v.split("-")[0].trim();
                                  return v.replace(",", ".");
                              }

                              // Popola select Spessore
                              const $spess       = $("#Spessore");
                              const cleanSelSpess = normalize(spessoreSel);
                              $spess.empty().append('<option value="">-- seleziona --</option>');

                              $.each(listaSpessori, function (i, v) {
                                  const sel = (normalize(v) === cleanSelSpess) ? "selected='selected'" : "";
                                  $spess.append("<option value='" + v + "' " + sel + ">" + v + "</option>");
                              });

                              // Popola select Larghezza
                              const $larg        = $("#Larghezza");
                              const cleanSelLarg  = normalize(larghezzaSel);
                              $larg.empty().append('<option value="">-- seleziona --</option>');

                              $.each(listaLarghezze, function (i, v) {
                                  const sel = (normalize(v) === cleanSelLarg) ? "selected='selected'" : "";
                                  $larg.append("<option value='" + v + "' " + sel + ">" + v + "</option>");
                              });

                              /**
                               * IMPORTANTE: rilevaDivergenze() viene chiamata QUI, dentro la
                               * callback AJAX, e non fuori. Questo garantisce che i campi
                               * "Altri Campi" (AlluminioSpessore, OttoneSpessore ecc.) siano
                               * già presenti e valorizzati nel DOM prima del confronto.
                               * Chiamarla fuori (in modo sincrono subito dopo caricaDimensioni)
                               * potrebbe farla girare prima che l'AJAX sia completato.
                               */
                              rilevaDivergenze();

                              /**
                               * Ricalcolo iniziale dopo che i lucchetti sono stati
                               * impostati correttamente da rilevaDivergenze().
                               * I campi con lucchetto aperto non verranno toccati.
                               */
                              ricalcolaTutto();
                          }
                      );
                  }

                  /**
                   * ============================================================
                   * INIZIALIZZAZIONE
                   * ============================================================
                   */

                  // Leggi i valori salvati nel DB dagli hidden di servizio
                  const idMateriale  = safeField("#IdMateriale");
                  const spessoreSel  = $("#SpessoreSelezionato").val();
                  const larghezzaSel = $("#LarghezzaSelezionata").val();

                  // Avvia il caricamento delle dimensioni (e dentro: rilevaDivergenze + ricalcolaTutto)
                  caricaDimensioni(idMateriale, spessoreSel, larghezzaSel);

                  /**
                   * Provvigione agente: carica via AJAX solo se il valore salvato
                   * nel DB è zero (record nuovo o non ancora valorizzato).
                   * Se c'è già un valore, viene rispettato senza sovrascrittura.
                   */
                  if ($("#IdAgente").val() && $("#IdCliente").val()) {
                      const valAttuale = safeField("#ProvvigioneAgente");
                      if (valAttuale === 0) ricalcolaProvvigioneAgente();
                  }

              }); // fine document.ready
    </script>
}
