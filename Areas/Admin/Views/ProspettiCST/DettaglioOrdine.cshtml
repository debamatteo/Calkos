                    <input type="hidden" id="TotaleProvvigioneVariabile" name="TotaleProvvigioneVariabile" value="@FTecnico(Model.TotaleProvvigioneVariabile, 6)" />
                </div>


                @* P	Totale fattura	--TotaleProvvigioneFattura	 *@
                @* 
                    Colonna	P	Totale fattura
                    Campo Db = TotaleProvvigioneFattura
                    FORMULA =O+L
                    FORMULA =[Totale provv variabile]+[Totale Fisso]
                    FORMULA DB =TotaleProvvigioneVariabile+TotaleProvvigioneFissa
                    O	[Totale provv variabile]	Campo Db = TotaleProvvigioneVariabile
                    L	[Totale Fisso]	Campo Db =TotaleProvvigioneFissa
                    *@
                <div class="col-md-2">
                    <label class="form-label fw-bold">Totale Fattura</label>
                    <div class="input-group">
                        <input type="number"
                               step="any"
