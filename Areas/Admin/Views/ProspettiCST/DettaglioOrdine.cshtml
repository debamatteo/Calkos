                    @*<div style="color:red; font-weight:bold;">
                        DEBUG VIEW: @Model.Perc_Delta_Provvigione
                    </div> *@
                </div>





                @* O	Totale provv variabile	----TotaleProvvigioneVariabile	 *@
                @*                     
                        Colonna(O)	Totale provv variabile
                        Campo Db = TotaleProvvigioneVariabile
                        FORMULA =N*C*50% 
                        FORMULA =Delta*Kg*Perc_Delta_Provvigione 
                        FORMULA DB =Delta*Quantita*Perc_Delta_Provvigione

                        50%=Perc_Delta_Provvigione
                        N	Delta 	 Campo Db = Delta
                        C	Kg	Campo Db =Quantita

                    // CONVENZIONE: Perc_Delta_Provvigione è sempre salvata in percentuale intera
                    // Es: 50 = 50%  →  nel calcolo si divide sempre per 100
                    // Questa convenzione vale per DB, hidden, display e controller.


                    *@
                <div class="col-md-2">
                    <label class="form-label fw-bold">Totale Provv. Variabile</label>
                    <div class="input-group">
                        <input type="number"
                               step="any"
