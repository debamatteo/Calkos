                    }
                    <span asp-validation-for="CIT" class="text-danger small"></span>
                </div>


                @*N Delta	-	Delta	 *@
                @* Colonna(N)	Delta  Campo Db = Delta
                FORMULA =I-H
                FORMULA =Vendita-[Materiale+Lav con commissione]
                FORMULA =PrezzoVendita-PrezzoBaseConLavorazione
                H	[Materiale+Lav con commissione]   	 Campo Db = PrezzoBaseConLavorazione
                I	Vendita   	 Campo Db = PrezzoVendita *@
