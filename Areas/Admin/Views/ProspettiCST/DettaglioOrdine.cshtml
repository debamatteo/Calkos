                        <button type="button" id="toggleTotaleProvvigioneFattura" class="btn btn-success">
                            <i class="bi bi-lock-fill"></i>
                        </button>
                    </div>
                    <input type="hidden" id="TotaleProvvigioneFattura" name="TotaleProvvigioneFattura" value="@FTecnico(Model.TotaleProvvigioneFattura, 6)" />
                </div>


            </div>



            @* ============================================================
               SEZIONE: AGENTE E PAGAMENTO,DATE 
               ============================================================ *@
            <h5 class="fw-bold mt-4">Agente e Pagamento</h5>
            <div class="row g-3">



                @* Data Consegna Ipotetica *@
                <div class="col-md-2">
                    <label class="form-label fw-bold">Data Consegna Ipotetica</label>
