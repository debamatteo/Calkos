                @* K	[3,0% fissa]	ProvvigioneFissa03	11	3,0% fissa *@
                @* Colonna(K)	[3,0% fissa]
                Campo Db = ProvvigioneFissa03
                FORMULA =IF(E="alluminio",(I)*3%,0)+IF(E="alluminio smaltato",(I)*3%,0)
                FORMULA =IF([Tipologia Materiale]="alluminio",(Vendita)*3%,0)+IF([Tipologia Materiale]="alluminio smaltato",(Vendita)*3%,0)
                FORMULA DB =IF(Materiale="alluminio",(Vendita)*3%,0)+IF(Materiale="alluminio smaltato",(Vendita)*3%,0)
                E	[Tipologia Materiale]	—	 Campo DB = Materiale
                I	Vendita	—	 Campo DB = PrezzoVendita
                Sintesi:Se il materiale è alluminio (di qualsiasi tipo specificato),
