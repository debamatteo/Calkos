<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      
      <!-- INIZIO SEZIONE SECURITY UNIFICATA -->
      <security>
        <requestFiltering removeServerHeader="true">
          <!-- Limite dimensione upload (es. 20MB = 20971520 byte) -->
          <requestLimits maxAllowedContentLength="20971520" />
          
          <!-- Blocco accesso a cartelle/file sensibili -->
          <hiddenSegments>
			  <add segment="tempCobral" />
            <add segment="tempCST" />
            <add segment="tempDeAngeli" />
            <add segment="tempElektraWire" />
            <add segment="tempGuerzoni" />
            <add segment="tempHitech" />
            <add segment="tempSystemCore" />
            <add segment="tempSystemP" />
            <add segment="tempTradingAndConsulting" />
			  
          </hiddenSegments>
        </requestFiltering>
      </security>
      <!-- FINE SEZIONE SECURITY UNIFICATA -->

      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>

      <aspNetCore processPath="dotnet" 
                  arguments=".\Calkos.Web.dll" 
                  stdoutLogEnabled="false" 
                  stdoutLogFile=".\logs\stdout" 
                  hostingModel="inprocess" />

      <!-- Rimuove header server per sicurezza -->
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>

    </system.webServer>
  </location>
</configuration>