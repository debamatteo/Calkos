    <script>
        window.showSuccess = function(message) {
            return Swal.fire({
                icon: "success",
                title: "Operazione completata",
                text: message,
                confirmButtonText: "OK"
            });
        };

        window.showError = function(message) {
            return Swal.fire({
                icon: "error",
                title: "Attenzione",
                text: message,
                confirmButtonText: "OK"
            });
        };

        window.showWarning = function(message) {
            return Swal.fire({
                icon: "warning",
                title: "Attenzione",
                text: message,
                confirmButtonText: "OK"
            });
        };

        window.showHtmlMessage = function(title, html, icon = "info") {
            return Swal.fire({
                icon: icon,
                title: title,
                html: html,
                confirmButtonText: "OK"
            });
        };

        window.confirmAction = function(message) {
            return Swal.fire({
                icon: "question",
                title: "Conferma",
                text: message,
                showCancelButton: true,
                confirmButtonText: "Sì, conferma",
                cancelButtonText: "Annulla",
                reverseButtons: true
            });
        };

        window.escapeHtml = function(value) {
            return String(value ?? "")
                .replaceAll("&", "&amp;")
                .replaceAll("<", "&lt;")
                .replaceAll(">", "&gt;")
                .replaceAll('"', "&quot;")
                .replaceAll("'", "&#039;");
        };


