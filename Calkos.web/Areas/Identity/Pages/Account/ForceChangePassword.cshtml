@page
@model ForceChangePasswordModel
@{
    ViewData["Title"] = "Cambia Password";
}

<h3>Cambia la tua password</h3>

<form method="post">
    <div class="mb-3">
        <label asp-for="Input.NewPassword" class="form-label"></label>
        <input asp-for="Input.NewPassword" class="form-control" />
        <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
    </div>

    <!-- ==== MODIFICA 25/08/2026 - INIZIO ==== -->
    <div class="mb-3">
        <label asp-for="Input.ConfermaPassword" class="form-label"></label>
        <input asp-for="Input.ConfermaPassword" class="form-control" />
        <span asp-validation-for="Input.ConfermaPassword" class="text-danger"></span>
    </div>
    <!-- ==== MODIFICA 25/08/2026 - FINE ==== -->
    <div class="alert alert-info mt-2">
        <strong>Requisiti password</strong>
        <ul class="mb-0 mt-2">
            <li>Minimo 12 caratteri</li>
            <li>Almeno una lettera maiuscola</li>
            <li>Almeno una lettera minuscola</li>
            <li>Almeno un numero</li>
        </ul>
    </div>
    <button type="submit" class="btn btn-primary">Conferma nuova password</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}