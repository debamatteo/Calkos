                            </button>
                        </div>
                    }
                    @*  07/08/2026 FINE *@
                    <input type="hidden" id="TotaleProvvigione" name="TotaleProvvigione" value="@FTecnico(Model.TotaleProvvigione, 6)" />
                </div>





            </div>


            @* ============================================================
               SEZIONE: DATE
               ============================================================ *@


            <h5 class="fw-bold mt-4">Date</h5>
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label fw-bold">Data Consegna Prevista</label>
