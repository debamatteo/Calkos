                                @* MODIFICA 12/10/2026: campo booleano (es. InRitardo) -> checkbox/switch modificabile.
                                   Pattern ASP.NET MVC: checkbox value="true" + hidden value="false" con lo stesso name:
                                   se spuntato il binder riceve "true,false" -> true; se non spuntato riceve solo "false".
                                   Per un bool? il valore null viene mostrato come non spuntato (e inviato come false). *@
                                bool boolValue = rawValue is bool bv && bv;
                                <div class="col-md-4">
                                    <label class="form-label fw-bold d-block">@prop.Name</label>
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" role="switch"
                                               name="@prop.Name"
                                               id="@prop.Name"
                                               value="true"
                                               checked="@(boolValue ? "checked" : null)" />
                                        <input type="hidden" name="@prop.Name" value="false" />
                                        <label class="form-check-label" for="@prop.Name">@(boolValue ? "Sì" : "No")</label>
                                    </div>
