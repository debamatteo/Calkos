                            }
                            else
                            {
                                <div class="col-md-4">
                                    <label class="form-label fw-bold">
                                        @prop.Name
                                        @if (isDismesso)
                                        {
                                            @* MODIFICA 12/10/2026: etichetta informativa per i campi dismessi *@
                                            <span class="badge bg-secondary ms-1" title="Campo dismesso: sostituito dai campi SpessoreNum / LarghezzaNum / DiametroNum. Solo consultazione storico.">Dismesso</span>
                                        }
                                    </label>
                                    <input class="form-control @(isDismesso ? "input-readonly" : "")"
                                           name="@prop.Name"
                                           id="@prop.Name"
                                           type="@inputType"
