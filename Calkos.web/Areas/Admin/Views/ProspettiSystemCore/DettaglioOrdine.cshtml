                <div class="collapse" id="tecnici">
                    <div class="row g-3">
                        @foreach (var prop in typeof(CalkosManager.Domain.Entities.ProspettoSystemCore).GetProperties())
                        {
                            @* Lista completa dei campi da escludere dalla sezione "Altri Campi"
                           perché già gestiti nelle sezioni precedenti o non rilevanti per l'utente
                           SE un campo è presente nell Array SKIP NON verrà visualizzato nella sezione Altri Campi
                           
                           *@                     
                           
                           
                                var skip = new[] {
                                                "IdCliente", "IdMateriale", "IdUnitaMisura", "NumeroOrdine", "NumeroDDT", "NumeroFattura", "DataConsegnaIpotetica",
                                                "Quantita", "Kg", "PrezzoVendita", "CostoLavorazione", "PercentualeQuotaFissa", "ValoreQuotaFissa",
                                                "TotaleProvvigioneVariabile", "TotaleProvvigione", "TotaleProvvigioneDaFatturare",
                                                "Delta", "Perc_Delta_Provvigione", "QuotaCentesimiPerKg", "IdAgente", "IdTipoPagamento",
                                                "ProvvigioneAgente", "DataConsegna", "Scadenza", "Fatturare", "IsProcessed", "UniqueKey",
                                                "IdProspettoSystemCore", "IdMandatario", "IdFileImportato", "IdImportSystemCore",
                                                "DataInserimento", "DataModifica", "Utente", "Anno", "Mese",
                                                "Fatturata", "DataFatturazione",
                                                "IsDeleted", "RagioneSociale", "DescrizioneMateriale", "UnitaMisura",
                                                "AgenteDescrizione", "PercentualeDefaultAgente", "TipoPagamento"
                                                ,  "DataConsegna","EscludiControlloRitardo","DaFatturare"   // AGGIUNTA 30/09/2026
                                                };

                            if (skip.Contains(prop.Name)) continue;

                            // MODIFICA 12/10/2026: campi DISMESSI (sostituiti da SpessoreNum/LarghezzaNum/DiametroNum).
                            // Restano visibili in "Altri Campi" per tutti i ruoli, ma NON editabili:
                            // servono solo per consultazione dello storico. Uso readonly (e non disabled)
                            // cosi' il valore viene comunque inviato nel POST e non viene azzerato.
                            bool isDismesso = prop.Name == "Spessore" || prop.Name == "Larghezza";
                            // MODIFICA 12/10/2026: riconoscimento dei campi booleani (bool / bool?),
                            // prima trattati come testo fisso (es. "True") e quindi non modificabili.
                            bool isBool = (Nullable.GetUnderlyingType(prop.PropertyType) ?? prop.PropertyType) == typeof(bool);




                            bool isDecimal = prop.PropertyType == typeof(decimal) || prop.PropertyType == typeof(decimal?);
                            string inputType = isDecimal ? "number" :
                            (prop.PropertyType == typeof(int?) || prop.PropertyType == typeof(int)) ? "number" :
                            (prop.PropertyType == typeof(DateTime?) || prop.PropertyType == typeof(DateTime)) ? "date" : "text";

                            @* step="any" per tutti i decimal tecnici Cobral (massima precisione) *@
                            string stepAttr = isDecimal ? "step=any" : "";

                            var rawValue = prop.GetValue(Model);
                            string formattedValue;

                            if (isDecimal)
                            {
                                formattedValue = FDisplay(rawValue); //formattedValue = FormatDecimal(rawValue, 3);
                            }
                            else if (inputType == "date" && rawValue is DateTime dt)
