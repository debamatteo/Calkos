@model Calkos.web.Models.ViewModels.Prospetti.ProspettoSystemPListaViewModel

@* AGGIUNTO PER ANTIFORGERY CENTRALIZZATO  05/04/2026 *@
@Html.AntiForgeryToken()

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Lista Ordini SYSTEMP";
    int idMandatario = Context.Session.GetInt32("IdMandatario") ?? 0;
    // NUOVO 10/08/2026 Inizio 1
    bool isAdmin = User.IsInRole("Admin");
    bool isOperatore = User.IsInRole("Operatore");
    bool isAgente = User.IsInRole("Agente");
    bool campiEditabili = isAdmin || isOperatore || isAgente;
    // NUOVO 10/08/2026 fine

}

<div class="d-flex align-items-center mb-4">
    <i class="bi bi-table text-primary me-3" style="font-size: 2.5rem;"></i>
    <div>
        <h1 class="h3 mb-0 fw-bold">Lista Ordini SYSTEMP</h1>
        <small class="text-muted">Visualizza gli ordini importati dal file selezionato</small>
    </div>
</div>

@* ============================================================
   FILTRI DI RICERCA (Anno, Mese, File)
   ============================================================ *@
<div class="row g-3 mb-4 align-items-end" id="areaFiltri">
    <input type="hidden" id="filtroidMandatario" value="@ViewBag.IdMandatario" />
    <input type="hidden" id="filtroidFileImportato" value="@ViewBag.IdFileImportato" />

    <div class="col-md-2">
        <label class="form-label fw-bold text-primary">Anno</label>
        <select name="anno" id="filtroAnno" class="form-select border-primary">
            <option value="">Tutti</option>
            @for (int a = DateTime.Now.Year - 5; a <= DateTime.Now.Year + 1; a++)
            {
                <option value="@a" selected="@(ViewBag.Anno == a)">@a</option>
            }
        </select>
    </div>

    <div class="col-md-2">
        <label class="form-label fw-bold text-primary">Mese</label>
        <select name="mese" id="filtroMese" class="form-select border-primary">
            <option value="">Tutti</option>
            @for (int m = 1; m <= 12; m++)
            {
                <option value="@m" selected="@(ViewBag.Mese == m)">
                    @System.Globalization.CultureInfo.GetCultureInfo("it-IT").DateTimeFormat.GetMonthName(m)
                </option>
            }
        </select>
    </div>

    <div class="col-md-3">
        <label class="form-label fw-bold text-primary">Stato Fatturazione</label>
        <select name="fatturata" id="filtroFatturata" class="form-select border-primary">
            <option value="-1" selected="@(ViewBag.Fatturata == null)">Tutti i record</option>
            <option value="0" selected="@(ViewBag.Fatturata?.ToString() == "0")">Solo NON Fatturate</option>
            <option value="1" selected="@(ViewBag.Fatturata?.ToString() == "1")">Solo Fatturate</option>
        </select>
    </div>

    @*  30/09/2026 filtro filtroDaFatturare*@
    <div class="col-md-2">
        <label class="form-label fw-bold text-primary">Da Fatturare</label>
        <select name="daFatturare" id="filtroDaFatturare" class="form-select border-primary">
            <option value="-1" selected="@(ViewBag.DaFatturare == null)">Tutti i record</option>
            <option value="1" selected="@(ViewBag.DaFatturare?.ToString() == "1")">Solo Da Fatturare</option>
            <option value="0" selected="@(ViewBag.DaFatturare?.ToString() == "0")">Solo NON Da Fatturare</option>
        </select>
    </div>

    @* 05/10/2026 NUOVI FILTRI PER RITARDI CONSEGNA *@
    @{
        var filtroRitardo = (ViewBag.InRitardo as string) ?? "";
    }
    <div class="col-md-2">
        <label class="form-label fw-bold text-primary">Ritardo</label>
        <select name="inRitardo" id="filtroInRitardo" class="form-select border-primary">
            <option value="" selected="@(filtroRitardo == "")">Tutti</option>
            <option value="aperti" selected="@(filtroRitardo == "aperti")">In ritardo</option>
            <option value="consegnati" selected="@(filtroRitardo == "consegnati")">Consegnati in ritardo</option>
            <option value="tutti_ritardi" selected="@(filtroRitardo == "tutti_ritardi")">Tutti i ritardi</option>
            <option value="false" selected="@(filtroRitardo == "false")">Non in ritardo</option>
        </select>
    </div>

    @* 02/10/2026 NUOVI FILTRI Giorni Ritardo *@
    <div class="col-md-2">
        <label class="form-label fw-bold text-primary">Giorni Ritardo </label>
        <input type="number" name="giorniRitardoMin" id="filtroGiorniRitardoMin" class="form-control border-primary"
               placeholder="Es. 5" min="0" value="@ViewBag.GiorniRitardoMin" />
    </div>

    @* ============================================================
        22/05/2026 NUOVO FILTRO: TIPO PAGAMENTO filtroTipoPagamento
       - ViewBag.TipiPagamento viene popolato dal controller (vedi sotto)
       - Il valore 0 = "Tutti" (nessun filtro applicato)
       - ViewBag.IdTipoPagamento mantiene la selezione dopo reload/redirect
       ============================================================ *@
    <div class="col-md-2">
        <label class="form-label fw-bold text-primary">Tipo Pagamento</label>
        <select name="idTipoPagamento" id="filtroTipoPagamento" class="form-select border-primary">
            @* Opzione "Tutti" → valore 0 = nessun filtro *@
            <option value="0" selected="@(ViewBag.IdTipoPagamento == null || ViewBag.IdTipoPagamento == 0)">
                Tutti
            </option>
            @* Ciclo sui tipi pagamento popolati dal controller *@
            @foreach (var item in ViewBag.TipiPagamento as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>())
            {
                <option value="@item.Value"
                        selected="@(ViewBag.IdTipoPagamento?.ToString() == item.Value)">
                    @item.Text
                </option>
            }
        </select>
    </div>


    <div class="col-md-2">
        <label class="form-label fw-bold text-danger">Visualizzazione</label>
        <select name="mostraEliminati" id="filtroEliminati" class="form-select border-danger">
            <option value="false" selected="@(ViewBag.MostraEliminati == false)">Record Attivi</option>
            <option value="true" selected="@(ViewBag.MostraEliminati == true)">Cestino (Eliminati)</option>
        </select>
    </div>

    <div class="col-md-2 d-flex align-items-end">
        <button type="button" id="btnResetDinamico" class="btn btn-outline-secondary w-100" style="height: 38px;">
            <i class="bi bi-arrow-counterclockwise me-2"></i> Reset Filtri
        </button>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body">
        <style>
            #ordiniTable tbody tr:hover {
                background-color: #e8f1ff !important;
                cursor: pointer;
            }

            .row-deleted {
                background-color: #f8d7da !important;
                color: #6c757d !important;
                text-decoration: line-through;
            }

            /* ==== 23/10/2026 INIZIO - Colonna Azioni sempre visibile a destra (sticky) ====
                                       Con la finestra stretta compare lo scroll orizzontale di .table-responsive e
                                       l'ultima colonna usciva dall'area visibile. position:sticky + right:0 la tiene
                                       agganciata al bordo destro del contenitore mentre le altre colonne scorrono.
                                       NON si imposta background-color né box-shadow: restano quelli di Bootstrap 5.3
                                       (righe alternate, hover, table-danger) già applicati alla cella. */
            #ordiniTable th.col-azioni,
            #ordiniTable td.col-azioni {
                position: sticky;
                right: 0;
                z-index: 2;
            }

            #ordiniTable thead th.col-azioni {
                z-index: 3; /* l'intestazione sta sopra le celle del corpo */
            }

            /* Separatore visivo: pseudo-elemento, perché con border-collapse (forzato in site.css)
                                       un border sulla cella sticky non si sposta insieme alla cella */
            #ordiniTable th.col-azioni::before,
            #ordiniTable td.col-azioni::before {
                content: "";
                position: absolute;
                top: 0;
                bottom: 0;
                left: -6px;
                width: 6px;
                pointer-events: none;
                background: linear-gradient(to right, transparent, rgba(0, 0, 0, .08));
            }
            /* ==== 23/10/2026 FINE ==== */
        </style>

        @*  22/05/2026 *@
        <a href="/Admin/ProspettiSystemP/Nuovo" class="btn btn-primary mb-3">
            <i class="bi bi-plus-circle"></i> Nuova riga
        </a>

        <a id="btnExportExcel" class="btn btn-primary mb-3">
            <i class="bi bi-file-earmark-excel"></i> Esporta Excel
        </a>

        <a id="btnExportPdf" class="btn btn-primary mb-3">
            <i class="bi bi-file-earmark-pdf"></i> Esporta PDF
        </a>


        <div class="table-responsive" style="overflow-x: auto;">

            <table id="ordiniTable" class="table table-striped table-hover align-middle table-custom-header">
                <thead>
                    <tr>
                        <th style="display:none;">ID</th>

                        @foreach (var col in Model.Colonne)
                        {
                            if (col.Visible)
                            {
                                <th>@col.Label</th>
                            }
                        }
                        @* 23/10/2026 aggiunta classe col-azioni (colonna sticky a destra) *@
                        <th style="width: 120px;" class="text-center col-azioni">Azioni</th>
                    </tr>
                    <tr class="filters">
                        <th style="display:none;"></th>
                        @foreach (var col in Model.Colonne)
                        {
                            if (col.Visible)
                            {
                                <th>
                                    <input type="text" class="form-control form-control-sm" placeholder="Filtra @col.Label" />
                                </th>
                            }
                        }
                        @* 23/10/2026 aggiunta classe col-azioni (colonna sticky a destra) *@
                        <th class="col-azioni"></th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>

        </div>

        @* 02/10/2026 DISABILITATO - IMPORT  NON PIÙ ATTIVO *@
        @if (false)
        {
            <a href="/Admin/ProspettiSystemP/Importa?idMandatario=@idMandatario" class="btn btn-primary mb-3">
                Importa un nuovo file SYSTEMP
            </a>
        }



    </div>
</div>


@* ==== MODIFICA 02/11/2026 - INIZIO ==== Popup scelta periodo per Duplica *@
@{
    var itDup = System.Globalization.CultureInfo.GetCultureInfo("it-IT");
    var oggiDup = DateTime.Today;
    int annoInizioDup = isAgente ? oggiDup.Year : oggiDup.Year - 5;   // l'Agente non va nel passato
}
<div class="modal fade" id="modalDuplica" tabindex="-1" aria-labelledby="modalDuplicaTitolo" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalDuplicaTitolo">Duplica riga</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Chiudi"></button>
            </div>
            <div class="modal-body">
                <p class="mb-2">Periodo (Anno/Mese) della nuova riga:</p>

                @if (!isAgente)
                {
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="duplicaPeriodo" id="duplicaPeriodoOriginale" value="originale" checked />
                        <label class="form-check-label" for="duplicaPeriodoOriginale">Come la riga originale</label>
                    </div>
                }
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="duplicaPeriodo" id="duplicaPeriodoCorrente" value="corrente" checked="@isAgente" />
                    <label class="form-check-label" for="duplicaPeriodoCorrente">
                        Mese corrente (@itDup.DateTimeFormat.GetMonthName(oggiDup.Month) @oggiDup.Year)
                    </label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="duplicaPeriodo" id="duplicaPeriodoScelta" value="scelta" />
                    <label class="form-check-label" for="duplicaPeriodoScelta">A scelta</label>
                </div>

                <div class="row g-2 mt-2" id="duplicaScelta" style="display:none;">
                    <div class="col-6">
                        <label class="form-label" for="duplicaAnno">Anno</label>
                        <select id="duplicaAnno" class="form-select">
                            @for (int annoDup = annoInizioDup; annoDup <= oggiDup.Year + 1; annoDup++)
                            {
                                <option value="@annoDup" selected="@(annoDup == oggiDup.Year)">@annoDup</option>
                            }
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="form-label" for="duplicaMese">Mese</label>
                        <select id="duplicaMese" class="form-select">
                            @for (int meseDup = 1; meseDup <= 12; meseDup++)
                            {
                                <option value="@meseDup" selected="@(meseDup == oggiDup.Month)">@itDup.DateTimeFormat.GetMonthName(meseDup)</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annulla</button>
                <button type="button" class="btn btn-warning" id="btnConfermaDuplica"><i class="bi bi-files"></i> Duplica</button>
            </div>
        </div>
    </div>
</div>
