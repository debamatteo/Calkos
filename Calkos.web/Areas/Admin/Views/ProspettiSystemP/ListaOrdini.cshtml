                             var messaggio = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["ModalMessage"]?.ToString() ?? ""));//20/10/2026
                        $('#modalOperazioneCompletata .modal-body').text(messaggio);
                        var modalElement = document.getElementById('modalOperazioneCompletata');
                        if (modalElement) {
