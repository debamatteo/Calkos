                }
                // Eliminazione definitiva: Admin sempre; Agente solo se non fatturato (Operatore non è autorizzato lato server)
                if (isAdmin || (isAgente && row.Fatturata != 1)) {
                    htmlCestino += `<a href="javascript:void(0)" onclick="cancellaDefinitivoDatabase(${id})"
                                        class="text-danger" title="Elimina definitivamente">
                                        <i class="bi bi-trash3-fill"></i></a>`;
                }
                return htmlCestino;
                // ==== MODIFICA 24/10/2026 - FINE ====
            }


            let html = `
                <a href="/Admin/ProspettiSystemP/DettaglioOrdine/${id}"
                   class="text-primary me-2" title="Dettaglio">
                    <i class="bi bi-eye-fill"></i>
                </a>
                <a href="javascript:void(0)" onclick="duplicaRiga(${id})"
                   class="text-warning me-2" title="Duplica">
                    <i class="bi bi-files"></i>
                        </a> `;

            // ✔️ MOSTRA reset/imposta fattura SOLO SE ADMIN
            if (isAdmin) {
                html += row.Fatturata
                    ? `<a href="javascript:void(0)" onclick="resettaFattura(${id},${row.Fatturata})"
                           class="text-info me-2" title="Resetta fattura">
