@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/2.11.8/umd/popper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    <script>
        // ============================================================
        // VARIABILI GLOBALI PER LE MODALI DI CONFERMA
        // ============================================================
        let deleteId  = null;
        let deleteRow = null;
        let resetId   = null;
        let resetRow  = null;

        // Nuove variabili per gestire ripristino ed eliminazione database tramite modale
        let ripristinaId = null;
        let deleteDefinitivoId = null;



        // --- CENTRALIZZAZIONE CONFIGURAZIONE --- 11/05/2026
                // per mettere decimali diversi ad esempio 3  basta cambiare questi numeri qui:
                const CONFIG_VISUALIZZAZIONE = {
                    decimaliValuta: 2,
                    decimaliNumerici: 2,
                    locale: 'it-IT'
                };

                // --- FUNZIONE DI ARROTONDAMENTO E FORMATTAZIONE ---
                function formattaDatoNumerico(valore, isCurrency) {
                    let num = parseFloat(valore);
                    if (isNaN(num)) return valore;

                    return num.toLocaleString(CONFIG_VISUALIZZAZIONE.locale, {
                        minimumFractionDigits: isCurrency ? CONFIG_VISUALIZZAZIONE.decimaliValuta : CONFIG_VISUALIZZAZIONE.decimaliNumerici,
                        maximumFractionDigits: isCurrency ? CONFIG_VISUALIZZAZIONE.decimaliValuta : CONFIG_VISUALIZZAZIONE.decimaliNumerici
                    });
                }




         const isAdmin = @isAdmin.ToString().ToLower();//10/08/2026 2 True se l’utente è Admin
          const isAgente = @isAgente.ToString().ToLower();//24/10/2026


         // ==== MODIFICA 24/10/2026 - INIZIO ====
        function mostraErroreAjax(xhr, prefisso) {
            var msg = (xhr.responseJSON && xhr.responseJSON.error)
                ? xhr.responseJSON.error
                : 'Operazione non consentita o errore di rete.';
            alert(prefisso + msg);
        }
        // ==== MODIFICA 24/10/2026 - FINE ====


        $(document).ready(function () {

            /**
             * ============================================================
             * CENTRALIZZAZIONE ANTIFORGERY 05/04/2026
             * ============================================================
             */
            $.ajaxSetup({
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                }
            });


             // ================================================================================
            // ==== 01-  MODIFICA 06/08/2026 - INIZIO ====
            // PERSISTENZA FILTRI TRA NAVIGAZIONI (sessionStorage)
            // Obiettivo: se apro un Dettaglio e torno indietro, ritrovo TUTTI i filtri
            // (sia quelli in alto: anno/mese/fatturata/tipoPagamento/eliminati,
            //  sia i filtri veloci per colonna del DataTable, es. "Cliente").
            // Si azzerano SOLO cliccando il pulsante "Reset Filtri" (#btnResetDinamico).
            // ================================================================================
            const FILTRI_STORAGE_KEY = 'calkos_filtriListaOrdini_SystemP';
            const FILTRI_COLONNE_STORAGE_KEY = 'calkos_filtriColonneListaOrdini_SystemP';

            // ---- Filtri IN ALTO (anno/mese/fatturata/tipoPagamento/eliminati) ----
            function salvaFiltriInStorage() {
                var filtri = {
                    anno: $('#filtroAnno').val(),
                    mese: $('#filtroMese').val(),
                    fatturata: $('#filtroFatturata').val(),
                    daFatturare: $('#filtroDaFatturare').val(),             // NUOVO 30/09/2026
                    idTipoPagamento: $('#filtroTipoPagamento').val(),
                    inRitardo: $('#filtroInRitardo').val(),           // 02/10/2026
                    giorniRitardoMin: $('#filtroGiorniRitardoMin').val(),    // 02/10/2026
                    mostraEliminati: $('#filtroEliminati').val()

                };
                sessionStorage.setItem(FILTRI_STORAGE_KEY, JSON.stringify(filtri));
            }

            function ripristinaFiltriDaStorage() {
                var raw = sessionStorage.getItem(FILTRI_STORAGE_KEY);
                if (!raw) return;
                try {
                    var filtri = JSON.parse(raw);
                    if (filtri.anno !== undefined) $('#filtroAnno').val(filtri.anno);
                    if (filtri.mese !== undefined) $('#filtroMese').val(filtri.mese);
                    if (filtri.fatturata !== undefined) $('#filtroFatturata').val(filtri.fatturata);
                    if (filtri.daFatturare !== undefined) $('#filtroDaFatturare').val(filtri.daFatturare);          // NUOVO 30/09/2026
                    if (filtri.idTipoPagamento !== undefined) $('#filtroTipoPagamento').val(filtri.idTipoPagamento);
                    if (filtri.inRitardo !== undefined) $('#filtroInRitardo').val(filtri.inRitardo);            // 02/10/2026
                    if (filtri.giorniRitardoMin !== undefined) $('#filtroGiorniRitardoMin').val(filtri.giorniRitardoMin); // 02/10/2026
                    if (filtri.mostraEliminati !== undefined) $('#filtroEliminati').val(filtri.mostraEliminati);


                } catch (e) {
                    console.warn('Impossibile ripristinare i filtri salvati', e);
                }
            }

            // ---- Filtri COLONNA del DataTable (input nella riga "tr.filters") ----
            // MODIFICA  06/08/2026: salviamo/ripristiniamo usando SEMPRE l'indice colonna
            // reale di DataTables (table.columns()), non l'indice degli <input> nel DOM.
            // In precedenza i due indici erano disallineati di 1 (perché la prima colonna,
            // IdProspettoSystemP, non ha un <input> associato mentre in DataTables occupa
            // comunque l'indice 0): il valore filtrato finiva sulla colonna sbagliata e la
            // tabella risultava vuota dopo il ripristino.
            function salvaFiltriColonneInStorage() {
                var filtriColonne = {};
                table.columns().every(function (index) {
                    var val = this.search();
                    if (val) filtriColonne[index] = val;
                });
                sessionStorage.setItem(FILTRI_COLONNE_STORAGE_KEY, JSON.stringify(filtriColonne));
            }

            function ripristinaFiltriColonneDaStorage() {
                var raw = sessionStorage.getItem(FILTRI_COLONNE_STORAGE_KEY);
                if (!raw) return {};
                try {
                    return JSON.parse(raw);
                } catch (e) {
                    console.warn('Impossibile ripristinare i filtri colonna salvati', e);
                    return {};
                }
            }

            // Ripristina SUBITO i filtri in alto, prima che venga costruita la tabella,
            // così la prima chiamata AJAX di DataTables parte già con i valori corretti.
            // (I filtri colonna invece si ripristinano dentro initComplete, vedi sotto,
            //  perché richiedono che la tabella abbia già i dati caricati.)

            //02/10/2026 Se l'URL porta filtri ritardo, vincono quelli dell'URL e NON sovrascriviamo dallo storage
            @if (ViewBag.FiltriDaUrl != true)
            {
                    <text>ripristinaFiltriDaStorage();</text>
            }
            // ==== MODIFICA 06/08/2026 - FINE ====
            // ================================================================================




            //22/05/2026 aggiornaLinkExport  aggiornaLinkExport() i link vengono ricostruiti dinamicamente ad ogni cambio filtro,per allineare le estrazioni
        function aggiornaLinkExport() {

            let qs =
                "idMandatario=" + $('#filtroidMandatario').val() +
                "&idFileImportato=" + $('#filtroidFileImportato').val() +
                "&anno=" + $('#filtroAnno').val() +
                "&mese=" + $('#filtroMese').val() +
                "&fatturata=" + $('#filtroFatturata').val() +
                "&daFatturare=" + $('#filtroDaFatturare').val() +      // NUOVO 30/09/2026
                "&idTipoPagamento=" + $('#filtroTipoPagamento').val() +
                "&inRitardo=" + $('#filtroInRitardo').val() +                 // 02/10/2026
                "&giorniRitardoMin=" + $('#filtroGiorniRitardoMin').val();    // 02/10/2026

            $('#btnExportExcel').attr('href',
                "/Admin/ProspettiSystemP/ExportExcelProspettoListaOrdini?" + qs);

            $('#btnExportPdf').attr('href',
                "/Admin/ProspettiSystemP/ExportPdfProspettoListaOrdini?" + qs);
        }

                // 24/05/2026 Aggiorna i link export con i filtri iniziali (anno/mese corrente di default)
                aggiornaLinkExport();
            // ----------------------------------------------------------
            // 1. COSTRUZIONE DINAMICA DELLA CONFIGURAZIONE COLONNE
            // ----------------------------------------------------------
            var colConfig = [
                { data: 'IdProspettoSystemP', visible: false }
            ];

            @foreach (var col in Model.Colonne)
            {
                        if (col.Visible)
                        {
                                    var colName = col.Name;
                                    var colFormat = col.Format;
                                    var isNumeric = col.Format.Contains("decimal") || col.Format.Contains("currency");
                                    <text>
                                    colConfig.push({
                                        data: '@colName',
                                        className: '@(isNumeric ? "text-end" : "")',
                                        render: function (data, type, row) {
                                            if (data === null || data === undefined) return '';
                                             // Gestione colonna Fatturata
                                            if ('@colName' === 'Fatturata') {
                                                return data == 1
                                                    ? '<span class="badge bg-success">Si</span>'
                                                    : '<span class="badge bg-secondary">No</span>';
                                            }

                                            @* 
                                            // PercentualeDelta → 0.5 → 50%
                                            if ('@colName' === 'PercentualeDelta') {
                                                var val = parseFloat(data);
                                                if (isNaN(val)) return data;
                                                return (val * 100).toFixed(2) + '%';
                                            }
                                            *@

                                            // 05/05/2025 Percentuale → salvata già come 50 nel database → visualizza 50%
                                            if ('@colFormat' === 'percent') {
                                                var val = parseFloat(data);
                                                if (isNaN(val)) return data;
                                                return val.toFixed(2) + '%';
                                            }




                                                    // 02/10/2026 - Modificato il 02/10/2026 per opzione B
                                                    // Gestione colonna InRitardo (Badge Rosso / Arancione / Verde / Escluso)
                                                    // Gestione colonna InRitardo (Badge Rosso / Arancione / Verde / Escluso)
                                                    if ('@colName' === 'InRitardo') {
                                                        if (row.EscludiControlloRitardo || row.escludiControlloRitardo) {
