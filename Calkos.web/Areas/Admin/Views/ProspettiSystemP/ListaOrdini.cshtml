        const DUPLICA_ANNO_CORRENTE = @DateTime.Today.Year;
        const DUPLICA_MESE_CORRENTE = @DateTime.Today.Month;
        var duplicaIdDaConfermare = null;

        // Agente: nell'anno corrente disabilita i mesi già passati
        function aggiornaMesiDuplica() {
            if (!isAgente) return;
            var annoSel = parseInt($('#duplicaAnno').val(), 10);
            $('#duplicaMese option').each(function () {
                $(this).prop('disabled', annoSel === DUPLICA_ANNO_CORRENTE && parseInt(this.value, 10) < DUPLICA_MESE_CORRENTE);
            });
            if ($('#duplicaMese option:selected').prop('disabled')) {
                $('#duplicaMese option:not(:disabled)').first().prop('selected', true);
            }
        }

        window.duplicaRiga = function (id) {
            duplicaIdDaConfermare = id;
            // default: Admin/Operatore = come l'originale; Agente = mese corrente
            $('input[name="duplicaPeriodo"][value="' + (isAgente ? 'corrente' : 'originale') + '"]').prop('checked', true);
            $('#duplicaAnno').val(DUPLICA_ANNO_CORRENTE);
            $('#duplicaMese').val(DUPLICA_MESE_CORRENTE);
            $('#duplicaScelta').hide();
            $('#btnConfermaDuplica').prop('disabled', false);
            bootstrap.Modal.getOrCreateInstance(document.getElementById('modalDuplica')).show();
        };

        $(document).on('change', 'input[name="duplicaPeriodo"]', function () {
            $('#duplicaScelta').toggle($('input[name="duplicaPeriodo"]:checked').val() === 'scelta');
            aggiornaMesiDuplica();
        });
        $(document).on('change', '#duplicaAnno', aggiornaMesiDuplica);

        $(document).on('click', '#btnConfermaDuplica', function () {
            var periodo = $('input[name="duplicaPeriodo"]:checked').val();
            var dati = { id: duplicaIdDaConfermare, periodo: periodo };
            if (periodo === 'scelta') {
                dati.anno = $('#duplicaAnno').val();
                dati.mese = $('#duplicaMese').val();
            }

            var $btn = $(this).prop('disabled', true);   // evita il doppio click (doppia riga)
            $.ajax({
                url: '/Admin/ProspettiSystemP/DuplicaAjax',
                type: 'POST',
                data: dati,
                success: function (res) {
                    if (res.success) {
                        window.location.href = '/Admin/ProspettiSystemP/DettaglioOrdine/' + res.newId;
                    } else {
                        $btn.prop('disabled', false);
                        alert('Errore durante la duplicazione: ' + res.error);
                    }
                },
                error: function (xhr) { $btn.prop('disabled', false); mostraErroreAjax(xhr, 'Errore: '); }
            });
        });
