            @* ============================================================
               SEZIONE: PREZZI VENDITA
               ============================================================ *@
            <h5 class="fw-bold mt-4">Prezzi Vendita</h5>
            <div class="row g-3">

                @*  Lavorazione	--	LavorazionePrezzoVendita *@
                <div class="col-md-2">
                    <label class="form-label fw-bold">Lavorazione su Vendita(€)</label>
                    @if (campiEditabili)
                    {
