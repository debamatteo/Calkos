            @* ============================================================
               SEZIONE: GESTIONE RITARDO E FATTURAZIONE — AGGIUNTA 30/09/2026
               ============================================================ *@


            @* MODIFICA 12/10/2026: per il ruolo Agente l'INTERA sezione "Gestione Ritardo e Fatturazione"
               (compresi "Escludi da controllo ritardo" e "Da Fatturare") è invisibile.
               Per gli altri ruoli (Admin/Operatore) il comportamento resta invariato. *@
            @if (!isAgente)
            {
                <h5 class="fw-bold mt-4">Gestione Ritardo e Fatturazione</h5>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label fw-bold d-block">Escludi da controllo ritardo</label>
                        @if (campiEditabili && !isAgente) //30/09/20296 SE campiEditabili è TRUE E l’utente NON è Agente → ABILITA il controllo
                        {
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch"
                                       asp-for="EscludiControlloRitardo" id="EscludiControlloRitardo" />
                                <label class="form-check-label" for="EscludiControlloRitardo">
                                    Ignora la scadenza sulla Data Consegna Prevista
                                </label>
                            </div>
                        }
                        else
                        {
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch"
                                       checked="@(Model.EscludiControlloRitardo ? "checked" : null)"
                                       disabled="disabled" />
                                <label class="form-check-label">Ignora la scadenza sulla Data Consegna Prevista</label>
                            </div>
                            <input type="hidden" asp-for="EscludiControlloRitardo" />
                        }
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold d-block">Da Fatturare</label>
                        @if (campiEditabili && !isAgente)//30/09/20296 SE campiEditabili è TRUE E l’utente NON è Agente → ABILITA il controllo
                        {
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch"
                                       asp-for="DaFatturare" id="DaFatturare" />
                                <label class="form-check-label" for="DaFatturare">
                                    Ordine pronto per la fatturazione
                                </label>
                            </div>
                        }
                        else
                        {
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch"
                                       checked="@(Model.DaFatturare ? "checked" : null)"
                                       disabled="disabled" />
                                <label class="form-check-label">Ordine pronto per la fatturazione</label>
                            </div>
                            <input type="hidden" asp-for="DaFatturare" />
                        }
