                    <label class="form-label fw-bold">Data Consegna </label>
                    <input asp-for="DataConsegna" type="date" class="form-control" />
                </div>
                @*           <input type="hidden" id="DataConsegna" name="DataConsegna"
                       value="@(Model.DataConsegna?.ToString("yyyy-MM-dd") ?? "")" /> *@
                <div class="col-md-4">
                    <label class="form-label fw-bold">Scadenza</label>
                    <input asp-for="Scadenza" type="date" class="form-control" />
                </div>
            </div>


            @* MODIFICA 12/10/2026: per il ruolo Agente l'INTERA sezione "Gestione Ritardo e Fatturazione"
               (compresi "Escludi da controllo ritardo" e "Da Fatturare") è invisibile.
               Per gli altri ruoli (Admin/Operatore) il comportamento resta invariato. *@
            @if (!isAgente)
            {
                <h5 class="fw-bold mt-4">Gestione Ritardo e Fatturazione</h5>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label fw-bold d-block">Escludi da controllo ritardo</label>
                        @if (campiEditabili && !isAgente) //30/09/20296 SE campiEditabili è TRUE E l’utente NON è Agente → ABILITA il controllo
                        {
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch"
                                       asp-for="EscludiControlloRitardo" id="EscludiControlloRitardo" />
                                <label class="form-check-label" for="EscludiControlloRitardo">
                                    Ignora la scadenza sulla Data Consegna Prevista
                                </label>
                            </div>
                        }
                        else
                        {
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch"
                                       checked="@(Model.EscludiControlloRitardo ? "checked" : null)"
                                       disabled="disabled" />
                                <label class="form-check-label">Ignora la scadenza sulla Data Consegna Prevista</label>
                            </div>
                            <input type="hidden" asp-for="EscludiControlloRitardo" />
                        }
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold d-block">Da Fatturare</label>
                        @if (campiEditabili && !isAgente)//30/09/20296 SE campiEditabili è TRUE E l’utente NON è Agente → ABILITA il controllo
                        {
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch"
                                       asp-for="DaFatturare" id="DaFatturare" />
                                <label class="form-check-label" for="DaFatturare">
                                    Ordine pronto per la fatturazione
                                </label>
                            </div>
                        }
                        else
                        {
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch"
                                       checked="@(Model.DaFatturare ? "checked" : null)"
                                       disabled="disabled" />
                                <label class="form-check-label">Ordine pronto per la fatturazione</label>
                            </div>
                            <input type="hidden" asp-for="DaFatturare" />
                        }
                        <div class="form-text">
                            Se disattivato, l'ordine viene escluso dalla Dashboard Provvigioni in fase di fatturazione.
                        </div>
                    </div>
                </div>
            }
            else
            {
                @* MODIFICA 12/10/2026: Agente -> sezione non visibile, ma i valori correnti devono comunque
                   viaggiare nel POST (altrimenti i bool verrebbero azzerati a false al salvataggio).
                   Il controller, inoltre, ripristina comunque i valori dal DB per l'Agente (vedi POST DettaglioOrdine). *@
                <input type="hidden" asp-for="EscludiControlloRitardo" />
                <input type="hidden" asp-for="DaFatturare" />
            }



            @* ============================================================
               SEZIONE: AGENTE E PAGAMENTO
               ============================================================ *@
            <h5 class="fw-bold mt-4">Agente e Pagamento</h5>
            <div class="row g-3">

                <div class="col-md-4">
                    @* Agente: select costruita manualmente (non con asp-items) per poter
                       aggiungere l'attributo data-percentuale su ogni option,
                       necessario per il calcolo client-side della provvigione.

                       FIX: ViewBag.Agenti castato a IEnumerable<AgenteSelectItem> in cima alla view.
                       Il controller popola ViewBag.Agenti con List<AgenteSelectItem>, tipo custom
                       che espone Id, Nome e PercentualeDefault.
                       Le proprietà usate nel foreach sono quindi:
                         a.Id               → value dell'option
                         a.Nome             → testo visibile dell'option
                         a.PercentualeDefault → attributo data-percentuale per il calcolo JS
                    
                      NUOVO 07/08/2026: per il ruolo Agente la select diventa disabled
                      e mostra solo se stesso — il server forza comunque IdAgente al
                      proprio in POST, quindi qui è solo per non confondere l'utente
                      con un campo che sembra modificabile ma non lo è realmente.
                      Serve comunque un hidden per far arrivare il valore al POST,
                      esattamente come per gli altri campi disabled di questa view
                      (IdCliente, IdMateriale, IdUnitaMisura). *@
                    @*  // 07/08/2026 INIZIO *@
                    <label class="form-label fw-bold">Agente</label>
                    @if (isAgente)
                    {
                        var mioAgente = agenti.FirstOrDefault(a => a.Id.ToString() == Model.IdAgente.ToString());
                        <select class="form-select input-readonly" disabled="disabled">
                            <option selected="selected">@(mioAgente?.Nome ?? "—")</option>
                        </select>
                        <input type="hidden" id="IdAgente" name="IdAgente" value="@Model.IdAgente" />
                    }
                    else
                    {
                        <select id="IdAgente" name="IdAgente" class="form-select">
                            @foreach (var a in agenti)
                            {
                                bool isSelected = (Model?.IdAgente.ToString() == a.Id.ToString());
                                <option value="@a.Id"
                                        data-percentuale="@a.PercentualeDefault"
                                        selected="@(isSelected ? "selected" : null)">
                                    @a.Nome
                                </option>
                            }
                        </select>
                    }
                    @*  // 07/08/2026 FINE *@
                </div>

                <div class="col-md-4">
                    @{
                        string provValue = FTecnico(Model.ProvvigioneAgente);
                    }
                    @if (!isAgente)
                    {
                        <label class="form-label fw-bold">Provvigione Agente (%)</label>
                        <i class="bi bi-info-circle-fill text-danger ms-2" style="font-size: 1.2rem;" title="Inserire la percentuale in formato umano: 5 significa 5%, NON 0,05"></i>
                        <div class="input-group">
                            <input id="ProvvigioneAgenteDisplay"
                                   type="number"
                                   step="any"
                                   class="form-control input-readonly"
                                   readonly="readonly"
                                   value="@provValue" />
                            @if (isAdmin)
                            {
                                <button type="button" id="toggleProvAgente" class="btn btn-success">
                                    <i class="bi bi-lock-fill"></i>
                                </button>
                            }
                        </div>

                        <input type="hidden"
                               id="ProvvigioneAgente"
                               name="ProvvigioneAgente"
                               value="@provValue" />
                    }
                    else
                    {
                        @* Agente: nessun valore al browser. Il server la decide in ForzaValoriEconomiciAgente. *@
                        <input type="hidden" id="ProvvigioneAgente" name="ProvvigioneAgente" value="0" />
                    }
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold">Tipo Pagamento</label>
                    <select asp-for="IdTipoPagamento" class="form-select"
                            asp-items="@(ViewBag.TipiPagamento as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)">
                    </select>
                </div>

            </div>

            @* ============================================================
               SEZIONE: ALTRI CAMPI (collapsible)
               Generata via Reflection su tutte le proprietà del modello
               non già presenti nelle sezioni precedenti.
               Usa FormatDecimal per i campi decimal (3 decimali = precisione tecnica Cobral).
               ============================================================ *@
            <div class="row g-3">
                <div class="col-md-2">

                    <h5 class="fw-bold mt-4">Altri Campi</h5>
                    @* MODIFICA 12/10/2026: il pulsante è DISABILITATO per il ruolo Agente (isAgente = true).
                       I campi restano comunque nel DOM (collapse chiuso) quindi continuano ad essere inviati nel POST. *@
                    <button class="btn btn-outline-primary mb-3" type="button"
                            data-bs-toggle="collapse" data-bs-target="#tecnici"
                            disabled="@(isAgente ? "disabled" : null)"
                            title="@(isAgente ? "Non disponibile per il ruolo Agente" : null)">
                        Mostra / Nascondi Altri Campi
                    </button>
                </div>
            </div>

            <div class="collapse" id="tecnici">
                <div class="row g-3">
                    @foreach (var prop in typeof(CalkosManager.Domain.Entities.ProspettoDeAngeli).GetProperties())
                    {
                        @* Lista completa dei campi da escludere dalla sezione "Altri Campi"
                           perché già gestiti nelle sezioni precedenti o non rilevanti per l'utente
                           SE un campo è presente nell Array SKIP NON verrà visualizzato nella sezione Altri Campi
                           *@                     
                           
                           
                                               var skip = new[] {

                                        "IdCalcoloBase","IdCliente", "IdMateriale", "IdUnitaMisura", "IdAgente", "IdTipoPagamento", "NumeroOrdine", "NumeroDDT", "NumeroFattura", "Quantita", "QuantitaOrdine", "CostoLavorazione", "Prezzo", "PrezzoConLavorazione",
                                        "PrezzoVendita", "PercentualeProvvigioneVariabile", "ValoreProvvigioneVariabile", "ValoreProvvigioneFissa1", "ValoreProvvigioneFissa2", "ValoreProvvigioneFissa3", "TotaleFissoProvvigione",
                                        "Differenza", "TotaleVariabileProvvigione", "TotaleProvvigioneDaFatturare", "FlagIndicatoreMaggiorazione", "Perc_Delta_Provvigione", "DataConsegnaIpotetica", "Scadenza", "ProvvigioneAgente", "Agente",

                                        "IdProspettoDeAngeli", "IdMandatario", "IdFileImportato", "IdImportDeAngeli", "DataInserimento", "DataModifica", "Utente", "Anno", "Mese",
                                        "Fatturata", "DataFatturazione",
                                        "IsDeleted", "RagioneSociale", "DescrizioneMateriale", "UnitaMisura", "AgenteDescrizione", "PercentualeDefaultAgente", "TipoPagamento"
                                        , "DataConsegna","EscludiControlloRitardo","DaFatturare"   // AGGIUNTA 30/09/2026
                                        ,"SpessoreNum","LarghezzaNum","DiametroNum" // MODIFICA 05/10/2026: Esclusi perché inseriti in posizione dedicata
                                    
                                    };

                        if (skip.Contains(prop.Name)) continue;


                        // MODIFICA 12/10/2026: campi DISMESSI (sostituiti da SpessoreNum/LarghezzaNum/DiametroNum).
                        // Restano visibili in "Altri Campi" per tutti i ruoli, ma NON editabili:
                        // servono solo per consultazione dello storico. Uso readonly (e non disabled)
                        // cosi' il valore viene comunque inviato nel POST e non viene azzerato.
                        bool isDismesso = prop.Name == "Spessore" || prop.Name == "Larghezza";

                        // MODIFICA 12/10/2026: riconoscimento dei campi booleani (bool / bool?),
                        // prima trattati come testo fisso (es. "True") e quindi non modificabili.
                        bool isBool = (Nullable.GetUnderlyingType(prop.PropertyType) ?? prop.PropertyType) == typeof(bool);




                        bool isDecimal = prop.PropertyType == typeof(decimal) || prop.PropertyType == typeof(decimal?);
                        string inputType = isDecimal ? "number" :
                        (prop.PropertyType == typeof(int?) || prop.PropertyType == typeof(int)) ? "number" :
                        (prop.PropertyType == typeof(DateTime?) || prop.PropertyType == typeof(DateTime)) ? "date" : "text";

                        @* step="any" per tutti i decimal tecnici Cobral (massima precisione) *@
                        string stepAttr = isDecimal ? "step=any" : "";

                        var rawValue = prop.GetValue(Model);
                        string formattedValue;

                        if (isDecimal)
                        {
                            formattedValue = FDisplay(rawValue);// formattedValue = FormatDecimal(rawValue, 3);
                        }
                        else if (inputType == "date" && rawValue is DateTime dt)
                        {
                            formattedValue = dt.ToString("yyyy-MM-dd");
                        }
                        else
                        {
                            formattedValue = rawValue?.ToString() ?? "";
                        }
                        @if (isBool)
                        {
                            @* MODIFICA 12/10/2026: campo booleano (es. InRitardo) -> checkbox/switch modificabile.
                                   Pattern ASP.NET MVC: checkbox value="true" + hidden value="false" con lo stesso name:
                                   se spuntato il binder riceve "true,false" -> true; se non spuntato riceve solo "false".
                                   Per un bool? il valore null viene mostrato come non spuntato (e inviato come false). *@
                            bool boolValue = rawValue is bool bv && bv;
                            <div class="col-md-4">
                                <label class="form-label fw-bold d-block">@prop.Name</label>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" role="switch"
                                           name="@prop.Name"
                                           id="@prop.Name"
                                           value="true"
                                           checked="@(boolValue ? "checked" : null)" />
                                    <input type="hidden" name="@prop.Name" value="false" />
                                    <label class="form-check-label" for="@prop.Name">@(boolValue ? "Sì" : "No")</label>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="col-md-4">
                                <label class="form-label fw-bold">
                                    @prop.Name
                                    @if (isDismesso)
                                    {
                                        @* MODIFICA 12/10/2026: etichetta informativa per i campi dismessi *@
                                        <span class="badge bg-secondary ms-1" title="Campo dismesso: sostituito dai campi SpessoreNum / LarghezzaNum / DiametroNum. Solo consultazione storico.">Dismesso</span>
                                    }
                                </label>
                                <input class="form-control @(isDismesso ? "input-readonly" : "")"
                                       name="@prop.Name"
                                       id="@prop.Name"
                                       type="@inputType"
                                       @stepAttr
                                       readonly="@(isDismesso ? "readonly" : null)"
                                       value="@formattedValue" />
                            </div>
                        }

@*                         <div class="col-md-4">
                            <label class="form-label fw-bold">@prop.Name</label>
                            <input class="form-control"
                                   name="@prop.Name"
                                   id="@prop.Name"
                                   type="@inputType"
                                   @stepAttr
                                   value="@formattedValue" />
                        </div> *@
                    }
                </div>
            </div>

            <hr />

            <div class="d-flex justify-content-between mt-3">
                <a href="/Admin/ProspettiDeAngeli/ListaOrdini" class="btn btn-secondary">Torna alla lista</a>
                <button type="submit" class="btn btn-primary">Salva modifiche</button>
            </div>

        </form>

    </div>
</div>


@* ============================================================
