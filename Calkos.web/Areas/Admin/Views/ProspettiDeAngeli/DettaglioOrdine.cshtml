            @* ============================================================
               SEZIONE: DATE
               ============================================================ *@


            <h5 class="fw-bold mt-4">Date</h5>
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label fw-bold">Data Consegna Prevista</label>
                    <input asp-for="DataConsegnaIpotetica" type="date" class="form-control" />
