                $("#IdAgente").on("change", ricalcolaProvvigioneAgente);
                // NUOVO 07/08/2026: Cliente → proposta automatica Agente (solo su Nuovo)
                //$("#IdCliente").on("change", proponiAgenteDaCliente);
                 $("#IdCliente").on("change", gestisciCambioCliente);//26/08/2026


                /**
                 * ============================================================
                 * EVENT LISTENERS — modifica manuale Display (lucchetto aperto)
                 * Sincronizzano l'Hidden e propagano a cascata verso i dipendenti.
                 * Le funzioni ricalcola* verificano il proprio lock: se un campo
                 * intermedio è anch'esso forzato, la cascata si ferma lì.
                 * ============================================================
                 */


            // 13/05/2026 — AGGIUNTA: quando il lucchetto è aperto e l'admin
                        // modifica PrezzoConLavorazione manualmente, aggiorna l'hidden
                        // e propaga a cascata verso tutti i dipendenti tramite ricalcolaTutto().
