                // TotaleFissoProvvigione → TotaleProvvigioneDaFatturare
                $("#TotaleFissoProvvigioneDisplay").on("input", function () {
                    $("#TotaleFissoProvvigione").val(roundTec(safeNum($(this).val())));
                    ricalcolaTotaleProvvigioneDaFatturare();
                });

                // Differenza → TotaleVariabileProvvigione → TotaleProvvigioneDaFatturare
                $("#DifferenzaDisplay").on("input", function () {
                    $("#Differenza").val(roundTec(safeNum($(this).val())));
                    ricalcolaTotaleVariabileProvvigione();
                    ricalcolaTotaleProvvigioneDaFatturare();
                });

                // Perc_Delta_Provvigione Display: aggiorna hidden e propaga.
                // CONVENZIONE: il valore è già in formato intero percentuale (es. 40 = 40%).
                // NON dividere qui — la divisione per 100 avviene solo in calcola_TotaleVariabileProvvigione.
                $("#Perc_Delta_ProvvigioneDisplay").on("input", function () {
                    $("#Perc_Delta_Provvigione").val(roundTec(safeNum($(this).val())));
                    ricalcolaTotaleVariabileProvvigione();
                    ricalcolaTotaleProvvigioneDaFatturare();
                });

                // TotaleVariabileProvvigione → TotaleProvvigioneDaFatturare
                $("#TotaleVariabileProvvigioneDisplay").on("input", function () {
                    $("#TotaleVariabileProvvigione").val(roundTec(safeNum($(this).val())));
                    ricalcolaTotaleProvvigioneDaFatturare();
                });

                // TotaleProvvigioneDaFatturare — foglia della catena, nessuna cascata
                $("#TotaleProvvigioneDaFatturareDisplay").on("input", function () {
                    $("#TotaleProvvigioneDaFatturare").val(roundTec(safeNum($(this).val())));
                });

                // ProvvigioneAgente — campo indipendente
                $("#ProvvigioneAgenteDisplay").on("input", function () {
                    $("#ProvvigioneAgente").val(roundTec(safeNum($(this).val())));
                });

                /**
                 * ============================================================
                 * SINCRONIZZAZIONE DISPLAY → HIDDEN (generica — tutti gli altri)
                 * Cattura tutti i campi Display non già gestiti sopra.
                 * ============================================================
                 */
            $("input[id$='Display']")
                            .not("#ValoreProvvigioneVariabileDisplay, " +
                                 "#ValoreProvvigioneFissa1Display, "   +
                                 "#ValoreProvvigioneFissa2Display, "   +
                                 "#ValoreProvvigioneFissa3Display, "   +
                                 "#TotaleFissoProvvigioneDisplay, "    +
                                 "#DifferenzaDisplay, "                +
                                 "#Perc_Delta_ProvvigioneDisplay, "    +
                                 "#TotaleVariabileProvvigioneDisplay, "+
                                 "#TotaleProvvigioneDaFatturareDisplay, " +
                                 "#ProvvigioneAgenteDisplay, "         +
                                 "#PrezzoConLavorazioneDisplay")        // 13/05/2026 — AGGIUNTA
                            .on("input", function () {
                                const hiddenId = $(this).attr("id").replace("Display", "");
                                $("#" + hiddenId).val(roundTec(safeNum($(this).val())));
                            });

                /**
                 * ============================================================
                 * INIZIALIZZAZIONE
                 * ============================================================
                 * Ordine obbligatorio:
                 *   1. rilevaDivergenze() — imposta i lock corretti leggendo
                 *      gli hidden con i valori DB originali, PRIMA di qualsiasi
                 *      ricalcolo che potrebbe sovrascriverli.
                 *   2. ricalcolaTutto()  — esegue i calcoli rispettando i lock
                 *      appena impostati (i campi forzati vengono saltati).
                 *   3. Provvigione agente — carica via AJAX solo se il valore
                 *      DB è zero (record nuovo o non ancora valorizzato).
                 * ============================================================
                 */
                rilevaDivergenze();
                ricalcolaTutto();

                if ($("#IdAgente").val() && $("#IdCliente").val()) {
                    const valAttuale = safeField("#ProvvigioneAgente");
                    if (valAttuale === 0) ricalcolaProvvigioneAgente();
                }




                /* ============================================================
                * LOGICA GESTIONE CAMBIO CLIENTE (UNIFICATA) Agente, provvigioneAgente e tipo pagamento
                * ============================================================
                */
                const idProspettoCorrente = @Model.IdProspettoDeAngeli;
                /* ============================================================
                 * 23/10/2026 Versione rinforzata: ID validati, risposte "vecchie" scartate, annullamento che ripristina il cliente
                 * ============================================================ */

                let idClientePrecedente = $("#IdCliente").val(); // per ripristinare il cliente se l'utente annulla
                let tokenCambioCliente = 0;                      // identifica l'ultima richiesta: le risposte precedenti vengono scartate

                // Accetta solo interi positivi; qualunque altra cosa (null, undefined, testo, 0) diventa 0
                function idValido(v) {
                    const n = Number(v);
                    return Number.isInteger(n) && n > 0 ? n : 0;
                }

                // Imposta una <select> solo se l'opzione esiste davvero; altrimenti usa il valore di ripiego
                function impostaSelect(selector, valore, fallback) {
                    const $sel = $(selector);
                    let daImpostare = valore ? String(valore) : String(fallback);

                    if ($sel.is("select") && !$sel.find("option").is(function () { return this.value === daImpostare; })) {
                        if (valore) console.warn("Valore " + valore + " non presente in " + selector);
                        daImpostare = String(fallback);
                    }
                    $sel.val(daImpostare).trigger("change");
                }

                // Conferma: gestisce confirmAction booleano/SweetAlert2 e il caso in cui la funzione non esista
                function chiediConferma(messaggio) {
                    if (typeof confirmAction !== "function") return Promise.resolve(window.confirm(messaggio));
                    return Promise.resolve(confirmAction(messaggio)).then(function (r) {
                        return (typeof r === "object" && r !== null) ? Boolean(r.isConfirmed) : Boolean(r);
                    });
                }

                // 1. Logic Agente
                function aggiornaAgenteDaCliente(idCliente, token) {
                    return $.ajax({   // 26/10/2026 3 return: l'orchestratore deve poter attendere la risposta
                        // 26/10/2026 4 era '/Admin/Clienti/GetAgenteCliente' (legge solo Clienti.IdAgente).
                        // Ora: Clienti.IdAgente, altrimenti l'agente in ProvvigioniAgenti per il mandatario corrente.
                        url: '/Admin/ProspettiDeAngeli/GetAgenteClienteMandatario',
                        data: { idCliente: idCliente },
                        dataType: 'json',
                        cache: false
                    }).done(function (res) {
                        if (token !== tokenCambioCliente) return; // nel frattempo l'utente ha cambiato di nuovo cliente
                        // Nessun agente (null/0): selezioniamo il segnaposto "— —" (value = 0)
                        impostaSelect("#IdAgente", idValido(res && res.idAgente), 0);
                    }).fail(function (jqXHR) {
                        if (token !== tokenCambioCliente) return;
                        console.error("ERRORE AJAX aggiornaAgenteDaCliente:", jqXHR.status);
                        alert("Impossibile recuperare l'agente del cliente (errore " + jqXHR.status + "). Verificare manualmente il campo Agente.");
                    });
                }

                // 2. Logic Tipo Pagamento
                function aggiornaTipoPagamentoDaCliente(idCliente, token) {
                    return $.ajax({   // 26/10/2026 5 return: l'orchestratore deve poter attendere la risposta
                        url: '/Admin/Clienti/GetTipoPagamentoDefault',
                        data: { IdCliente: idCliente },
                        dataType: 'json',
                        cache: false
                    }).done(function (res) {
                        if (token !== tokenCambioCliente) return;
                        // Accetta sia IdTipoPagamento sia idTipoPagamento (dipende dalla serializzazione JSON)
                        const id = idValido(res && (res.IdTipoPagamento ?? res.idTipoPagamento));
                        impostaSelect("#IdTipoPagamento", id, "");
                    }).fail(function (jqXHR) {
                        if (token !== tokenCambioCliente) return;
                        console.warn("Impossibile recuperare il Tipo Pagamento di default:", jqXHR.status);
                    });
                }

                // 3. Orchestratore unico eventi & conferma
                async function gestisciCambioCliente() {
                    const idCliente = idValido($("#IdCliente").val());

                    // 26/10/2026 6 Cliente non valido (es. segnaposto "— —"): nessuna riassegnazione, ma la provvigione
                    // non deve restare quella del cliente precedente (il ricalcolo la azzera perche' manca il cliente).
                    if (!idCliente) {
                        tokenCambioCliente++;   // invalida le risposte AJAX ancora in corso
                        ricalcolaProvvigioneAgente();
                        return;
                    }

                    if (idProspettoCorrente !== 0) {
                        const confermato = await chiediConferma(
                            "Hai scelto di modificare il Cliente su un ordine già salvato. " +
                            "Agente, Provvigione e Tipo Pagamento verranno riassegnati."
                        );

                        if (!confermato) {
                            // Annullato: ripristino il cliente precedente (senza rilanciare l'evento) e riallineo la provvigione
                            $("#IdCliente").val(idClientePrecedente);
                            ricalcolaProvvigioneAgente();
                            return; // Interrompe l'aggiornamento di ENTRAMBI i campi
                        }
                    }

                    idClientePrecedente = String(idCliente);
                    const token = ++tokenCambioCliente;

                    // 26/10/2026 7 Attendo ENTRAMBE le risposte (anche in caso di errore) prima di ricalcolare.
                    // .always() esiste in tutte le versioni di jQuery (Promise.allSettled direttamente sui jqXHR no).
                    const attendi = function (jq) { return new Promise(function (ok) { jq.always(ok); }); };
                    await Promise.all([
                        attendi(aggiornaAgenteDaCliente(idCliente, token)),
                        attendi(aggiornaTipoPagamentoDaCliente(idCliente, token))
                    ]);

                    // L'utente ha cambiato di nuovo cliente nel frattempo: questo giro e' obsoleto
                    if (token !== tokenCambioCliente) return;

                    // 26/10/2026 8 Ricalcolo ESPLICITO: agente e cliente sono ora definitivi. Se il nuovo cliente non ha
                    // agente (select su "— —" = 0) la provvigione viene azzerata, non lasciata com'era.
                    ricalcolaProvvigioneAgente();
                }




                        /* ============================================================
                         * NUOVO 28/08/2026 — CALCOLO BASE PREZZO MATERIALI (DeAngeli)
                         * ============================================================
                         * Automatismo (90%): al cambio Materiale, propone in automatico
                         * l'ultimo prezzo attivo e lo applica a #Prezzo + #IdCalcoloBase.
                         * Deroga (10%): bottone apre la modale (storico + nuovo calcolo).
                         * ============================================================
                         */

                        // NUOVO 28/08/2026 — formattazione italiana dedicata alla modale (solo display).
                        // Usa toLocaleString('it-IT'): virgola decimale, punto per le migliaia,
                        // sempre DECIMALI_DISPLAY cifre decimali (4, coerente col resto della view).
                        // NON influisce sui valori numerici usati nei calcoli o inviati al server:
                        // questa funzione produce solo una STRINGA per il rendering del <td>.
                        function formatNumeroModale(v) {
                            if (v === null || v === undefined || v === "") return "";
                            return toNum(v).toLocaleString('it-IT', {
                                minimumFractionDigits: DECIMALI_DISPLAY,
                                maximumFractionDigits: DECIMALI_DISPLAY
                            });
                        }

                        // NUOVO 28/08/2026 — Prezzo Finale ha bisogno di più precisione di
                        // DECIMALI_DISPLAY: dividendo per 1000 un valore a 4 decimali si
                        // ottengono fino a 7 cifre significative (vedi esempio: 8.850,4704 / 1000
                        // = 8,8504704). Usiamo 6 decimali, lo stesso standard tecnico già in uso
                        // altrove nella view per i campi Prezzo (vedi FTecnico lato Razor).
                        function formatPrezzoFinaleModale(v) {
                            if (v === null || v === undefined || v === "") return "";
                            return toNum(v).toLocaleString('it-IT', {
                                minimumFractionDigits: 6,
                                maximumFractionDigits: 6
                            });
                        }
                         // NUOVO 28/08/2026
                        function formatDataItaliana(v) {
                            if (!v) return "";
                            // v arriva come ISO (es. "2026-08-29T00:00:00") dal server.
                            const d = new Date(v);
                            if (isNaN(d.getTime())) return v; // fallback: mostra il valore grezzo se non parsabile
                            const gg = String(d.getDate()).padStart(2, "0");
                            const mm = String(d.getMonth() + 1).padStart(2, "0");
                            const aaaa = d.getFullYear();
                            return `${gg}/${mm}/${aaaa}`;
                        }



                            /* ============================================================
                             * NUOVO 28/08/2026 — CALCOLO DINAMICO "Nuovo Calcolo Base"
                             * ============================================================
                             * Formule (da Excel):
                             *   Calcolo_Temporaneo = (LME == 0 || vuoto) ? 0
                             *                        : (LME + PremioMiniera) / (Cambio || 1)
                             *   EuroFinanziamento  = Calcolo_Temporaneo * (PercFinanziamento / 100)
                             *   MaterialeEuroRiferimento = Calcolo_Temporaneo + EuroFinanziamento
                             *
                             * DIRTY-TRACKING: EuroFinanziamento e MaterialeEuroRiferimento
                             * restano editabili a mano. Se l'utente li modifica direttamente,
                             * il ricalcolo automatico smette di sovrascriverli finché non si
                             * riapre la modale (reset in #btnCambiaCalcoloBase). Il flag si attiva
                             * solo su digitazione reale: $(...).val() da JS non emette 'input'.
                             * ============================================================
                             */
                            let nc_EuroFinanziamentoManuale = false;
                            let nc_MaterialeEuroRiferimentoManuale = false;

                            //function round6(v) {
                           //     return Number((toNum(v) + Number.EPSILON).toFixed(6));
                           // }

                        //per bloccare anche l'input manuale dell'utente (che digitando a mano potrebbe inserire più di 4 decimali), aggiungo un blur che normalizza col medesimo roundTec, coerente con come i campi Display/Hidden si sincronizzano nel resto della pagina:
                        $("#nc_Lme, #nc_PremioMiniera, #nc_Cambio, #nc_PercFinanziamento, " +
                          "#nc_EuroFinanziamento, #nc_MaterialeEuroRiferimento")
                            .on("blur", function () {
                                $(this).val(roundTec($(this).val()));
                            });


                            function calcola_nc_CalcoloTemporaneo() {
                                const lme = safeField("#nc_Lme");
                                if (lme === 0) return 0;
                                const premioMiniera = safeField("#nc_PremioMiniera");
                                const cambioRaw = $("#nc_Cambio").val();
                                const cambio = (cambioRaw === "" || toNum(cambioRaw) === 0) ? 1 : toNum(cambioRaw);
                                return roundTec((lme + premioMiniera) / cambio);
                            }

                                function ricalcolaNuovoCalcoloBase() {
                                    const calcoloTemp = calcola_nc_CalcoloTemporaneo();

                                    let euroFinanziamento = safeField("#nc_EuroFinanziamento");
                                    if (!nc_EuroFinanziamentoManuale) {
                                        const percFin = safeField("#nc_PercFinanziamento");
                                        euroFinanziamento = roundTec(calcoloTemp * (percFin / 100));
                                        $("#nc_EuroFinanziamento").val(euroFinanziamento);
                                    }

                                    let materialeEuroRif = safeField("#nc_MaterialeEuroRiferimento");
                                    if (!nc_MaterialeEuroRiferimentoManuale) {
                                        materialeEuroRif = roundTec(calcoloTemp + euroFinanziamento);
                                        $("#nc_MaterialeEuroRiferimento").val(materialeEuroRif);
                                    }

                                    // NUOVO 28/08/2026 — Punto 2: anteprima del valore che "Salva e Applica"
                                    // scriverà davvero in #Prezzo (stessa formula di applicaCalcoloBaseAOrdine).
                                    $("#nc_PrezzoFinalePreview").val(formatPrezzoFinaleModale(materialeEuroRif / 1000));
                                }

                            $("#nc_Lme, #nc_PremioMiniera, #nc_Cambio, #nc_PercFinanziamento")
                                .on("input", ricalcolaNuovoCalcoloBase);

                            $("#nc_EuroFinanziamento").on("input", function () {
                                nc_EuroFinanziamentoManuale = true;
                                if (!nc_MaterialeEuroRiferimentoManuale) {
                                    const calcoloTemp = calcola_nc_CalcoloTemporaneo();
                                    $("#nc_MaterialeEuroRiferimento").val(roundTec(calcoloTemp + safeField("#nc_EuroFinanziamento")));
                                }
                            });

                            $("#nc_MaterialeEuroRiferimento").on("input", function () {
                                nc_MaterialeEuroRiferimentoManuale = true;
                            });








                        const modalCalcoloBase = new bootstrap.Modal(document.getElementById("modalCalcoloBase"));// NUOVO 28/08/2026

                            // FIX 28/08/2026 — il secondo parametro è MaterialeEuroRiferimento (prezzo di listino,
                            // es. €/tonnellata), NON il prezzo da applicare all'ordine. Il campo Prezzo di
                            // DettaglioOrdine è un prezzo al kg, quindi va sempre diviso per 1000 (Punto 2/3
                            // della specifica: conversione calcolata solo qui, mai persistita in CalcoloBaseMateriale).
                            // Prima di questo fix veniva scritto in #Prezzo il valore intero non diviso.
                            function applicaCalcoloBaseAOrdine(idCalcoloBase, materialeEuroRiferimento) {
                                const prezzoFinale = roundTec(materialeEuroRiferimento / 1000);
                                $("#IdCalcoloBase").val(idCalcoloBase);
                                $("#Prezzo").val(prezzoFinale).trigger("change"); // rilancia la cascata calcoli
                                log("CalcoloBase applicato: Id=" + idCalcoloBase +
                                    ", MaterialeEuroRiferimento=" + materialeEuroRiferimento +
                                    " → PrezzoFinale=" + prezzoFinale);
                            }

                        // --- AUTOMATISMO: cambio Materiale → propone ultimo prezzo attivo ---
                        function aggiornaPrezzoDaMateriale() {
                            const idMateriale = $("#IdMateriale").val();
                            if (!idMateriale) return;

                            $.getJSON(
                                '/Admin/ProspettiDeAngeli/GetUltimoCalcoloBase',
                                { idMateriale: idMateriale },
                                function (res) {
                                    if (res && res.trovato) {
                                        applicaCalcoloBaseAOrdine(res.idCalcoloBase, res.prezzo);
                                    } else {
                                        // Nessuno storico per questo materiale: nessun automatismo,
                                        // l'operatore userà "Cambia / Crea Base" per inserirne uno.
                                        $("#IdCalcoloBase").val("");
                                        log("Nessun CalcoloBase attivo per il materiale " + idMateriale);
                                    }
                                }
                            ).fail(function () { console.error("ERRORE AJAX GetUltimoCalcoloBase"); });
                        }
                        $("#IdMateriale").on("change", aggiornaPrezzoDaMateriale);

                        // NUOVO 28/08/2026 — Scrive il nome del materiale selezionato in DettaglioOrdine
                        // accanto ai titoli "Storico Calcoli Base" e "Nuovo Calcolo Base" della modale.
                        function aggiornaMaterialeModale() {
                            const nomeMateriale = ($("#IdMateriale option:selected").text() || "").trim();
                            $("#calcoloBaseMaterialeStorico").text(nomeMateriale);
                            $("#calcoloBaseMaterialeNuovo").text(nomeMateriale);
                        }

                        // --- DEROGA: apertura modale + caricamento storico ---
                        function caricaStoricoCalcoloBase() {
                            const idMateriale = $("#IdMateriale").val();
                            const $body = $("#calcoloBaseStoricoBody");

                            aggiornaMaterialeModale(); // NUOVO 28/08/2026

                            if (!idMateriale) {
                                $body.html('<tr><td colspan="9" class="text-muted">Seleziona prima un materiale.</td></tr>');
                                return;
                            }

                                $.getJSON(
                                    '/Admin/ProspettiDeAngeli/GetStoricoCalcoloBase',
                                    { idMateriale: idMateriale },
                                    function (righe) {
                                        $body.empty();
                                        if (!righe || righe.length === 0) {
                                            $body.html('<tr><td colspan="9" class="text-muted">Nessuno storico disponibile.</td></tr>');
                                            return;
                                        }
                                            righe.forEach(function (r) {
                                                const $tr = $("<tr>");
                                                $tr.append($("<td>").text(formatDataItaliana(r.DataRiferimento)));
                                                $tr.append($("<td>").text(formatNumeroModale(r.Lme)));
                                                // NUOVO 28/08/2026 — colonna Premio Miniera
                                                $tr.append($("<td>").text(formatNumeroModale(r.PremioMiniera)));
                                                $tr.append($("<td>").text(formatNumeroModale(r.Cambio)));
                                                $tr.append($("<td>").text(formatNumeroModale(r.MaterialeEuroRiferimento)));
                                                // NUOVO 28/08/2026 — colonne Finanziamento % e Finanziamento €
                                                $tr.append($("<td>").text(formatNumeroModale(r.PercFinanziamento)));
                                                $tr.append($("<td>").text(formatNumeroModale(r.EuroFinanziamento)));

                                                // NUOVO 28/08/2026 — Prezzo Finale = MaterialeEuroRiferimento / 1000 (€/kg),
                                                // solo display: valore derivato, non persistito (vedi Punto 3 — Opzione B).
                                                $tr.append($("<td>").text(formatPrezzoFinaleModale(r.MaterialeEuroRiferimento / 1000)));

                                                const $btnUsa = $('<button type="button" class="btn btn-sm btn-primary">Utilizza</button>');
                                                $btnUsa.on("click", function () {
                                                    applicaCalcoloBaseAOrdine(r.Id, r.MaterialeEuroRiferimento);
                                                    modalCalcoloBase.hide();
                                                });

                                                // NUOVO 28/08/2026 — Punto 4: cancellazione con verifica integrità.
                                                const $btnCancella = $('<button type="button" class="btn btn-sm btn-outline-danger ms-1">Cancella</button>');
                                                $btnCancella.on("click", async function () {
                                                    const result = await confirmAction(
                                                        "Confermi la cancellazione di questo calcolo base? L'operazione non è reversibile."
                                                    );
                                                    if (!result.isConfirmed) return;

                                                    $.ajax({
                                                        url: '/Admin/ProspettiDeAngeli/EliminaCalcoloBase',
                                                        type: 'POST',
                                                        data: { id: r.Id },
                                                        success: function () {
                                                            caricaStoricoCalcoloBase(); // ricarica lo storico aggiornato
                                                        },
                                                        error: function (jqXHR) {
                                                            const msg = jqXHR.responseJSON?.messaggio || "Errore durante la cancellazione.";
                                                            $("#calcoloBaseErrori").text(msg);
                                                        }
                                                    });
                                                });

                                                const $tdAzioni = $("<td>").append($btnUsa).append($btnCancella);
                                                $tr.append($tdAzioni);
                                                $body.append($tr);
                                            });
                                    }
                                ).fail(function () { console.error("ERRORE AJAX GetStoricoCalcoloBase"); });
                        }
                        //28/09/2026
                        $("#btnCambiaCalcoloBase").on("click", function () {
                            $("#calcoloBaseErrori").empty();

                            const oggi = new Date();
                            const oggiIso = oggi.getFullYear() + "-" +
                                String(oggi.getMonth() + 1).padStart(2, "0") + "-" +
                                String(oggi.getDate()).padStart(2, "0");
                            $("#nc_DataRiferimento").val(oggiIso);

                            $("#nc_Lme, #nc_PremioMiniera, #nc_Cambio, #nc_PercFinanziamento, " +
                              "#nc_EuroFinanziamento, #nc_MaterialeEuroRiferimento").val(roundTec(0));

                            nc_EuroFinanziamentoManuale = false;
                            nc_MaterialeEuroRiferimentoManuale = false;
                            caricaStoricoCalcoloBase();
                            modalCalcoloBase.show();
                        });
                        // --- DEROGA: creazione al volo + applicazione immediata ---
                        $("#btnSalvaApplicaCalcoloBase").on("click", function () {
                            const idMateriale = $("#IdMateriale").val();
                            $("#calcoloBaseErrori").empty();

                            if (!idMateriale) {
                                $("#calcoloBaseErrori").text("Seleziona prima un materiale sull'ordine.");
                                return;
                            }

                            const payload = {
                                IdMateriale: parseInt(idMateriale, 10),
                                DataRiferimento: $("#nc_DataRiferimento").val(),
                                Lme: safeField("#nc_Lme", null),
                                PremioMiniera: safeField("#nc_PremioMiniera", null),
                                Cambio: safeField("#nc_Cambio", null),
                                PercFinanziamento: safeField("#nc_PercFinanziamento", null),
                                EuroFinanziamento: safeField("#nc_EuroFinanziamento", null),
                                MaterialeEuroRiferimento: safeField("#nc_MaterialeEuroRiferimento", null)
                            };

                            $.ajax({
                                url: '/Admin/ProspettiDeAngeli/SalvaCalcoloBase',
                                type: 'POST',
                                contentType: 'application/json',
                                data: JSON.stringify(payload),
                                success: function (res) {
                                            applicaCalcoloBaseAOrdine(res.IdCalcoloBase, res.Prezzo);
                                    modalCalcoloBase.hide();
                                },
                                error: function (jqXHR) {
                                    const errori = jqXHR.responseJSON?.errori || ["Errore durante il salvataggio."];
                                    $("#calcoloBaseErrori").html(errori.join("<br/>"));
                                }
                            });
                        });



            }); // fine document.ready
    </script>
}
