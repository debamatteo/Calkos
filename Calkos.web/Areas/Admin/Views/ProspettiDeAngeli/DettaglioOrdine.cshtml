@section Scripts {
    <script>
            $(document).ready(function () {

                /**
                 * ============================================================
                 * CENTRALIZZAZIONE ANTIFORGERY
                 * Aggiunge automaticamente il token CSRF a tutte le chiamate
                 * AJAX jQuery, evitando di doverlo passare manualmente ogni volta.
                 * ============================================================
                 */
                $.ajaxSetup({
                    headers: {
                        "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                    }
                });

                //10/08/2026 se fatturata disabilito tutto
                        const fatturata = @Model.Fatturata;

                        if (fatturata === 1) {
                            document.querySelectorAll("input, select, textarea, button").forEach(el => {
                                el.disabled = true;
                            });
                        }
                 //10/08/2026 se fatturata disabilito tutto


                /**
                 * ============================================================
                 * IMPOSTAZIONE INIZIALE FLAG INDICATORE MAGGIORAZIONE
                 * Necessario perché la select HTML non mantiene il valore
                 * selezionato automaticamente: va impostato via JS dal Model.
                 * ============================================================
                 */
                $("#FlagIndicatoreMaggiorazione").val(
                    "@(Model.FlagIndicatoreMaggiorazione == null
                                                                                                                                            ? ""
                                                                                                                                            : (Model.FlagIndicatoreMaggiorazione.Value ? "true" : "false"))");

    /**
     * ============================================================
     * CONFIGURAZIONE DECIMALI CENTRALIZZATA
     * Deve essere allineata con le costanti C# in cima alla view:
     *   DECIMALI_TECNICI  → usati nei campi hidden (inviati al server)
     *   DECIMALI_DISPLAY  → usati nei campi visibili all'utente
     * ============================================================
     */


                const DECIMALI_TECNICI = 4;
                const DECIMALI_DISPLAY = 4;

                // 13/05/2026 — MODIFICA: aggiunto Number.EPSILON prima di toFixed.
                // Problema: V8 (Chrome/Edge) rappresenta alcune moltiplicazioni decimali
                // con errore IEEE 754. Esempio: 14.85*0.015 = 0.22274999999999998
                // (appena sotto 0.22275), quindi toFixed(4) arrotonda a 0.2227 invece di 0.2228.
                // Excel e C# Decimal usano aritmetica a precisione fissa e producono 0.2228.
                // I valori nel DB sono stati calcolati da C# con MidpointRounding.AwayFromZero
                // (equivalente all'half-up di Excel), quindi JS deve replicare lo stesso risultato.
                // Number.EPSILON = 2.22e-16 compensa l'errore di rappresentazione IEEE 754
                // senza alcun impatto sui valori già esatti (es. 1.22 + 2.22e-16 ≈ 1.22).
                // Verificato in console browser:
                //   (0.22274999999999998).toFixed(4)                  → "0.2227" ✗
                //   (0.22274999999999998 + Number.EPSILON).toFixed(4) → "0.2228" ✓
                // Stessa modifica applicata su DettaglioOrdine.cshtml di ElektraWire e Cobral.
                function roundTec(v) {
                return Number((toNum(v) + Number.EPSILON).toFixed(DECIMALI_TECNICI));
                }

                function roundDisplay(v) {
                return Number((toNum(v) + Number.EPSILON).toFixed(DECIMALI_DISPLAY));
                }


                /**
                 * ============================================================
                 * HELPER NUMERICI
                 * ============================================================
                 */

                /**
                 * toNum — conversione grezza stringa → numero.
                 * Gestisce: null, undefined, stringa vuota, virgola decimale.
                 * Restituisce sempre 0 in caso di fallimento (mai NaN).
                 */
                function toNum(v) {
                    if (v === null || v === undefined) return 0;
                    if (typeof v === "string") {
                        v = v.replace(',', '.').trim();
                        if (v === "") return 0;
                    }
                    const n = parseFloat(v);
                    return isNaN(n) ? 0 : n;
                }

                /**
                 * safeNum — bonifica un valore già letto (variabile JS o $(this).val()).
                 * Uso: safeNum($(this).val())  oppure  safeNum(miaVariabile)
                 * Accetta un fallback opzionale (default: 0).
                 */
                function safeNum(v, fallback) {
                    if (fallback === undefined) fallback = 0;
                    if (v === null || v === undefined) return fallback;
                    if (typeof v === "string") {
                        v = v.replace(',', '.').trim();
                        if (v === "") return fallback;
                    }
                    const n = parseFloat(v);
                    if (isNaN(n) || !isFinite(n)) return fallback;
                    return n;
                }

                /**
                 * safeField — legge un campo jQuery dal DOM e lo bonifica.
                 * Uso: safeField("#MioCampo")  invece di  toNum($("#MioCampo").val())
                 * Emette un warning in console se il selettore non trova nulla.
                 */
                function safeField(selector, fallback) {
                    if (fallback === undefined) fallback = 0;
                    const el = $(selector);
                    if (el.length === 0) {
                        console.warn("safeField: campo non trovato →", selector);
                        return fallback;
                    }
                    return safeNum(el.val(), fallback);
                }

                /**
                 * ============================================================
                 * REGOLA DI SCELTA TRA safeNum e safeField
                 * ============================================================
                 *
                 *  safeField("#MioCampo")   → quando leggi direttamente dal DOM
                 *  safeNum($(this).val())   → quando hai già il valore in una variabile
                 *
                 *  Mnemonica: vedi il cancelletto "#"? → safeField.
                 *             Hai già il valore? → safeNum.
                 */

                /**
                 * ============================================================
                 * VARIABILI DI STATO LUCCHETTI
                 * true  = calcolo automatico attivo (lucchetto chiuso, verde)
                 * false = valore forzato manualmente (lucchetto aperto, rosso)
                 *
                 * NOTA su Perc_Delta_Provvigione:
                 * NON ha un lock di calcolo perché NON è un campo calcolato.
                 * È un valore inserito manualmente dall'utente (estratto da
                 * formula Excel ma non ricalcolato automaticamente dalla view).
                 * Il suo lucchetto gestisce solo l'editabilità UI.
                 * Partecipa ai calcoli SOLO come input di TotaleVariabileProvvigione.
                 *
                 * Tutti i lock partono true e vengono corretti da rilevaDivergenze()
                 * prima del primo ricalcolaTutto().
                 * ============================================================
                 */
                let lockValoreProvvigioneVariabile   = true;
                let lockValoreProvvigioneFissa1      = true;
                let lockValoreProvvigioneFissa2      = true;
                let lockValoreProvvigioneFissa3      = true;
                let lockDifferenza                   = true;
                let lockTotaleFissoProvvigione       = true;
                let lockTotaleVariabileProvvigione   = true;
                let lockTotaleProvvigioneDaFatturare = true;
                let lockProvAgente                   = true;
               // 2a — variabile lock (nel blocco variabili di stato):
                let lockPrezzoConLavorazione         = true;// 13/05/2026 — AGGIUNTA: lock per PrezzoConLavorazione.campo calcolato (CostoLavorazione + Prezzo)



            // ============================================================
            // 30/09/2026 — AUTOMAZIONE DataConsegna ALLA COMPILAZIONE DDT
            // Quando l'operatore valorizza/modifica il Numero DDT, avvisiamo
            // che la Data Consegna Effettiva verrà impostata automaticamente
            // ============================================================
            // ============================================================
            // AUTOMAZIONE DataConsegna ALLA COMPILAZIONE DDT 01/10/2026
            // ============================================================
            let valoreOriginaleDDT = $("#NumeroDDT").val();

            $("#NumeroDDT").on("change", function () {
                const nuovoValore = $(this).val().trim();

                // Se il Numero DDT è stato compilato o modificato
                if (nuovoValore !== "" && nuovoValore !== valoreOriginaleDDT) {
                    const oggi = new Date();
                    const oggiIso = oggi.toISOString().substring(0, 10);
                    const dataFormattata = oggi.toLocaleDateString('it-IT');

                    if (typeof confirmAction === "function") {
                        confirmAction(
                            "Aggiornare la  Data Consegna ?",
                            `Hai inserito/modificato il Numero DDT. Vuoi aggiornare la Data Consegna ad oggi (${dataFormattata})?`,
                            "question",
                            "Sì, aggiorna data",
                            "No, mantieni data attuale"
                        ).then((res) => {
                            // Gestisce sia il booleano semplice sia l'oggetto di SweetAlert2 ({ isConfirmed: true })
                            const isConfirmed = (typeof res === "object" && res !== null) ? res.isConfirmed : Boolean(res);

                            if (isConfirmed) {
                                // SOLO SE CONFERMA: aggiorna il campo DataConsegna
                                $("#DataConsegna").val(oggiIso);
                            }
                            // SE ANNULLA: non fa nulla su #DataConsegna (il Numero DDT rimane comunque quello digitato)

                            // Aggiorna il valore di riferimento per i cambi successivi
                            valoreOriginaleDDT = nuovoValore;
                        });
                    } else {
                        // Fallback con confirm nativo
                        if (confirm(`Vuoi aggiornare la Data Consegna ad oggi (${dataFormattata})?`)) {
                            $("#DataConsegna").val(oggiIso);
                        }
                        valoreOriginaleDDT = nuovoValore;
                    }
                }
            });


            // ============================================================
            // 28/10/2026 — AVVISO "DA FATTURARE" SENZA TIPO PAGAMENTO
            // Quando l'operatore attiva lo switch "Da Fatturare" e nella select "Tipo Pagamento" non c'è nessun valore selezionato, mostriamo un popup
            // lo switch su OFF, così l'ordine non viene marcato come fatturabile senza un Tipo Pagamento.
            // ============================================================
            $("#DaFatturare").on("change", function () {
                const $chk = $(this);

                // 28/10/2026 — Interessa solo quando lo switch viene ATTIVATO
                if (!$chk.is(":checked")) return;

                // 28/10/2026 — Tipo Pagamento "non selezionato" = valore vuoto oppure 0 (segnaposto)
                const tipoPagamento = ($("#IdTipoPagamento").val() || "").toString().trim();
                if (tipoPagamento !== "" && tipoPagamento !== "0") return;

                // 28/10/2026 — Annulla l'attivazione dello switch
                // (rimuovi questa riga se vuoi solo avvisare e lasciare lo switch attivo)
                $chk.prop("checked", false);

                const titolo = "Tipo Pagamento mancante";
                const testo  = "Per impostare l'ordine come \"Da Fatturare\" devi prima selezionare un Tipo Pagamento.";

                if (typeof Swal !== "undefined") {
                    Swal.fire({
                        icon: "warning",
                        title: titolo,
                        text: testo,
                        confirmButtonText: "OK"
                    }).then(function () {
                        // 28/10/2026 — Porta il focus sulla select da compilare
                        $("#IdTipoPagamento").trigger("focus");
                    });
                } else {
                    // 28/10/2026 — Fallback se SweetAlert non è caricato
                    alert(titolo + "\n" + testo);
                    $("#IdTipoPagamento").trigger("focus");
                }
            });


        /**
                       * ============================================================
                       * FUNZIONI DI CALCOLO PURE (senza side-effect)
                       * Queste funzioni SOLO calcolano e restituiscono il valore.
                       * Non scrivono nulla nel DOM. Servono a due scopi:
                       *   1. Essere chiamate da rilevaDivergenze() al caricamento
                       *      per capire se un campo è stato forzato nel DB.
                       *   2. Essere richiamate dalle funzioni "ricalcola*" che
                       *      invece scrivono nel DOM.
                       *
                       * CONVENZIONI DeAngeli:
                       *   PercentualeProvvigioneVariabile → formato intero (es. 5 = 5%) → dividi per 100 nel calcolo.
                       *                                     È un INPUT DELL'UTENTE, non calcolato dalla view.
                       *   Perc_Delta_Provvigione          → formato intero (es. 40 = 40%) → dividi per 100 nel calcolo.
                       *                                     È un INPUT MANUALE, non calcolato dalla view.
                       *   FlagIndicatoreMaggiorazione     → "true"/"false" come stringa (valore della select).
                       * ============================================================
                       */

                        function calcola_ValoreProvvigioneVariabile() {
                            const percVar  = safeField("#PercentualeProvvigioneVariabile");
                            const costoLav = safeField("#PrezzoConLavorazione");
                            return roundTec(percVar === 0 ? 0 : costoLav * (percVar / 100));
                        }

                        //Modifica 1 — aggiungere la funzione pura Subito dopo calcola_ValoreProvvigioneVariabile, aggiungi:
                        // 13/05/2026 — AGGIUNTA: funzione pura per PrezzoConLavorazione.
                        // In Excel: PrezzoConLavorazione = CostoLavorazione + Prezzo (Lavorazione + Materiale Euro di riferimento).
                        // Ha il proprio lock: se forzato nel DB, rilevaDivergenze() apre il lucchetto e ricalcolaTutto() non lo sovrascrive.
                        function calcola_PrezzoConLavorazione() {
                            return roundTec(safeField("#CostoLavorazione") + safeField("#Prezzo"));
                        }





                      function calcola_ValoreProvvigioneFissa1() {
                          const qtaOrdine    = ($("#QuantitaOrdine").val() || "").toLowerCase();
                          const prezzoVendita = safeField("#PrezzoVendita");
                          const aliquotaVar  = safeField("#PercentualeProvvigioneVariabile");
                          const prezzo       = safeField("#Prezzo");
                          const materiale    = ($("#IdMateriale option:selected").text() || "").toLowerCase();
                          const prezzoConLav = safeField("#PrezzoConLavorazione");

                          if (qtaOrdine === "si") {
                              return roundTec(prezzoVendita * 0.015);
                          }
                          if (aliquotaVar >= 5 && prezzo !== 0) {
                              if (materiale.includes("rame smaltato")) return roundTec(prezzoVendita * 0.015);
                              if (materiale.includes("rame"))          return roundTec(prezzoConLav * 0.015);
                          }
                          return 0;
                      }

                      function calcola_ValoreProvvigioneFissa2() {
                          const prezzo        = safeField("#Prezzo");
                          const materiale     = ($("#IdMateriale option:selected").text() || "").toLowerCase();
                          const prezzoConLav  = safeField("#PrezzoConLavorazione");
                          const prezzoVendita = safeField("#PrezzoVendita");

                          if (prezzo === 0) return 0;

                          let totale = 0;
                          if (materiale.includes("alluminio"))          totale += prezzoConLav  * 0.03;
                          if (materiale.includes("alluminio smaltato")) totale += prezzoVendita * 0.03;
                          return roundTec(totale);
                      }

                      function calcola_ValoreProvvigioneFissa3() {
                          const materiale   = ($("#IdMateriale option:selected").text() || "").toLowerCase();
                          const aliquotaVar = safeField("#PercentualeProvvigioneVariabile");
                          const costoLav    = safeField("#CostoLavorazione");
                          const isEligibile = (!materiale.includes("alluminio") && aliquotaVar < 5);
                          return roundTec(isEligibile ? costoLav * 0.08 : 0);
                      }

                      // function calcola_Differenza() {
                      //     const vendita   = safeField("#PrezzoVendita");
                      //     const costo      = safeField("#PrezzoConLavorazione");
                      //     const qtaOrdine = safeField("#QuantitaOrdine");
                      //     const flagQ     = ($("#FlagIndicatoreMaggiorazione").val() || "").toLowerCase();

                      //     if (flagQ === "true")                        return 0;
                      //     if (qtaOrdine !== 0 && qtaOrdine < 500)      return 0;
                      //     if (costo > vendita)                         return 0;
                      //     return roundTec(vendita - costo);
                      // }



                        /**
                        * DIFFERENZA (DELTA) - LOG DETTAGLIATO
                        */
                        function calcola_Differenza() {
                            const vendita   = safeField("#PrezzoVendita");
                            const costo      = safeField("#PrezzoConLavorazione");
                            const qtaOrdine = safeField("#QuantitaOrdine");
                            const flagQ     = ($("#FlagIndicatoreMaggiorazione").val() || "").toLowerCase();
                            if (flagQ === "true") {
                            log("LOG PURE - Differenza: BLOCCO [FlagIndicatoreMaggiorazione=true], ritorno 0");
                            return 0;
                            }
                            if (qtaOrdine !== 0 && qtaOrdine < 500) {
                            log("LOG PURE - Differenza: BLOCCO [Quantità " + qtaOrdine + " < 500], ritorno 0");
                            return 0;
                            }
                            if (costo > vendita) {
                            log("LOG PURE - Differenza: BLOCCO [Costo " + costo + " > Vendita " + vendita + "], ritorno 0");
                            return 0;
                            }

                            const ris = roundTec(vendita - costo);
                            log("LOG PURE - Differenza: CALCOLO ESEGUITO (" + vendita + " - " + costo + ") = " + ris);
                            return ris;
                        }



                      function calcola_TotaleFissoProvvigione() {
                          const qta = safeField("#Quantita");
                          const f1  = safeField("#ValoreProvvigioneFissa1");


                          const f2  = safeField("#ValoreProvvigioneFissa2");
                          const f3  = safeField("#ValoreProvvigioneFissa3");
                          return roundTec((f1 + f2 + f3) * qta);
                      }

                      function calcola_TotaleVariabileProvvigione() {
                          const delta = safeField("#Differenza");
                          const kg    = safeField("#Quantita");
                          const perc  = safeField("#Perc_Delta_Provvigione");
                          return roundTec(delta * kg * (perc / 100));
                      }

                      function calcola_TotaleProvvigioneDaFatturare() {
                          return roundTec(
                              safeField("#TotaleFissoProvvigione") +
                              safeField("#TotaleVariabileProvvigione")
                          );
                      }

                      /**
                       * ============================================================
                       * FUNZIONI DI RICALCOLO (con side-effect: scrivono nel DOM)
                       * ============================================================
                       */


                         // 13/05/2026 — AGGIUNTA: ricalcolo PrezzoConLavorazione.2b — funzione ricalcola (subito prima di ricalcolaValoreProvvigioneVariabile):
                        // Scrive nel campo #PrezzoConLavorazione (che è asp-for, non Display/Hidden)
                        // perché in questo modulo il campo è un input diretto nel form,
                        // non una coppia Display/Hidden come gli altri campi calcolati.
                        // La cascata: PrezzoConLavorazione → ValoreProvvigioneVariabile
                        //                                  → ValoreProvvigioneFissa1/2/3
                        //                                  → Differenza → TotaleVariabile → TotaleFattura
                        // viene gestita chiamando ricalcolaTutto() che riesegue tutta la pipeline.
            function ricalcolaPrezzoConLavorazione() {
                                  if (!lockPrezzoConLavorazione) return;
                                  const tec = calcola_PrezzoConLavorazione();
                                  log("Calcolo PrezzoConLavorazione: [CostoLav](" + safeField("#CostoLavorazione") +
                                      ") + [Prezzo](" + safeField("#Prezzo") + ") = " + tec);
                                  // 13/05/2026 — scrive sia sul Display (visibile) che sull'Hidden (POST),
                                  // identico a tutti gli altri campi calcolati con lucchetto.
                                  $("#PrezzoConLavorazioneDisplay").val(tec);
                                  $("#PrezzoConLavorazione").val(tec);
                              }


                      function ricalcolaValoreProvvigioneVariabile() {
                          if (!lockValoreProvvigioneVariabile) return;
                          const tec = calcola_ValoreProvvigioneVariabile();
                          log("Calcolo ValoreProvvigioneVariabile: [PrezzoConLavorazione](" + safeField("#PrezzoConLavorazione") + ") * ([PercProvvVar](" + safeField("#PercentualeProvvigioneVariabile") + ") / 100) = " + tec);
                          $("#ValoreProvvigioneVariabileDisplay").val(roundDisplay(tec));
                          $("#ValoreProvvigioneVariabile").val(tec);
                      }

                      function ricalcolaValoreProvvigioneFissa1() {
                          if (!lockValoreProvvigioneFissa1) return;
                          const tec = calcola_ValoreProvvigioneFissa1();
                          log("Calcolo ValoreProvvigioneFissa1: [QtaOrdine](" + ($("#QuantitaOrdine").val() || "") + "), [Materiale](" + ($("#IdMateriale option:selected").text() || "") + ") → Risultato: " + tec);
                          $("#ValoreProvvigioneFissa1Display").val(roundDisplay(tec));
                          $("#ValoreProvvigioneFissa1").val(tec);
                          ricalcolaTotaleFissoProvvigione();
                      }

                      function ricalcolaValoreProvvigioneFissa2() {
                          if (!lockValoreProvvigioneFissa2) return;
                          const tec = calcola_ValoreProvvigioneFissa2();
                          log("Calcolo ValoreProvvigioneFissa2: [Materiale](" + ($("#IdMateriale option:selected").text() || "") + ") → Risultato: " + tec);
                          $("#ValoreProvvigioneFissa2Display").val(roundDisplay(tec));
                          $("#ValoreProvvigioneFissa2").val(tec);
                          ricalcolaTotaleFissoProvvigione();
                      }

                      function ricalcolaValoreProvvigioneFissa3() {
                          if (!lockValoreProvvigioneFissa3) return;
                          const tec = calcola_ValoreProvvigioneFissa3();
                          log("Calcolo ValoreProvvigioneFissa3: [Materiale](" + ($("#IdMateriale option:selected").text() || "") + "), [AliquotaVar](" + safeField("#PercentualeProvvigioneVariabile") + ") → Risultato: " + tec);
                          $("#ValoreProvvigioneFissa3Display").val(roundDisplay(tec));
                          $("#ValoreProvvigioneFissa3").val(tec);
                          ricalcolaTotaleFissoProvvigione();
                      }

                      function ricalcolaDifferenza() {
                          if (!lockDifferenza) return;
                          const tec = calcola_Differenza();
                          log("Calcolo Differenza: [PrezzoVendita](" + safeField("#PrezzoVendita") + ") - [PrezzoConLav](" + safeField("#PrezzoConLavorazione") + ") | Vincoli: [FlagMaggiorazione](" + $("#FlagIndicatoreMaggiorazione").val() + ") → Delta: " + tec);
                          $("#DifferenzaDisplay").val(roundDisplay(tec));
                          $("#Differenza").val(tec);
                          ricalcolaTotaleVariabileProvvigione();
                      }



                      function ricalcolaTotaleFissoProvvigione() {
                          if (!lockTotaleFissoProvvigione) return;
                          const tec = calcola_TotaleFissoProvvigione();
                          log("Calcolo TotaleFissoProvvigione: (F1+F2+F3) * [Quantita](" + safeField("#Quantita") + ") = " + tec);
                          $("#TotaleFissoProvvigioneDisplay").val(roundDisplay(tec));
                          $("#TotaleFissoProvvigione").val(tec);
                          ricalcolaTotaleProvvigioneDaFatturare();
                      }

                      function ricalcolaTotaleVariabileProvvigione() {
                          if (!lockTotaleVariabileProvvigione) return;
                          const tec = calcola_TotaleVariabileProvvigione();
                          log("Calcolo TotaleVariabileProvvigione: [Differenza](" + safeField("#Differenza") + ") * [Quantita](" + safeField("#Quantita") + ") * ([PercDelta](" + safeField("#Perc_Delta_Provvigione") + ") / 100) = " + tec);
                          $("#TotaleVariabileProvvigioneDisplay").val(roundDisplay(tec));
                          $("#TotaleVariabileProvvigione").val(tec);
                          ricalcolaTotaleProvvigioneDaFatturare();
                      }

                      function ricalcolaTotaleProvvigioneDaFatturare() {
                          if (!lockTotaleProvvigioneDaFatturare) return;
                          const tec = calcola_TotaleProvvigioneDaFatturare();
                          log("Calcolo TotaleProvvigioneDaFatturare: [TotFisso](" + safeField("#TotaleFissoProvvigione") + ") + [TotVar](" + safeField("#TotaleVariabileProvvigione") + ") = " + tec);
                          $("#TotaleProvvigioneDaFatturareDisplay").val(roundDisplay(tec));
                          $("#TotaleProvvigioneDaFatturare").val(tec);
                      }
                /**
                 * ============================================================
                 * ricalcolaTutto — punto di ingresso principale
                 * Chiamato da tutti gli event listener sui campi di input.
                 *
                 * Ordine di esecuzione rispettando le dipendenze:
                 *   1. ValoreProvvigioneVariabile  (dipende da PrezzoConLavorazione, PercentualeProvvigioneVariabile)
                 *   2. ValoreProvvigioneFissa1/2/3 (dipendono da materiale, prezzi, flag)
                 *      └─ TotaleFissoProvvigione   (chiamato in cascata da ciascuna)
                 *         └─ TotaleProvvigioneDaFatturare (chiamato in cascata)
                 *   3. Differenza                  (dipende da PrezzoVendita, PrezzoConLavorazione, flag, qtaOrdine)
                 *      └─ TotaleVariabileProvvigione (chiamato in cascata)
                 *         └─ TotaleProvvigioneDaFatturare (chiamato in cascata)
                 *   4. TotaleFissoProvvigione esplicito (per aggiornare con Quantita cambiata)
                 *   5. TotaleProvvigioneDaFatturare esplicito (foglia finale, sicurezza)
                 *
                 * NOTA: i campi con lucchetto aperto (lock = false) vengono
                 * ignorati automaticamente dalla loro funzione ricalcola*.
                 * ============================================================
                 */
                    function ricalcolaTutto() {//2c — aggiornare ricalcolaTutto
                            log(">>> AVVIO RICALCOLO GLOBALE");
                            log("PrezzoVendita:", safeField("#PrezzoVendita"));
                            log("Prezzo:", safeField("#Prezzo"));
                            log("CostoLavorazione:", safeField("#CostoLavorazione"));
                            log("PrezzoConLavorazione:", safeField("#PrezzoConLavorazione"));
                            log("Quantita:", safeField("#Quantita"));
                            log("QuantitaOrdine:", safeField("#QuantitaOrdine"));
                            log("PercentualeProvvigioneVariabile:", safeField("#PercentualeProvvigioneVariabile"));
                            log("FlagIndicatoreMaggiorazione:", $("#FlagIndicatoreMaggiorazione").val());
                            log("Perc_Delta_Provvigione (input manuale):", safeField("#Perc_Delta_Provvigione"));

                            // 13/05/2026 — AGGIUNTA: PrezzoConLavorazione calcolato per primo
                            // perché tutti gli altri campi dipendono da esso.
                            // Deve precedere ValoreProvvigioneVariabile, Fissa1/2/3 e Differenza
                            // che lo leggono tutti da #PrezzoConLavorazione.
                            ricalcolaPrezzoConLavorazione();
                            log("PrezzoConLavorazione dopo:", safeField("#PrezzoConLavorazione"));

                            // 1. Commissione variabile (non entra in altri calcoli, indipendente)
                            ricalcolaValoreProvvigioneVariabile();

                            // 2. Provvigioni fisse → in cascata verso TotaleFisso → TotaleFattura
                            ricalcolaValoreProvvigioneFissa1();
                            ricalcolaValoreProvvigioneFissa2();
                            ricalcolaValoreProvvigioneFissa3();

                            // 3. TotaleFisso esplicito: le tre fisse sopra lo chiamano in cascata,
                            //    ma Quantita può cambiare indipendentemente da esse.
                            ricalcolaTotaleFissoProvvigione();
                            log("TotaleFissoProvvigione dopo:", $("#TotaleFissoProvvigione").val());

                            // 4. Differenza → in cascata: TotaleVariabile → TotaleFattura
                            ricalcolaDifferenza();
                            log("Differenza dopo:", $("#Differenza").val());
                            log("TotaleVariabileProvvigione dopo:", $("#TotaleVariabileProvvigione").val());
                            log("TotaleProvvigioneDaFatturare dopo:", $("#TotaleProvvigioneDaFatturare").val());

                            log("<<< RICALCOLO GLOBALE COMPLETATO");
                    }






                /**
                 * ============================================================
                 * PROVVIGIONE AGENTE (AJAX)
                 * Recupera la percentuale di provvigione dell'agente per il
                 * cliente selezionato. Non fa nulla se il lucchetto è aperto.
                 * ============================================================
                 */
                           const isAgenteJs = @isAgente.ToString().ToLower();//25/10/2026 l'agente non riceve né calcola la provvigione
          

                      //23/10/2026 ricalcolaProvvigioneAgente nuova
                        let tokenProvvigione = 0; // identifica l'ultima richiesta di provvigione: le risposte precedenti vengono scartate

                        function ricalcolaProvvigioneAgente() {
                            if (!lockProvAgente) return;

                            // Ogni nuova chiamata invalida quelle ancora in corso, anche se questa poi esce subito (es. agente mancante)
                            const token = ++tokenProvvigione;

                            const idAgente  = idValido($("#IdAgente").val());   // idValido è definita più sotto: funziona perché è una function declaration
                            const idCliente = idValido($("#IdCliente").val());

                            // 26/10/2026 1 Senza agente (o cliente) non esiste una provvigione valida: azzero invece di
                            // lasciare nel campo la percentuale del cliente/agente precedente.
                            if (!idAgente || !idCliente) {
                                log("ProvvigioneAgente azzerata: IdAgente o IdCliente mancante o non valido.");
                                $("#ProvvigioneAgenteDisplay").val(roundDisplay(0));
                                $("#ProvvigioneAgente").val(0);
                                return;
                            }

                            log("Chiamata AJAX ProvvigioneAgente: idAgente=" + idAgente + ", idCliente=" + idCliente);

                            $.ajax({
                                url: '/Admin/ProspettiDeAngeli/GetPercentualeProvvigione',
                                data: { idAgente: idAgente, idCliente: idCliente },
                                dataType: 'json',
                                cache: false
                            }).done(function (percentuale) {
                                if (token !== tokenProvvigione) return; // nel frattempo è partita una richiesta più recente

                                const valTec = roundTec(safeNum(percentuale));
                                const valVis = roundDisplay(valTec);

                                log("Risultato AJAX ProvvigioneAgente: Percentuale ricevuta=" +
                                    percentuale + " → Formattata=" + valTec);

                                $("#ProvvigioneAgenteDisplay").val(valVis);
                                $("#ProvvigioneAgente").val(valTec);
                            }).fail(function (jqXHR, textStatus, error) {
                                if (token !== tokenProvvigione) return;
                                log("ERRORE AJAX ricalcolaProvvigioneAgente:", textStatus, error);
                            });
                        }

                /**
                 * ============================================================
                 * GESTIONE LUCCHETTI — aggiornaUILucchetto
                 * Funzione condivisa che aggiorna l'aspetto visivo del pulsante
                 * e lo stato readonly del campo Display associato.
                 *
                 * isLocked = true  → campo readonly, pulsante verde con lucchetto chiuso
                 * isLocked = false → campo editabile, pulsante rosso con lucchetto aperto
                 *
                 * Usata sia da setupToggle (click utente) sia da rilevaDivergenze
                 * (inizializzazione automatica al caricamento pagina).
                 * ============================================================
                 */
                function aggiornaUILucchetto(idBtn, idInputDisplay, isLocked) {
                    const $input = $(idInputDisplay);
                    const $btn   = $(idBtn);
                    if (isLocked) {
                        $input.prop("readonly", true).addClass("input-readonly");
                        $btn.removeClass("btn-danger").addClass("btn-success")
                            .html('<i class="bi bi-lock-fill"></i>');
                    } else {
                        $input.prop("readonly", false).removeClass("input-readonly");
                        $btn.removeClass("btn-success").addClass("btn-danger")
                            .html('<i class="bi bi-unlock-fill"></i>');
                    }
                }

                /**
                 * ============================================================
                 * GESTIONE LUCCHETTI — setupToggle
                 * Al click:
                 *   - chiude il lucchetto (lock → true): sincronizza l'hidden
                 *     col valore attuale del Display, poi aggiorna UI.
                 *   - apre il lucchetto (lock → false): campo diventa editabile,
                 *     il valore NON viene resettato a quello originale.
                ** NOTA (MODIFICA 25/10/2026): Perc_Delta_Provvigione NON ha più il lucchetto:
                * è sempre un input manuale editabile.
                * NOTA: Perc_Delta_Provvigione ha un pulsante lucchetto ma
                * NON ha una variabile lock di calcolo (non è un campo calcolato).
                * Il suo toggle gestisce solo readonly/editabile via case 'percDelta'.
                 * ============================================================
                 */
                function setupToggle(idBtn, idInputDisplay, type) {
                    $(idBtn).on("click", function () {

                        let isLocked;
                        switch (type) {
                            case 'prezzoConLav': lockPrezzoConLavorazione = !lockPrezzoConLavorazione; isLocked = lockPrezzoConLavorazione; break;//13/05/2026
                            case 'valVar':  lockValoreProvvigioneVariabile   = !lockValoreProvvigioneVariabile;   isLocked = lockValoreProvvigioneVariabile;   break;
                            case 'fissa1':  lockValoreProvvigioneFissa1      = !lockValoreProvvigioneFissa1;      isLocked = lockValoreProvvigioneFissa1;      break;
                            case 'fissa2':  lockValoreProvvigioneFissa2      = !lockValoreProvvigioneFissa2;      isLocked = lockValoreProvvigioneFissa2;      break;
                            case 'fissa3':  lockValoreProvvigioneFissa3      = !lockValoreProvvigioneFissa3;      isLocked = lockValoreProvvigioneFissa3;      break;
                            case 'diff':    lockDifferenza                   = !lockDifferenza;                   isLocked = lockDifferenza;                   break;
                            case 'totFis':  lockTotaleFissoProvvigione       = !lockTotaleFissoProvvigione;       isLocked = lockTotaleFissoProvvigione;       break;
                            case 'totVar':  lockTotaleVariabileProvvigione   = !lockTotaleVariabileProvvigione;   isLocked = lockTotaleVariabileProvvigione;   break;
                            case 'totFatt': lockTotaleProvvigioneDaFatturare = !lockTotaleProvvigioneDaFatturare; isLocked = lockTotaleProvvigioneDaFatturare; break;
                            case 'agente':  lockProvAgente                   = !lockProvAgente;                   isLocked = lockProvAgente;                   break;

                            // //MODIFICA 25/10/2026: rimosso lucchetto, campo sempre editabile manualmente
                            // // Perc_Delta_Provvigione: input manuale, nessuna variabile lock di calcolo.
                            // // Il toggle gestisce solo readonly/editabile sull'UI.
                            // case 'percDelta':
                            //     const attualmenteReadonly = $(idInputDisplay).prop("readonly");
                            //     isLocked = !attualmenteReadonly;
                            //     aggiornaUILucchetto(idBtn, idInputDisplay, isLocked);
                            //     return; // esce subito, senza toccare hidden
                        }

                        // Se si chiude il lucchetto, sincronizza l'hidden col valore
                        // attuale del Display (preserva eventuali modifiche manuali).
                        if (isLocked) {
                            const hiddenId = idInputDisplay.replace("#", "").replace("Display", "");
                            $("#" + hiddenId).val(roundTec(safeNum($(idInputDisplay).val())));
                        }

                        aggiornaUILucchetto(idBtn, idInputDisplay, isLocked);
                    });
                }






                    setupToggle("#togglePrezzoConLavorazione", "#PrezzoConLavorazioneDisplay", "prezzoConLav");// 13/05/2026 — AGGIUNTA: lucchetto PrezzoConLavorazione.
                setupToggle("#toggleValoreProvvigioneVariabile",   "#ValoreProvvigioneVariabileDisplay",   "valVar");
                setupToggle("#toggleValoreProvvigioneFissa1",      "#ValoreProvvigioneFissa1Display",      "fissa1");
                setupToggle("#toggleValoreProvvigioneFissa2",      "#ValoreProvvigioneFissa2Display",      "fissa2");
                setupToggle("#toggleValoreProvvigioneFissa3",      "#ValoreProvvigioneFissa3Display",      "fissa3");
                setupToggle("#toggleDifferenza",                   "#DifferenzaDisplay",                   "diff");
                setupToggle("#toggleTotaleFissoProvvigione",       "#TotaleFissoProvvigioneDisplay",       "totFis");
                 //MODIFICA 25/10/2026: rimosso lucchetto, campo sempre editabile manualmente
                // setupToggle("#togglePerc_Delta_Provvigione",       "#Perc_Delta_ProvvigioneDisplay",       "percDelta");
                setupToggle("#toggleTotaleVariabileProvvigione",   "#TotaleVariabileProvvigioneDisplay",   "totVar");
                setupToggle("#toggleTotaleProvvigioneDaFatturare", "#TotaleProvvigioneDaFatturareDisplay", "totFatt");
                setupToggle("#toggleProvAgente",                   "#ProvvigioneAgenteDisplay",            "agente");

                /**
                 * ============================================================
                 * rilevaDivergenze — inizializzazione automatica lucchetti
                 * ============================================================
                 * Confronta ogni valore salvato nel DB (campo Hidden) con il
                 * risultato della funzione pura corrispondente. Se differiscono
                 * oltre la soglia 0.0001, apre il lucchetto automaticamente
                 * per proteggere il valore forzato dal primo ricalcolaTutto().
                 *
                 * Perc_Delta_Provvigione NON viene controllata: è un input manuale,
                 * non ha una funzione pura di calcolo e non ha un lock di calcolo.
                 *
                 * ORDINE: dal livello più basso della catena verso il più alto,
                 * così le funzioni pure leggono sempre i valori DB originali
                 * dagli hidden (non ancora sovrascritti da ricalcoli parziali).
                 *
                 * Catena di dipendenze DeAngeli:
                 *   ValoreProvvigioneVariabile (indipendente, non entra in altri calcoli)
                 *
                 *   ValoreProvvigioneFissa1 ──┐
                 *   ValoreProvvigioneFissa2 ──┼── TotaleFissoProvvigione ──┐
                 *   ValoreProvvigioneFissa3 ──┘                             ├── TotaleProvvigioneDaFatturare
                 *                                                           │
                 *   Differenza ── TotaleVariabileProvvigione ───────────────┘
                 * ============================================================
                 */


            function rilevaDivergenze() {
                            const SOGLIA = 0.001;

                            /** MODIFICA 11/05/2026
                             * Valuta se il valore nel database diverge dal calcolo teorico della formula.
                             * Viene utilizzata nei moduli (Cobral, SystemCore, ecc.) per inizializzare lo stato dei lucchetti.
                             */
                            // 13/05/2026 — MODIFICA: rimossa la logica con toFixed(3) sugli operandi
                            // che arrotondava PRIMA della sottrazione generando falsi negativi.
                            // Esempio del problema:
                            //   0.2228 → toFixed(3) → 0.223
                            //   0.2227 → toFixed(3) → 0.223
                            //   diff = 0.000 → lucchetto mai aperto anche per divergenze reali.
                            // Soluzione: confronto sulla differenza GREZZA tra valoreDB e valoreCalc.
                            // La soglia 0.001 assorbe solo floating-point noise (< 0.0001),
                            // non divergenze reali del dominio (≥ 0.01).
                            // 13/05/2026 — AGGIUNTA: tutti i campi calcolati ora vengono controllati.
                            // Problema precedente: mancavano i controlli per ValoreProvvigioneVariabile,
                            // ValoreProvvigioneFissa1/2/3, TotaleFissoProvvigione, TotaleVariabileProvvigione,
                            // TotaleProvvigioneDaFatturare e Differenza. Conseguenza: se uno di questi campi
                            // era stato forzato manualmente nel DB, al primo ricalcolaTutto() veniva
                            // sovrascritto silenziosamente perché il lock rimaneva true.
                            // Perc_Delta_Provvigione NON viene controllata: è un input manuale,
                            // non ha una funzione pura di calcolo e non ha un lock di calcolo.
                            function controlla(idHidden, idBtn, idDisplay, fnCalcola, setLock) {
                                const valoreDB   = safeField(idHidden);
                                const valoreCalc = fnCalcola();
                                const diff       = Math.abs(valoreDB - valoreCalc);

                                if (diff > SOGLIA) {
                                    log("Valore forzato rilevato per", idHidden,
                                        "| DB =", valoreDB,
                                        "| Calcolato =", valoreCalc,
                                        "| Diff =", diff,
                                        "→ lucchetto aperto automaticamente");

                                    // Sblocca la logica (setLock false = non più vincolato alla formula)
                                    setLock(false);

                                    // Aggiorna visivamente il lucchetto e rende il campo editabile
                                    aggiornaUILucchetto(idBtn, idDisplay, false);
                                }
                            }



                        // 13/05/2026 — AGGIUNTA: controllo PrezzoConLavorazione.
                                // Primo controllo perché tutti gli altri campi dipendono da esso.
                                controlla(
                                    "#PrezzoConLavorazione", "#togglePrezzoConLavorazione", "#PrezzoConLavorazioneDisplay",
                                    calcola_PrezzoConLavorazione,
                                    (v) => { lockPrezzoConLavorazione = v; }
                                );




                            // Livello 1 — indipendente (non entra in altri calcoli)
                            controlla(
                                "#ValoreProvvigioneVariabile", "#toggleValoreProvvigioneVariabile", "#ValoreProvvigioneVariabileDisplay",
                                calcola_ValoreProvvigioneVariabile,
                                (v) => { lockValoreProvvigioneVariabile = v; }
                            );

                            // Livello 1 — input diretti delle provvigioni fisse
                            controlla(
                                "#ValoreProvvigioneFissa1", "#toggleValoreProvvigioneFissa1", "#ValoreProvvigioneFissa1Display",
                                calcola_ValoreProvvigioneFissa1,
                                (v) => { lockValoreProvvigioneFissa1 = v; }
                            );

                            controlla(
                                "#ValoreProvvigioneFissa2", "#toggleValoreProvvigioneFissa2", "#ValoreProvvigioneFissa2Display",
                                calcola_ValoreProvvigioneFissa2,
                                (v) => { lockValoreProvvigioneFissa2 = v; }
                            );

                            controlla(
                                "#ValoreProvvigioneFissa3", "#toggleValoreProvvigioneFissa3", "#ValoreProvvigioneFissa3Display",
                                calcola_ValoreProvvigioneFissa3,
                                (v) => { lockValoreProvvigioneFissa3 = v; }
                            );

                            // Livello 1 — Differenza (dipende da input diretti dell'utente)
                            controlla(
                                "#Differenza", "#toggleDifferenza", "#DifferenzaDisplay",
                                calcola_Differenza,
                                (v) => { lockDifferenza = v; }
                            );

                            // Livello 2 — dipende da F1+F2+F3 e Quantita (letti dagli hidden DB)
                            controlla(
                                "#TotaleFissoProvvigione", "#toggleTotaleFissoProvvigione", "#TotaleFissoProvvigioneDisplay",
                                calcola_TotaleFissoProvvigione,
                                (v) => { lockTotaleFissoProvvigione = v; }
                            );

                            // Livello 2 — dipende da Differenza e Perc_Delta_Provvigione (input manuale)
                            controlla(
                                "#TotaleVariabileProvvigione", "#toggleTotaleVariabileProvvigione", "#TotaleVariabileProvvigioneDisplay",
                                calcola_TotaleVariabileProvvigione,
                                (v) => { lockTotaleVariabileProvvigione = v; }
                            );

                            // Livello 3 — foglia della catena
                            controlla(
                                "#TotaleProvvigioneDaFatturare", "#toggleTotaleProvvigioneDaFatturare", "#TotaleProvvigioneDaFatturareDisplay",
                                calcola_TotaleProvvigioneDaFatturare,
                                (v) => { lockTotaleProvvigioneDaFatturare = v; }
                            );
                        }







                /**
                 * ============================================================
                 * EVENT LISTENERS — campi principali
                 * ============================================================
                 * Triggera ricalcolaTutto() su ogni modifica dei campi di input.
                 *
                 * Perc_Delta_Provvigione è incluso come input manuale:
                 * quando l'utente lo modifica direttamente, TotaleVariabileProvvigione
