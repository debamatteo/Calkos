                // ValoreProvvigioneVariabile — campo indipendente, nessuna cascata
                $("#ValoreProvvigioneVariabileDisplay").on("input", function () {
                    $("#ValoreProvvigioneVariabile").val(roundTec(safeNum($(this).val())));
                });

                // ValoreProvvigioneFissa1/2/3 → TotaleFissoProvvigione → TotaleProvvigioneDaFatturare
                $("#ValoreProvvigioneFissa1Display, #ValoreProvvigioneFissa2Display, #ValoreProvvigioneFissa3Display")
                    .on("input", function () {
                        const hiddenId = $(this).attr("id").replace("Display", "");
                        $("#" + hiddenId).val(roundTec(safeNum($(this).val())));
