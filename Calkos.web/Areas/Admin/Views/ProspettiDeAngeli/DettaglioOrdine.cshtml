            @* ============================================================
               Prima RIGA TOTALI
               ============================================================ *@
            <div class="row g-3 mt-2">

                <!-- Totale Fisso = (ValoreProvvigioneFissa1* Quantita)+(ValoreProvvigioneFissa1 * Quantita)+( [8% Fissa] * Quantita) -->
                <div class="col-md-3">
