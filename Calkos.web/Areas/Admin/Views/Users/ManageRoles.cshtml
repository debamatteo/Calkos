@using Calkos.Web.Models.Admin
@model ManageUserRolesViewModel

@{
    ViewData["Title"] = "Assegnazione Ruoli";
}

<!-- Header moderno -->
<div class="d-flex align-items-center mb-4">
    <i class="bi bi-toggle-on text-warning me-3" style="font-size: 2.5rem;"></i>
    <div>
        <h1 class="h3 mb-0 fw-bold">Assegnazione Ruoli</h1>
        <small class="text-muted">Modifica i ruoli assegnati all’utente</small>
    </div>
</div>


<!-- 07/08/2026 -->
@if (TempData["Errore"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        @TempData["Errore"]
        @* 31/10/2026 Scorciatoie per collegare l'agente quando manca (impostato dal controller) *@
        @if (TempData["MostraCollegaAgente"] != null)
        {
            <div class="mt-2 d-flex gap-2">
                <a asp-area="Admin" asp-controller="Users" asp-action="Edit" asp-route-id="@Model.UserId"
                   class="btn btn-sm btn-outline-danger">
                    <i class="bi bi-link-45deg"></i> Collega agente esistente
                </a>
                <a asp-area="Admin" asp-controller="Agenti" asp-action="Create"
                   asp-route-returnUrl="@Url.Action("Edit", "Users", new { area = "Admin", id = Model.UserId })"
                   class="btn btn-sm btn-danger">
                    <i class="bi bi-person-plus"></i> Crea nuovo agente
                </a>
            </div>
        }
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Info utente -->
<div class="mb-3">
    <span class="text-muted">Utente:</span>
    <strong>@Model.Email</strong>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-area="Admin" asp-controller="Users" asp-action="ManageRoles" method="post">
            @Html.AntiForgeryToken()

            <!-- Id utente nascosto -->
            <input type="hidden" asp-for="UserId" />

            <div class="list-group">
                @for (int i = 0; i < Model.Roles.Count; i++)
                {
                    <div class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <!-- Nome ruolo -->
                            <strong>@Model.Roles[i].RoleName</strong>
                        </div>

                        <div class="form-check form-switch">
                            <!-- Checkbox stile switch -->
                            <input class="form-check-input"
                                   asp-for="Roles[i].IsSelected" />
                            <input type="hidden" asp-for="Roles[i].RoleId" />
                            <input type="hidden" asp-for="Roles[i].RoleName" />
                        </div>
                    </div>
                }
            </div>

            <div class="mt-3 d-flex justify-content-between">
                <a asp-area="Admin"
                   asp-controller="Users"
                   asp-action="Index"
                   class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Torna alla lista
                </a>

                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-save"></i> Salva modifiche
                </button>
            </div>
        </form>
    </div>
</div>
