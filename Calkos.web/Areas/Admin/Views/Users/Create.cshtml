@model Calkos.Web.Models.Admin.UserCreateViewModel
<h2>Nuovo Utente</h2>
@* autocomplete="off" disattiva l’autocompletamento del form
autocomplete="new-email" e autocomplete="new-password" dicono al browser che non deve usare credenziali salvate *@
<form method="post" autocomplete="off">
    <div asp-validation-summary="All" class="text-danger mb-3"></div> @* 19/10/2026 *@
    <div class="mb-3">
        <label>Email</label>
        @* 05/11/2026 asp-for: in caso di errore l'email digitata non si perde *@
        <input asp-for="Email" class="form-control" autocomplete="new-email" />
    </div>

    <div class="mb-3">
        <label>Password temporanea</label>
        @* La password non viene mai riproposta dopo un errore: va digitata di nuovo *@
        <input name="Password" type="password" class="form-control" autocomplete="new-password" />
    </div>
    <!-- ==== MODIFICA 25/08/2026 - FINE ==== -->
    <div class="alert alert-info mt-2">
        <strong>Requisiti password</strong>
        <ul class="mb-0 mt-2">
            <li>Minimo 12 caratteri</li>
            <li>Almeno una lettera maiuscola</li>
            <li>Almeno una lettera minuscola</li>
            <li>Almeno un numero</li>
        </ul>
    </div>

    <div class="mb-3">
        <label asp-for="IdAgente" class="form-label">Agente collegato</label>
        <select asp-for="IdAgente" asp-items="ViewBag.Agenti" class="form-select">
            <option value="">-- Nessuno --</option>
        </select>
    </div>

    @* ==== MODIFICA 05/11/2026 - INIZIO ==== Ruoli (stessa logica di Modifica Utente) *@
    <div class="mb-3">
        <label class="form-label">Ruoli</label>
        @for (int i = 0; i < Model.Roles.Count; i++)
        {
            <div class="form-check form-switch">
                <input class="form-check-input" asp-for="Roles[i].IsSelected" />
                <label class="form-check-label" asp-for="Roles[i].IsSelected">@Model.Roles[i].RoleName</label>
                <input type="hidden" asp-for="Roles[i].RoleId" />
                <input type="hidden" asp-for="Roles[i].RoleName" />
            </div>
        }
        <div class="form-text">Il ruolo Agente richiede un agente collegato.</div>
    </div>
    @* ==== MODIFICA 05/11/2026 - FINE ==== *@

    <button type="submit" class="btn btn-primary">Crea</button>
</form>
