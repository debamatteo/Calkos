    @* 13/10/2026 INIZIO - Selezione automatica del valore al focus (tutte le maschere) *@
    <script>
        // ============================================================
        // 13/10/2026 SELEZIONE AUTOMATICA DEL VALORE AL FOCUS
        // ------------------------------------------------------------
        // Quando l'utente entra in un campo testuale o numerico (click o TAB)
        // il contenuto già presente viene selezionato per intero: digitando si
        // SOSTITUISCE il valore invece di accodare cifre (es. "125" + "50" = "12550").
        //
        // - Handler DELEGATO sul document: vale anche per i campi creati dinamicamente
        //   (es. blocco "Altri Campi") senza doverli registrare uno a uno.
        // - Campo vuoto: nessun effetto (comportamento invariato).
        // - Esclusi: readonly/disabled, checkbox, date, hidden, textarea (note lunghe)
        //   e il campo di ricerca interno di Select2.
        // - Per escludere un singolo campo: aggiungere l'attributo data-no-select-on-focus.
        // - Un secondo click dentro un campo GIÀ focalizzato posiziona il cursore normalmente.
        // - Definito UNA SOLA VOLTA qui nel layout: vale per tutte le maschere che usano questo
        //   layout, quindi NON va ripetuto nelle singole view. La guardia
        //   window.__selectOnFocusAttivo evita comunque la doppia registrazione.
        // ============================================================
        if (!window.__selectOnFocusAttivo) {
            window.__selectOnFocusAttivo = true;

            const TIPI_SELEZIONABILI = ["text", "number", "tel", "search"];
            let focusDaMouse = false; // true solo se il focus nasce da un click (mousedown su campo non ancora attivo)

            function isCampoSelezionabile(el) {
                if (!el || el.tagName !== "INPUT") return false;
                if (el.disabled || el.readOnly) return false;
                if (el.hasAttribute("data-no-select-on-focus")) return false;
                if (el.classList.contains("select2-search__field")) return false;
                return TIPI_SELEZIONABILI.indexOf(el.type) !== -1;
            }

            // 1) Click: ricordiamo che il focus arriva dal mouse (solo se il campo non è già attivo)
            $(document).on("mousedown", "input", function () {
                focusDaMouse = isCampoSelezionabile(this) && document.activeElement !== this;
            });

            // 2) Focus (click o TAB): selezione completa se il campo contiene già un valore
            $(document).on("focusin", "input", function () {
                if (!isCampoSelezionabile(this)) return;
                if (this.value === "") return;   // campo vuoto: nessuna modifica
                this.select();                   // select() funziona anche su type="number"
            });

            // 3) Rilascio del mouse: Chrome/Safari deselezionano il testo al mouseup
            //    posizionando il cursore. Lo impediamo solo per il click che ha dato il focus.
            $(document).on("mouseup", "input", function (e) {
                if (focusDaMouse) {
                    focusDaMouse = false;
                    e.preventDefault();
                }
            });
        }
        // 13/10/2026 FINE selezione automatica al focus
    </script>
