    <script>
        window.showSuccess = function(message) {
            return Swal.fire({
                icon: "success",
                title: "Operazione completata",
                text: message,
                confirmButtonText: "OK"
            });
        };

        window.showError = function(message) {
            return Swal.fire({
                icon: "error",
                title: "Attenzione",
                text: message,
                confirmButtonText: "OK"
            });
        };

        window.showWarning = function(titleOrMessage, message) {
            let title = "Attenzione";
            let text = titleOrMessage;

            // Se vengono passati 2 parametri, il primo è il titolo e il secondo è il testo
            if (message !== undefined) {
                title = titleOrMessage;
                text = message;
            }

            return Swal.fire({
                icon: "warning",
                title: title,
                text: text,
                confirmButtonText: "OK"
            });
        };

        window.showHtmlMessage = function(title, html, icon = "info") {
            return Swal.fire({
                icon: icon,
                title: title,
                html: html,
                confirmButtonText: "OK"
            });
        };

        window.confirmAction = function (param1, param2) {
            let title = "Conferma";
            let message = "";

            if (param2 !== undefined) {
                // Chiamata a 2 parametri: confirmAction(title, message)
                title = param1;
                message = param2;
            } else {
                // Chiamata ad 1 parametro: confirmAction(message)
                message = param1;
            }

            return Swal.fire({
                icon: "question",
                title: title,
                text: message,
                showCancelButton: true,
                confirmButtonText: "Sì, conferma",
                cancelButtonText: "Annulla",
                reverseButtons: true
            });
        };

        window.escapeHtml = function(value) {
            return String(value ?? "")
                .replaceAll("&", "&amp;")
                .replaceAll("<", "&lt;")
                .replaceAll(">", "&gt;")
                .replaceAll('"', "&quot;")
                .replaceAll("'", "&#039;");
        };


        //funzione showAlert() 20/10/2026
        function showAlert(message, type = "info") {
            const container = document.getElementById("alert-container");
            if (!container) return;

            const alertEl = document.createElement("div");
            alertEl.className = `alert alert-${type} alert-dismissible fade show shadow`;
            alertEl.setAttribute("role", "alert");

            const testo = document.createElement("div");
            testo.textContent = message;
            alertEl.appendChild(testo);

            const chiudi = document.createElement("button");
            chiudi.type = "button";
            chiudi.className = "btn-close";
            chiudi.setAttribute("data-bs-dismiss", "alert");
            alertEl.appendChild(chiudi);

            container.appendChild(alertEl);
            setTimeout(() => alertEl.remove(), 4000);
        };


        window.confirmAndExecute = function(message, ajaxOptions) {
            return Swal.fire({
                icon: "question",
                title: "Conferma",
                text: message,
                showCancelButton: true,
                confirmButtonText: "Sì",
                cancelButtonText: "Annulla",
                reverseButtons: true
            }).then(result => {
                if (result.isConfirmed) {
                    return $.ajax(ajaxOptions);
                }
            });
        };
        window.toast = function(message, icon = "info") {
            return Swal.fire({
                toast: true,
                position: "top-end",
                icon: icon,
                title: message,
                showConfirmButton: false,
                timer: 2000
            });
        };


    </script>
