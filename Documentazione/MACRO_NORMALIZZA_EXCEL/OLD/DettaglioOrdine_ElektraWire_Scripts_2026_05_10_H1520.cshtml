@section Scripts {
    <script>
        $(document).ready(function () {

            // ============================================================
            // 1. SETUP & CONFIGURAZIONE
            // ============================================================
            /**
             * Configura le chiamate AJAX per includere il token di sicurezza (antiforgery),
             * necessario per comunicare correttamente con il server ASP.NET Core.
             */
            $.ajaxSetup({
                headers: { "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val() }
            });

            const log = (...args) => console.log(...args);

            /**
             * ============================================================
             * HELPER NUMERICI
             * ============================================================
             */

            /**
             * toNum — conversione grezza stringa → numero.
             * Gestisce: null, undefined, stringa vuota, virgola decimale.
             * Restituisce sempre 0 in caso di fallimento (mai NaN).
             */
            function toNum(v) {
                if (v === null || v === undefined) return 0;
                if (typeof v === "string") {
                    v = v.replace(',', '.').trim();
                    if (v === "") return 0;
                }
                const n = parseFloat(v);
                return isNaN(n) ? 0 : n;
            }

            // ============================================================
            // CONFIGURAZIONE DECIMALI CENTRALIZZATA
            // ============================================================

            // Precisione tecnica reale usata nei calcoli/salvataggio: 4 decimali.
            // ***Sostituire [Round a 6] con roundTec, [Round a 3] con roundDisplay
            const DECIMALI_TECNICI = 4;

            // Precisione visuale UI
            const DECIMALI_DISPLAY = 4;

            function roundTec(v) {
                return Number(toNum(v).toFixed(DECIMALI_TECNICI));
            }

            function roundDisplay(v) {
                return Number(toNum(v).toFixed(DECIMALI_DISPLAY));
            }

            /**
             * ============================================================
             * BONIFICA CAMPI — safeNum e safeField
             * ============================================================
             *
             * safeField  → quando leggi un campo dal DOM con $("#...").val()
             *              $("#...").val()  →  safeField("#...")
             *
             * safeNum    → quando hai già il valore in una variabile JS
             *              $(this).val()    →  safeNum($(this).val())
             *              variabile        →  safeNum(variabile)
             *
             * Regola visiva:
             * Se vedi le virgolette e il cancelletto #: usa safeField.
             * Se vedi $(this) o una variabile: usa safeNum.
             */
            function safeNum(v, fallback) {
                if (fallback === undefined) fallback = 0;
                if (v === null || v === undefined) return fallback;
                if (typeof v === "string") {
                    v = v.replace(',', '.').trim();
                    if (v === "") return fallback;
                }
                const n = parseFloat(v);
                if (isNaN(n) || !isFinite(n)) return fallback;
                return n;
            }

            function safeField(selector, fallback) {
                if (fallback === undefined) fallback = 0;
                const el = $(selector);
                if (el.length === 0) {
                    console.warn("safeField: campo non trovato →", selector);
                    return fallback;
                }
                return safeNum(el.val(), fallback);
            }

            /**
             * setField — scrive display e hidden in un colpo solo.
             * Mantiene Display (roundDisplay) e Hidden (roundTec) allineati.
             */
            function setField(displayId, hiddenId, tecValue) {
                $("#" + displayId).val(roundDisplay(tecValue));
                $("#" + hiddenId).val(roundTec(tecValue));
            }

            // ============================================================
            // 3. VARIABILI DI STATO (MANUALE)
            //
            // Queste variabili booleane controllano se un campo si comporta
            // come una FORMULA Excel (false) o come un VALORE FISSO (true).
            //
            //   false = formula attiva: ricalcolaTutto() sovrascrive il campo
            //           con il valore calcolato dagli input base.
            //           Equivale a una cella Excel con =A1+B1
            //
            //   true  = valore fisso: l'admin ha inserito un numero manuale
            //           che ricalcolaTutto() legge come dato senza toccarlo,
            //           e usa per i calcoli dei passi successivi.
            //           Equivale a una cella Excel con un numero scritto a mano.
            //
            // LUCCHETTO CHIUSO (verde) → manuale = false → formula attiva
            // LUCCHETTO APERTO  (rosso) → manuale = true  → valore fisso
            //
            // NOTA: questo oggetto è l'equivalente delle variabili lockXxx
            // degli altri moduli, ma centralizzato in un unico oggetto.
            // rilevaDivergenze() imposta manuale[chiave] = true quando
            // rileva che il valore nel DB non coincide con la formula.
            // ============================================================
            const manuale = {
                PrezzoConLavorazione:         false,
                DeltaMargine:                 false,
                ValUnitProvvigioneFissa1_5:   false,
                ValUnitProvvigioneFissa_03:   false,
                Delta1ProvvigioneFissa1_5:    false,
                Delta2ProvvigioneFissa1_5:    false,
                Delta1ProvvigioneFissa_03:    false,
                Delta2ProvvigioneFissa_03:    false,
                TotProvvigioneFissa1_5:       false,
                TotProvvigioneFissa_03:       false,
                ValQuotaFissa_1_5:            false,
                ValQuotaFissa_03:             false,
                TotaleFissoProvvigione:       false,
                DeltaResiduoVariabile:        false,
                Perc_Delta_Provvigione:       false,
                TotaleVariabileProvvigione:   false,
                TotaleSommaProvvigioni:       false,
                TotaleProvvigioneDaFatturare: false,
                ProvvigioneAgente:            false
            };

            // ============================================================
            // 4. PIPELINE STATELESS — ricalcolaTutto()
            //
            // Funzione orchestratore — esegue l'intera catena di calcolo
            // in ordine sequenziale senza doppi trigger.
            //
            // REGOLA FONDAMENTALE (identico a Excel):
            //   - se manuale=false (formula): calcola il valore dalla variabile
            //     locale del passo precedente e aggiorna il DOM
            //   - se manuale=true (valore fisso): legge il valore dal DOM
            //     UNA SOLA VOLTA all'inizio del passo e lo usa per i passi
            //     successivi, senza mai sovrascriverlo
            //
            // Ogni passo passa il suo risultato al passo successivo tramite
            // variabili locali JS — MAI rileggendo dal DOM.
            // Questo garantisce: stessi input → stessi output, sempre.
            // Il caso 0.77 → 1.77 → 0.77 funziona perché la pipeline
            // riparte dai campi base, non dai derivati.
            // ============================================================
            function ricalcolaTutto() {
                log(">>> Avvio ricalcolo globale (Orchestratore Stateless)");

                // ---------------------------------------------------------
                // CAMPI BASE — letti dal DOM una sola volta, all'inizio.
                // Questi NON vengono mai scritti dalla pipeline.
                // ---------------------------------------------------------
                const quantita         = safeField("#Quantita");
                const prezzoBase       = safeField("#PrezzoBase");
                const costoLavorazione = safeField("#CostoLavorazione");
                const prezzoVendita    = safeField("#PrezzoVendita");
                const percDeltaProvv   = safeField("#Perc_Delta_Provvigione");

                // Materiale letto dal testo della option selezionata (non dall'ID).
                // Questo è corretto perché le formule condizionali usano il nome
                // del materiale (es. "alluminio", "rame"), non l'id numerico.
                const materiale = ($("#IdMateriale option:selected").text() || "").trim().toLowerCase();

                log("Campi base letti: Qta=" + quantita + " Base=" + prezzoBase +
                    " Lav=" + costoLavorazione + " Vend=" + prezzoVendita +
                    " Mat=" + materiale + " Perc%=" + percDeltaProvv);

                // =========================================================
                // PASSO 1 — PrezzoConLavorazione
                // Formula: CostoLavorazione + PrezzoBase
                // Colonna H — "Totale Mat+Lav"
                // =========================================================
                let prezzoConLav;
                if (manuale.PrezzoConLavorazione) {
                    prezzoConLav = safeField("#PrezzoConLavorazione");
                    log("PrezzoConLavorazione: VALORE FISSO →", prezzoConLav);
                } else {
                    prezzoConLav = roundTec(costoLavorazione + prezzoBase);
                    setField("PrezzoConLavorazioneDisplay", "PrezzoConLavorazione", prezzoConLav);
                    log("Calcolo PrezzoConLavorazione: [Lav](" + costoLavorazione +
                        ") + [Base](" + prezzoBase + ") = " + prezzoConLav);
                }

                // =========================================================
                // PASSO 2 — DeltaMargine
                // Formula: PrezzoVendita - PrezzoConLavorazione
                // Colonna J — "Delta (Margine)"
                // =========================================================
                let deltaMargine;
                if (manuale.DeltaMargine) {
                    deltaMargine = safeField("#DeltaMargine");
                    log("DeltaMargine: VALORE FISSO →", deltaMargine);
                } else {
                    deltaMargine = roundTec(prezzoVendita - prezzoConLav);
                    setField("DeltaMargineDisplay", "DeltaMargine", deltaMargine);
                    log("Calcolo DeltaMargine: [Vendita](" + prezzoVendita +
                        ") - [ConLav](" + prezzoConLav + ") = " + deltaMargine);
                }

                // =========================================================
                // PASSO 3 — ValUnitProvvigioneFissa1_5
                // Colonna K — "[1,50%]"
                // Formula: SE(Materiale="alluminio"; 0; PrezzoVendita * 1,5%)
                // Controllo case-insensitive sul nome del materiale.
                // =========================================================
                let valUnit1_5;
                if (manuale.ValUnitProvvigioneFissa1_5) {
                    valUnit1_5 = safeField("#ValUnitProvvigioneFissa1_5");
                    log("ValUnitProvvigioneFissa1_5: VALORE FISSO →", valUnit1_5);
                } else {
                    const isAlluminio = materiale.includes("alluminio");
                    valUnit1_5 = isAlluminio ? 0 : roundTec(prezzoVendita * 0.015);
                    setField("ValUnitProvvigioneFissa1_5Display", "ValUnitProvvigioneFissa1_5", valUnit1_5);
                    log("Calcolo ValUnitProvvigioneFissa1_5: Mat=" + materiale +
                        " Alluminio=" + isAlluminio + " Vendita=" + prezzoVendita + " → " + valUnit1_5);
                }

                // =========================================================
                // PASSO 4 — ValUnitProvvigioneFissa_03
                // Colonna O — "[3%]"
                // Formula: SE(Materiale="rame"; 0; PrezzoVendita * 3%)
                // Controllo case-insensitive sul nome del materiale.
                // =========================================================
                let valUnit03;
                if (manuale.ValUnitProvvigioneFissa_03) {
                    valUnit03 = safeField("#ValUnitProvvigioneFissa_03");
                    log("ValUnitProvvigioneFissa_03: VALORE FISSO →", valUnit03);
                } else {
                    const isRame = materiale.includes("rame");
                    valUnit03 = isRame ? 0 : roundTec(prezzoVendita * 0.03);
                    setField("ValUnitProvvigioneFissa_03Display", "ValUnitProvvigioneFissa_03", valUnit03);
                    log("Calcolo ValUnitProvvigioneFissa_03: Mat=" + materiale +
                        " Rame=" + isRame + " Vendita=" + prezzoVendita + " → " + valUnit03);
                }

                // =========================================================
                // PASSO 5a — Delta1ProvvigioneFissa1_5
                // Colonna L — "[1,5% < Delta]"
                // Formula: SE(ValUnit1_5 < DeltaMargine; ValUnit1_5; 0)
                // =========================================================
                let delta1_1_5;
                if (manuale.Delta1ProvvigioneFissa1_5) {
                    delta1_1_5 = safeField("#Delta1ProvvigioneFissa1_5");
                    log("Delta1ProvvigioneFissa1_5: VALORE FISSO →", delta1_1_5);
                } else {
                    delta1_1_5 = roundTec(valUnit1_5 < deltaMargine ? valUnit1_5 : 0);
                    setField("Delta1ProvvigioneFissa1_5Display", "Delta1ProvvigioneFissa1_5", delta1_1_5);
                    log("Calcolo Delta1ProvvigioneFissa1_5: ValUnit1_5=" + valUnit1_5 +
                        " < DeltaMargine=" + deltaMargine + " → " + delta1_1_5);
                }

                // =========================================================
                // PASSO 5b — Delta2ProvvigioneFissa1_5
                // Colonna M — "[1,5% > Delta]"
                // Formula: SE(DeltaMargine > ValUnit1_5; 0; DeltaMargine)
                // =========================================================
                let delta2_1_5;
                if (manuale.Delta2ProvvigioneFissa1_5) {
                    delta2_1_5 = safeField("#Delta2ProvvigioneFissa1_5");
                    log("Delta2ProvvigioneFissa1_5: VALORE FISSO →", delta2_1_5);
                } else {
                    delta2_1_5 = roundTec(deltaMargine > valUnit1_5 ? 0 : deltaMargine);
                    setField("Delta2ProvvigioneFissa1_5Display", "Delta2ProvvigioneFissa1_5", delta2_1_5);
                    log("Calcolo Delta2ProvvigioneFissa1_5: DeltaMargine=" + deltaMargine +
                        " > ValUnit1_5=" + valUnit1_5 + " → " + delta2_1_5);
                }

                // =========================================================
                // PASSO 5c — Delta1ProvvigioneFissa_03
                // Colonna P — "[3% < Delta]"
                // Formula: SE(ValUnit03 < DeltaMargine; ValUnit03; 0)
                // =========================================================
                let delta1_03;
                if (manuale.Delta1ProvvigioneFissa_03) {
                    delta1_03 = safeField("#Delta1ProvvigioneFissa_03");
                    log("Delta1ProvvigioneFissa_03: VALORE FISSO →", delta1_03);
                } else {
                    delta1_03 = roundTec(valUnit03 < deltaMargine ? valUnit03 : 0);
                    setField("Delta1ProvvigioneFissa_03Display", "Delta1ProvvigioneFissa_03", delta1_03);
                    log("Calcolo Delta1ProvvigioneFissa_03: ValUnit03=" + valUnit03 +
                        " < DeltaMargine=" + deltaMargine + " → " + delta1_03);
                }

                // =========================================================
                // PASSO 5d — Delta2ProvvigioneFissa_03
                // Colonna Q — "[3% > Delta]"
                // Formula: SE(DeltaMargine > ValUnit03; 0; DeltaMargine)
                // =========================================================
                let delta2_03;
                if (manuale.Delta2ProvvigioneFissa_03) {
                    delta2_03 = safeField("#Delta2ProvvigioneFissa_03");
                    log("Delta2ProvvigioneFissa_03: VALORE FISSO →", delta2_03);
                } else {
                    delta2_03 = roundTec(deltaMargine > valUnit03 ? 0 : deltaMargine);
                    setField("Delta2ProvvigioneFissa_03Display", "Delta2ProvvigioneFissa_03", delta2_03);
                    log("Calcolo Delta2ProvvigioneFissa_03: DeltaMargine=" + deltaMargine +
                        " > ValUnit03=" + valUnit03 + " → " + delta2_03);
                }

                // =========================================================
                // PASSO 6 — TotProvvigioneFissa1_5
                // Colonna N — "[1,5% fissa]"
                // Formula: Delta1_1_5 * Quantita
                // =========================================================
                let totFissa1_5;
                if (manuale.TotProvvigioneFissa1_5) {
                    totFissa1_5 = safeField("#TotProvvigioneFissa1_5");
                    log("TotProvvigioneFissa1_5: VALORE FISSO →", totFissa1_5);
                } else {
                    totFissa1_5 = roundTec(delta1_1_5 * quantita);
                    setField("TotProvvigioneFissa1_5Display", "TotProvvigioneFissa1_5", totFissa1_5);
                    log("Calcolo TotProvvigioneFissa1_5: Delta1_1_5=" + delta1_1_5 +
                        " * Qta=" + quantita + " = " + totFissa1_5);
                }

                // =========================================================
                // PASSO 7 — TotProvvigioneFissa_03
                // Colonna R — "[3% fissa]"
                // Formula: Delta1_03 * Quantita
                // =========================================================
                let totFissa03;
                if (manuale.TotProvvigioneFissa_03) {
                    totFissa03 = safeField("#TotProvvigioneFissa_03");
                    log("TotProvvigioneFissa_03: VALORE FISSO →", totFissa03);
                } else {
                    totFissa03 = roundTec(delta1_03 * quantita);
                    setField("TotProvvigioneFissa_03Display", "TotProvvigioneFissa_03", totFissa03);
                    log("Calcolo TotProvvigioneFissa_03: Delta1_03=" + delta1_03 +
                        " * Qta=" + quantita + " = " + totFissa03);
                }

                // =========================================================
                // PASSO 8 — ValQuotaFissa_1_5
                // Colonna S — "[Quota fissa 1,5%]"
                // Formula: SE(ValUnit1_5=0; 0; Delta2_1_5 * Quantita)
                // =========================================================
                let valQuota1_5;
                if (manuale.ValQuotaFissa_1_5) {
                    valQuota1_5 = safeField("#ValQuotaFissa_1_5");
                    log("ValQuotaFissa_1_5: VALORE FISSO →", valQuota1_5);
                } else {
                    valQuota1_5 = roundTec(valUnit1_5 === 0 ? 0 : delta2_1_5 * quantita);
                    setField("ValQuotaFissa_1_5Display", "ValQuotaFissa_1_5", valQuota1_5);
                    log("Calcolo ValQuotaFissa_1_5: ValUnit1_5=" + valUnit1_5 +
                        " Delta2_1_5=" + delta2_1_5 + " Qta=" + quantita + " → " + valQuota1_5);
                }

                // =========================================================
                // PASSO 9 — ValQuotaFissa_03
                // Colonna T — "[Quota fissa 3%]"
                // Formula: SE(ValUnit1_5=0; Delta2_03 * Quantita; 0)
                // =========================================================
                let valQuota03;
                if (manuale.ValQuotaFissa_03) {
                    valQuota03 = safeField("#ValQuotaFissa_03");
                    log("ValQuotaFissa_03: VALORE FISSO →", valQuota03);
                } else {
                    valQuota03 = roundTec(valUnit1_5 === 0 ? delta2_03 * quantita : 0);
                    setField("ValQuotaFissa_03Display", "ValQuotaFissa_03", valQuota03);
                    log("Calcolo ValQuotaFissa_03: ValUnit1_5=" + valUnit1_5 +
                        " Delta2_03=" + delta2_03 + " Qta=" + quantita + " → " + valQuota03);
                }

                // =========================================================
                // PASSO 10 — TotaleFissoProvvigione
                // Colonna U — "Totale"
                // Formula: TotFissa1_5 + TotFissa03 + ValQuota1_5 + ValQuota03
                // =========================================================
                let totaleFisso;
                if (manuale.TotaleFissoProvvigione) {
                    totaleFisso = safeField("#TotaleFissoProvvigione");
                    log("TotaleFissoProvvigione: VALORE FISSO →", totaleFisso);
                } else {
                    totaleFisso = roundTec(totFissa1_5 + totFissa03 + valQuota1_5 + valQuota03);
                    setField("TotaleFissoProvvigioneDisplay", "TotaleFissoProvvigione", totaleFisso);
                    log("Calcolo TotaleFissoProvvigione: " + totFissa1_5 + " + " +
                        totFissa03 + " + " + valQuota1_5 + " + " + valQuota03 + " = " + totaleFisso);
                }

                // =========================================================
                // PASSO 11 — DeltaResiduoVariabile
                // Colonna V — "Delta (Residuo Var.)"
                // Formula originale Excel:
                //   SE(Delta1_03=0; 0; Vendita-ConLav-ValUnit03)
                //   + SE(Delta1_1_5=0; 0; Vendita-ConLav-ValUnit1_5)
                // Semplificata come: MAX(0, DeltaMargine - ValUnit03 - ValUnit1_5)
                // Le due formule sono equivalenti perché:
                //   - se Delta1=0 significa che il ValUnit >= DeltaMargine, quindi
                //     DeltaMargine - ValUnit sarebbe negativo → MAX(0,...) restituisce 0
                // =========================================================
                let deltaResiduo;
                if (manuale.DeltaResiduoVariabile) {
                    deltaResiduo = safeField("#DeltaResiduoVariabile");
                    log("DeltaResiduoVariabile: VALORE FISSO →", deltaResiduo);
                } else {
                    deltaResiduo = roundTec(Math.max(0, deltaMargine - valUnit03 - valUnit1_5));
                    setField("DeltaResiduoVariabileDisplay", "DeltaResiduoVariabile", deltaResiduo);
                    log("Calcolo DeltaResiduoVariabile: MAX(0, DeltaMargine=" + deltaMargine +
                        " - ValUnit03=" + valUnit03 + " - ValUnit1_5=" + valUnit1_5 +
                        ") = " + deltaResiduo);
                }

                // =========================================================
                // PASSO 12 — TotaleVariabileProvvigione
                // Colonna W — "Totale provv variabile"
                // Formula: (DeltaResiduo * (Perc_Delta_Provvigione / 100)) * Quantita
                //
                // CONVENZIONE: Perc_Delta_Provvigione è in formato intero (es. 60 = 60%),
                // quindi si divide sempre per 100. Non modificare questa divisione.
                // Perc_Delta_Provvigione è un INPUT MANUALE (manuale.Perc_Delta_Provvigione
                // controlla solo l'editabilità UI, non esclude il valore dai calcoli).
                // =========================================================
                let totaleVariabile;
                if (manuale.TotaleVariabileProvvigione) {
                    totaleVariabile = safeField("#TotaleVariabileProvvigione");
                    log("TotaleVariabileProvvigione: VALORE FISSO →", totaleVariabile);
                } else {
                    totaleVariabile = roundTec((deltaResiduo * (percDeltaProvv / 100)) * quantita);
                    setField("TotaleVariabileProvvigioneDisplay", "TotaleVariabileProvvigione", totaleVariabile);
                    log("Calcolo TotaleVariabileProvvigione: DeltaResiduo=" + deltaResiduo +
                        " * (Perc%=" + percDeltaProvv + "/100) * Qta=" + quantita + " = " + totaleVariabile);
                }

                // =========================================================
                // PASSO 13 — TotaleSommaProvvigioni
                // Colonna X — "Tot. Provv."
                // Formula: TotaleFisso + TotaleVariabile
                // =========================================================
                let totaleSomma;
                if (manuale.TotaleSommaProvvigioni) {
                    totaleSomma = safeField("#TotaleSommaProvvigioni");
                    log("TotaleSommaProvvigioni: VALORE FISSO →", totaleSomma);
                } else {
                    totaleSomma = roundTec(totaleFisso + totaleVariabile);
                    setField("TotaleSommaProvvigioniDisplay", "TotaleSommaProvvigioni", totaleSomma);
                    log("Calcolo TotaleSommaProvvigioni: Fisso=" + totaleFisso +
                        " + Variabile=" + totaleVariabile + " = " + totaleSomma);
                }

                // =========================================================
                // PASSO 14 — TotaleProvvigioneDaFatturare
                // Colonna Z — "Totale Da Fatturare"
                // Formula: SE(TotaleSomma > PrezzoVendita; TotaleSomma; PrezzoVendita)
                // =========================================================
                if (!manuale.TotaleProvvigioneDaFatturare) {
                    const totFatturare = roundTec(totaleSomma > prezzoVendita ? totaleSomma : prezzoVendita);
                    setField("TotaleProvvigioneDaFatturareDisplay", "TotaleProvvigioneDaFatturare", totFatturare);
                    log("Calcolo TotaleProvvigioneDaFatturare: MAX(TotaleSomma=" + totaleSomma +
                        ", Vendita=" + prezzoVendita + ") = " + totFatturare);
                } else {
                    log("TotaleProvvigioneDaFatturare: VALORE FISSO →", safeField("#TotaleProvvigioneDaFatturare"));
                }

                log("<<< Ricalcolo globale completato");
            }

            // ============================================================
            // 5. PROVVIGIONE AGENTE — gestita separatamente (AJAX)
            // Non fa parte della pipeline dei derivati numerici.
            // ============================================================
            /**
             * Recupera la percentuale provvigione agente specifica dal server tramite AJAX.
             * Non sovrascrive se il lucchetto è aperto (manuale.ProvvigioneAgente = true).
             */
            function ricalcolaProvvigioneAgente() {
                if (manuale.ProvvigioneAgente) return;

                const idAgente  = $("#IdAgente").val();
                const idCliente = $("#IdCliente").val();

                if (!idAgente || !idCliente || idAgente === "0" || idCliente === "0") return;

                $.getJSON(
                    '/Admin/ProspettiCobral/GetPercentualeProvvigione',
                    { idAgente, idCliente },
                    function (percentuale) {
                        const valTec = roundTec(safeNum(percentuale));
                        const valVis = roundDisplay(valTec);
                        log("AJAX ProvvigioneAgente: " + percentuale + " → " + valTec);
                        $("#ProvvigioneAgenteDisplay").val(valVis);
                        $("#ProvvigioneAgente").val(valTec);
                    }
                ).fail(function () {
                    log("ERRORE AJAX ProvvigioneAgente");
                });
            }

            // ============================================================
            // rilevaDivergenze — inizializzazione automatica lucchetti
            // ============================================================
            // Problema: un campo calcolato può essere stato forzato manualmente
            // nel DB. In quel caso, al primo input dell'utente ricalcolaTutto()
            // sovrascriverà il valore forzato con quello della formula.
            //
            // Soluzione: al caricamento confronta il valore nel campo Hidden
            // (= DB) con il risultato della formula corrispondente.
            // Se differiscono oltre la soglia (0.0001), imposta
            // manuale[chiave] = true e apre il lucchetto visivo.
            //
            // DIFFERENZA RISPETTO AGLI ALTRI MODULI:
            // Qui non ci sono funzioni pure calcola_* separate perché la
            // pipeline è stateless e sequenziale: rileggere i campi dal DOM
            // nella sequenza corretta equivale a chiamare le funzioni pure.
            // Il confronto avviene leggendo gli hidden DB e calcolando il
            // valore atteso dalla formula SENZA scrivere nel DOM
            // (usando variabili locali, non setField).
            //
            // ORDINE: dal livello più basso verso il più alto della catena,
            // così ogni passo usa valori DB originali dagli hidden per il
            // confronto del passo successivo.
            // ============================================================
            function rilevaDivergenze() {
                const SOGLIA = 0.001;

                /**
                 * Apre il lucchetto per una chiave se il valore DB diverge dal calcolato.
                 * param {string} chiave      - chiave nell'oggetto manuale
                 * param {string} idBtn       - selettore del pulsante lucchetto
                 * param {string} idDisplay   - selettore del campo Display
                 * param {number} valoreDB    - valore attuale nel campo Hidden (dal DB)
                 * param {number} valoreCalc  - valore che la formula produrrebbe
                 */
                function apriSeNecessario(chiave, idBtn, idDisplay, valoreDB, valoreCalc) {
                    if (Math.abs(valoreDB - valoreCalc) > SOGLIA) {
                        log(" Valore forzato rilevato per [" + chiave + "]" +
                            " | DB=" + valoreDB + " | Calcolato=" + valoreCalc +
                            " → lucchetto aperto automaticamente");
                        manuale[chiave] = true;
                        // Apre il lucchetto visivamente (stesso effetto del click utente)
                        $(idDisplay).prop("readonly", false).removeClass("input-readonly");
                        $(idBtn).removeClass("btn-success").addClass("btn-danger")
                                .html('<i class="bi bi-unlock-fill"></i>');
                    }
                }

                // ---------------------------------------------------------
                // Leggi i campi base una sola volta (non vengono mai forzati)
                // ---------------------------------------------------------
                const quantita         = safeField("#Quantita");
                const prezzoBase       = safeField("#PrezzoBase");
                const costoLavorazione = safeField("#CostoLavorazione");
                const prezzoVendita    = safeField("#PrezzoVendita");
                const percDeltaProvv   = safeField("#Perc_Delta_Provvigione");
                const materiale        = ($("#IdMateriale option:selected").text() || "").trim().toLowerCase();
                const isAlluminio      = materiale.includes("alluminio");
                const isRame           = materiale.includes("rame");

                // ---------------------------------------------------------
                // PASSO 1 — PrezzoConLavorazione
                // Calcola il valore atteso e confronta con il DB.
                // Se coincidono, il lucchetto rimane chiuso (formula attiva).
                // Se divergono, apre il lucchetto e usa il valore DB per i passi successivi.
                // ---------------------------------------------------------
                const calcConLav = roundTec(costoLavorazione + prezzoBase);
                const dbConLav   = safeField("#PrezzoConLavorazione");
                apriSeNecessario("PrezzoConLavorazione", "#togglePrezzoConLavorazione",
                                 "#PrezzoConLavorazioneDisplay", dbConLav, calcConLav);
                // Usa il valore corretto per il passo successivo:
                // se forzato, usa il DB; se formula, usa il calcolato.
                const prezzoConLav = manuale.PrezzoConLavorazione ? dbConLav : calcConLav;

                // ---------------------------------------------------------
                // PASSO 2 — DeltaMargine
                // ---------------------------------------------------------
                const calcDelta = roundTec(prezzoVendita - prezzoConLav);
                const dbDelta   = safeField("#DeltaMargine");
                apriSeNecessario("DeltaMargine", "#toggleDelta",
                                 "#DeltaMargineDisplay", dbDelta, calcDelta);
                const deltaMargine = manuale.DeltaMargine ? dbDelta : calcDelta;

                // ---------------------------------------------------------
                // PASSO 3 — ValUnitProvvigioneFissa1_5
                // ---------------------------------------------------------
                const calcValUnit1_5 = isAlluminio ? 0 : roundTec(prezzoVendita * 0.015);
                const dbValUnit1_5   = safeField("#ValUnitProvvigioneFissa1_5");
                apriSeNecessario("ValUnitProvvigioneFissa1_5", "#toggleValUnitProvvigioneFissa1_5",
                                 "#ValUnitProvvigioneFissa1_5Display", dbValUnit1_5, calcValUnit1_5);
                const valUnit1_5 = manuale.ValUnitProvvigioneFissa1_5 ? dbValUnit1_5 : calcValUnit1_5;

                // ---------------------------------------------------------
                // PASSO 4 — ValUnitProvvigioneFissa_03
                // ---------------------------------------------------------
                const calcValUnit03 = isRame ? 0 : roundTec(prezzoVendita * 0.03);
                const dbValUnit03   = safeField("#ValUnitProvvigioneFissa_03");
                apriSeNecessario("ValUnitProvvigioneFissa_03", "#toggleValUnitProvvigioneFissa_03",
                                 "#ValUnitProvvigioneFissa_03Display", dbValUnit03, calcValUnit03);
                const valUnit03 = manuale.ValUnitProvvigioneFissa_03 ? dbValUnit03 : calcValUnit03;

                // ---------------------------------------------------------
                // PASSO 5a — Delta1ProvvigioneFissa1_5
                // ---------------------------------------------------------
                const calcDelta1_1_5 = roundTec(valUnit1_5 < deltaMargine ? valUnit1_5 : 0);
                const dbDelta1_1_5   = safeField("#Delta1ProvvigioneFissa1_5");
                apriSeNecessario("Delta1ProvvigioneFissa1_5", "#toggleDelta1ProvvigioneFissa1_5",
                                 "#Delta1ProvvigioneFissa1_5Display", dbDelta1_1_5, calcDelta1_1_5);
                const delta1_1_5 = manuale.Delta1ProvvigioneFissa1_5 ? dbDelta1_1_5 : calcDelta1_1_5;

                // ---------------------------------------------------------
                // PASSO 5b — Delta2ProvvigioneFissa1_5
                // ---------------------------------------------------------
                const calcDelta2_1_5 = roundTec(deltaMargine > valUnit1_5 ? 0 : deltaMargine);
                const dbDelta2_1_5   = safeField("#Delta2ProvvigioneFissa1_5");
                apriSeNecessario("Delta2ProvvigioneFissa1_5", "#toggleDelta2ProvvigioneFissa1_5",
                                 "#Delta2ProvvigioneFissa1_5Display", dbDelta2_1_5, calcDelta2_1_5);
                const delta2_1_5 = manuale.Delta2ProvvigioneFissa1_5 ? dbDelta2_1_5 : calcDelta2_1_5;

                // ---------------------------------------------------------
                // PASSO 5c — Delta1ProvvigioneFissa_03
                // ---------------------------------------------------------
                const calcDelta1_03 = roundTec(valUnit03 < deltaMargine ? valUnit03 : 0);
                const dbDelta1_03   = safeField("#Delta1ProvvigioneFissa_03");
                apriSeNecessario("Delta1ProvvigioneFissa_03", "#toggleDelta1ProvvigioneFissa_03",
                                 "#Delta1ProvvigioneFissa_03Display", dbDelta1_03, calcDelta1_03);
                const delta1_03 = manuale.Delta1ProvvigioneFissa_03 ? dbDelta1_03 : calcDelta1_03;

                // ---------------------------------------------------------
                // PASSO 5d — Delta2ProvvigioneFissa_03
                // ---------------------------------------------------------
                const calcDelta2_03 = roundTec(deltaMargine > valUnit03 ? 0 : deltaMargine);
                const dbDelta2_03   = safeField("#Delta2ProvvigioneFissa_03");
                apriSeNecessario("Delta2ProvvigioneFissa_03", "#toggleDelta2ProvvigioneFissa_03",
                                 "#Delta2ProvvigioneFissa_03Display", dbDelta2_03, calcDelta2_03);
                const delta2_03 = manuale.Delta2ProvvigioneFissa_03 ? dbDelta2_03 : calcDelta2_03;

                // ---------------------------------------------------------
                // PASSO 6 — TotProvvigioneFissa1_5
                // ---------------------------------------------------------
                const calcTotFissa1_5 = roundTec(delta1_1_5 * quantita);
                const dbTotFissa1_5   = safeField("#TotProvvigioneFissa1_5");
                apriSeNecessario("TotProvvigioneFissa1_5", "#toggleTotProvvigioneFissa1_5",
                                 "#TotProvvigioneFissa1_5Display", dbTotFissa1_5, calcTotFissa1_5);
                const totFissa1_5 = manuale.TotProvvigioneFissa1_5 ? dbTotFissa1_5 : calcTotFissa1_5;

                // ---------------------------------------------------------
                // PASSO 7 — TotProvvigioneFissa_03
                // ---------------------------------------------------------
                const calcTotFissa03 = roundTec(delta1_03 * quantita);
                const dbTotFissa03   = safeField("#TotProvvigioneFissa_03");
                apriSeNecessario("TotProvvigioneFissa_03", "#toggleTotProvvigioneFissa_03",
                                 "#TotProvvigioneFissa_03Display", dbTotFissa03, calcTotFissa03);
                const totFissa03 = manuale.TotProvvigioneFissa_03 ? dbTotFissa03 : calcTotFissa03;

                // ---------------------------------------------------------
                // PASSO 8 — ValQuotaFissa_1_5
                // ---------------------------------------------------------
                const calcValQuota1_5 = roundTec(valUnit1_5 === 0 ? 0 : delta2_1_5 * quantita);
                const dbValQuota1_5   = safeField("#ValQuotaFissa_1_5");
                apriSeNecessario("ValQuotaFissa_1_5", "#toggleValQuotaFissa_1_5",
                                 "#ValQuotaFissa_1_5Display", dbValQuota1_5, calcValQuota1_5);
                const valQuota1_5 = manuale.ValQuotaFissa_1_5 ? dbValQuota1_5 : calcValQuota1_5;

                // ---------------------------------------------------------
                // PASSO 9 — ValQuotaFissa_03
                // ---------------------------------------------------------
                const calcValQuota03 = roundTec(valUnit1_5 === 0 ? delta2_03 * quantita : 0);
                const dbValQuota03   = safeField("#ValQuotaFissa_03");
                apriSeNecessario("ValQuotaFissa_03", "#toggleValQuotaFissa_03",
                                 "#ValQuotaFissa_03Display", dbValQuota03, calcValQuota03);
                const valQuota03 = manuale.ValQuotaFissa_03 ? dbValQuota03 : calcValQuota03;

                // ---------------------------------------------------------
                // PASSO 10 — TotaleFissoProvvigione
                // ---------------------------------------------------------
                const calcTotaleFisso = roundTec(totFissa1_5 + totFissa03 + valQuota1_5 + valQuota03);
                const dbTotaleFisso   = safeField("#TotaleFissoProvvigione");
                apriSeNecessario("TotaleFissoProvvigione", "#toggleTotaleFissoProvvigione",
                                 "#TotaleFissoProvvigioneDisplay", dbTotaleFisso, calcTotaleFisso);
                const totaleFisso = manuale.TotaleFissoProvvigione ? dbTotaleFisso : calcTotaleFisso;

                // ---------------------------------------------------------
                // PASSO 11 — DeltaResiduoVariabile
                // ---------------------------------------------------------
                const calcDeltaResiduo = roundTec(Math.max(0, deltaMargine - valUnit03 - valUnit1_5));
                const dbDeltaResiduo   = safeField("#DeltaResiduoVariabile");
                apriSeNecessario("DeltaResiduoVariabile", "#toggleDeltaResiduoVariabile",
                                 "#DeltaResiduoVariabileDisplay", dbDeltaResiduo, calcDeltaResiduo);
                const deltaResiduo = manuale.DeltaResiduoVariabile ? dbDeltaResiduo : calcDeltaResiduo;

                // ---------------------------------------------------------
                // PASSO 12 — TotaleVariabileProvvigione
                // ---------------------------------------------------------
                const calcTotaleVariabile = roundTec((deltaResiduo * (percDeltaProvv / 100)) * quantita);
                const dbTotaleVariabile   = safeField("#TotaleVariabileProvvigione");
                apriSeNecessario("TotaleVariabileProvvigione", "#toggleTotaleVariabileProvvigione",
                                 "#TotaleVariabileProvvigioneDisplay", dbTotaleVariabile, calcTotaleVariabile);
                const totaleVariabile = manuale.TotaleVariabileProvvigione ? dbTotaleVariabile : calcTotaleVariabile;

                // ---------------------------------------------------------
                // PASSO 13 — TotaleSommaProvvigioni
                // ---------------------------------------------------------
                const calcTotaleSomma = roundTec(totaleFisso + totaleVariabile);
                const dbTotaleSomma   = safeField("#TotaleSommaProvvigioni");
                apriSeNecessario("TotaleSommaProvvigioni", "#toggleTotaleSommaProvvigioni",
                                 "#TotaleSommaProvvigioniDisplay", dbTotaleSomma, calcTotaleSomma);
                const totaleSomma = manuale.TotaleSommaProvvigioni ? dbTotaleSomma : calcTotaleSomma;

                // ---------------------------------------------------------
                // PASSO 14 — TotaleProvvigioneDaFatturare
                // ---------------------------------------------------------
                const calcTotFatturare = roundTec(totaleSomma > prezzoVendita ? totaleSomma : prezzoVendita);
                const dbTotFatturare   = safeField("#TotaleProvvigioneDaFatturare");
                apriSeNecessario("TotaleProvvigioneDaFatturare", "#toggleTotaleProvvigioneDaFatturare",
                                 "#TotaleProvvigioneDaFatturareDisplay", dbTotFatturare, calcTotFatturare);

                log("rilevaDivergenze completata. Campi con valore forzato:",
                    Object.keys(manuale).filter(k => manuale[k]).join(", ") || "nessuno");
            }

            // ============================================================
            // 6. GESTIONE LUCCHETTI
            //
            // Il pulsante lucchetto funziona esattamente come in Excel:
            //
            //   LUCCHETTO CHIUSO (verde, icona lock)
            //     → manuale = false
            //     → il campo è "protetto": ricalcolaTutto() lo sovrascriverà
            //       al prossimo cambio di un campo base
            //     → il Display è readonly
            //     → il valore attuale NON viene toccato: rimane quello
            //       che c'era prima (inserito manualmente o calcolato)
            //
            //   LUCCHETTO APERTO (rosso, icona unlock)
            //     → manuale = true
            //     → il campo è editabile: l'admin scrive un valore manuale
            //     → ricalcolaTutto() usa quel valore per i passi a valle
            //       senza mai sovrascriverlo
            //     → il Display è editabile
            //
            //   CHIUSURA LUCCHETTO (da rosso a verde):
            //     → manuale torna false
            //     → il valore nel campo RIMANE INVARIATO (come in Excel:
            //       proteggere una cella non cambia il suo contenuto)
            //     → al prossimo cambio di un campo base, ricalcolaTutto()
            //       sovrascriverà questo campo con il valore calcolato
            // ============================================================
            function setupToggle(idBtn, idDisplay, chiave) {
                $(idBtn).on("click", function () {
                    const staAprendo = !manuale[chiave];
                    manuale[chiave] = staAprendo;

                    const $input = $(idDisplay);
                    const $btn   = $(this);

                    if (staAprendo) {
                        // === APRO IL LUCCHETTO: admin può scrivere ===
                        $input.prop("readonly", false).removeClass("input-readonly");
                        $btn.removeClass("btn-success").addClass("btn-danger")
                            .html('<i class="bi bi-unlock-fill"></i>');
                        log("Lucchetto APERTO (manuale=true): " + chiave);

                    } else {
                        // === CHIUDO IL LUCCHETTO: campo torna protetto ===
                        // Il valore rimane INVARIATO — verrà sovrascritto
                        // solo al prossimo cambio di un campo base.
                        $input.prop("readonly", true).addClass("input-readonly");
                        $btn.removeClass("btn-danger").addClass("btn-success")
                            .html('<i class="bi bi-lock-fill"></i>');
                        // Sincronizza hidden dal valore attuale del display
                        const hiddenId = idDisplay.replace("#", "").replace("Display", "");
                        $("#" + hiddenId).val(roundTec(safeNum($input.val())));
                        log("Lucchetto CHIUSO (protetto, valore invariato): " + chiave + " = " + $input.val());
                    }
                });
            }

            setupToggle("#togglePrezzoConLavorazione",         "#PrezzoConLavorazioneDisplay",        "PrezzoConLavorazione");
            setupToggle("#toggleDelta",                        "#DeltaMargineDisplay",                "DeltaMargine");
            setupToggle("#toggleValUnitProvvigioneFissa1_5",   "#ValUnitProvvigioneFissa1_5Display",  "ValUnitProvvigioneFissa1_5");
            setupToggle("#toggleDelta1ProvvigioneFissa1_5",    "#Delta1ProvvigioneFissa1_5Display",   "Delta1ProvvigioneFissa1_5");
            setupToggle("#toggleDelta2ProvvigioneFissa1_5",    "#Delta2ProvvigioneFissa1_5Display",   "Delta2ProvvigioneFissa1_5");
            setupToggle("#toggleValUnitProvvigioneFissa_03",   "#ValUnitProvvigioneFissa_03Display",  "ValUnitProvvigioneFissa_03");
            setupToggle("#toggleDelta1ProvvigioneFissa_03",    "#Delta1ProvvigioneFissa_03Display",   "Delta1ProvvigioneFissa_03");
            setupToggle("#toggleDelta2ProvvigioneFissa_03",    "#Delta2ProvvigioneFissa_03Display",   "Delta2ProvvigioneFissa_03");
            setupToggle("#toggleTotProvvigioneFissa_03",       "#TotProvvigioneFissa_03Display",      "TotProvvigioneFissa_03");
            setupToggle("#toggleValQuotaFissa_1_5",            "#ValQuotaFissa_1_5Display",           "ValQuotaFissa_1_5");
            setupToggle("#toggleValQuotaFissa_03",             "#ValQuotaFissa_03Display",            "ValQuotaFissa_03");
            setupToggle("#toggleTotaleFissoProvvigione",       "#TotaleFissoProvvigioneDisplay",      "TotaleFissoProvvigione");
            setupToggle("#toggleDeltaResiduoVariabile",        "#DeltaResiduoVariabileDisplay",       "DeltaResiduoVariabile");
            setupToggle("#toggleTotaleVariabileProvvigione",   "#TotaleVariabileProvvigioneDisplay",  "TotaleVariabileProvvigione");
            setupToggle("#toggleTotaleSommaProvvigioni",       "#TotaleSommaProvvigioniDisplay",      "TotaleSommaProvvigioni");
            setupToggle("#toggleTotaleProvvigioneDaFatturare", "#TotaleProvvigioneDaFatturareDisplay","TotaleProvvigioneDaFatturare");
            setupToggle("#toggleTotProvvigioneFissa1_5",       "#TotProvvigioneFissa1_5Display",      "TotProvvigioneFissa1_5");
            setupToggle("#toggleProvAgente",                   "#ProvvigioneAgenteDisplay",           "ProvvigioneAgente");
            setupToggle("#togglePerc_Delta_Provvigione",       "#Perc_Delta_ProvvigioneDisplay",      "Perc_Delta_Provvigione");

            // ============================================================
            // 7. SINCRONIZZAZIONE Display → Hidden per campi sbloccati
            //
            // Quando l'admin modifica un Display manualmente (manuale=true):
            //   1. aggiorna il campo hidden corrispondente (per il POST)
            //   2. rilancia ricalcolaTutto() — i passi a VALLE di questo
            //      campo useranno il valore manuale come input;
            //      i passi a MONTE non vengono toccati (manuale=true li salta)
            // ============================================================
            $("input[id$='Display']").on("input", function () {
                const displayId = $(this).attr("id");
                const hiddenId  = displayId.replace("Display", "");
                const $hidden   = $("#" + hiddenId);

                if ($hidden.length > 0) {
                    $hidden.val(roundTec(safeNum($(this).val())));
                }

                // Rilancia sempre la pipeline completa.
                // I campi con manuale=true verranno letti dal DOM (appena aggiornati).
                // I campi con manuale=false verranno ricalcolati dalla formula.
                ricalcolaTutto();
            });

            // ============================================================
            // 8. EVENT LISTENERS & INIZIALIZZAZIONI
            // ============================================================

            // Qualsiasi modifica ai campi base → ricalcola tutto.
            $("#CostoLavorazione, #PrezzoBase").on("input", ricalcolaTutto);
            $("#PrezzoVendita").on("input", ricalcolaTutto);
            $("#Quantita").on("input", ricalcolaTutto);

            // CORREZIONE rispetto all'originale: il materiale viene letto da
            // "#IdMateriale option:selected" dentro ricalcolaTutto(), quindi
            // il listener corretto è su #IdMateriale (cambio della select),
            // non su #DescrizioneMateriale (campo testuale non esistente nella form).
            $("#IdMateriale").on("change", ricalcolaTutto);

            // Monitora il cambio di selezione nelle DropDownList Agente/Cliente.
            $("#IdAgente, #IdCliente").on("change", ricalcolaProvvigioneAgente);

            // ============================================================
            // INIZIALIZZAZIONE
            // ============================================================
            // Ordine obbligatorio:
            //   1. rilevaDivergenze() — legge gli hidden DB e imposta
            //      manuale[chiave]=true per i campi forzati, PRIMA che
            //      qualsiasi input dell'utente possa scatenare ricalcolaTutto().
            //   2. NESSUN ricalcolaTutto() all'avvio — i valori DB sono già
            //      corretti nei Display grazie a Razor. La scelta progettuale
            //      originale viene preservata: il calcolo parte solo su input
            //      dell'utente. rilevaDivergenze() garantisce che i campi
            //      forzati non vengano sovrascritti al primo input.
            //   3. Provvigione agente — carica via AJAX solo se zero.
            // ============================================================
            rilevaDivergenze();

            if ($("#IdAgente").val() && $("#IdCliente").val()) {
                const valAttuale = safeField("#ProvvigioneAgente");
                if (valAttuale === 0) ricalcolaProvvigioneAgente();
            }

            // ============================================================
            // debugValoriIniziali — utility di diagnostica
            // Stampa in console tutti i valori numerici rilevanti al caricamento.
            // Utile per verificare che Razor abbia popolato correttamente i campi.
            // ============================================================
            function debugValoriIniziali() {
                log("=== DEBUG COMPLETO: TUTTI I CAMPI NUMERICI CHE ENTRANO NEI CALCOLI ===");

                const campi = [
                    { id: "#Quantita",                          label: "Quantità" },
                    { id: "#CostoLavorazione",                  label: "Costo Lavorazione" },
                    { id: "#PrezzoBase",                        label: "Prezzo Base" },
                    { id: "#PrezzoConLavorazioneDisplay",       label: "Totale Mat+Lav (Display)" },
                    { id: "#PrezzoConLavorazione",              label: "Totale Mat+Lav (Hidden)" },
                    { id: "#PrezzoVendita",                     label: "Prezzo Vendita" },
                    { id: "#DeltaMargineDisplay",               label: "Delta Margine (Display)" },
                    { id: "#DeltaMargine",                      label: "Delta Margine (Hidden)" },
                    { id: "#ValUnitProvvigioneFissa1_5Display", label: "ValUnit 1,5% (Display)" },
                    { id: "#ValUnitProvvigioneFissa1_5",        label: "ValUnit 1,5% (Hidden)" },
                    { id: "#Delta1ProvvigioneFissa1_5Display",  label: "Delta1 1,5% (Display)" },
                    { id: "#Delta1ProvvigioneFissa1_5",         label: "Delta1 1,5% (Hidden)" },
                    { id: "#Delta2ProvvigioneFissa1_5Display",  label: "Delta2 1,5% (Display)" },
                    { id: "#Delta2ProvvigioneFissa1_5",         label: "Delta2 1,5% (Hidden)" },
                    { id: "#TotProvvigioneFissa1_5Display",     label: "Tot Fissa 1,5% (Display)" },
                    { id: "#TotProvvigioneFissa1_5",            label: "Tot Fissa 1,5% (Hidden)" },
                    { id: "#ValUnitProvvigioneFissa_03Display", label: "ValUnit 3% (Display)" },
                    { id: "#ValUnitProvvigioneFissa_03",        label: "ValUnit 3% (Hidden)" },
                    { id: "#Delta1ProvvigioneFissa_03Display",  label: "Delta1 3% (Display)" },
                    { id: "#Delta1ProvvigioneFissa_03",         label: "Delta1 3% (Hidden)" },
                    { id: "#Delta2ProvvigioneFissa_03Display",  label: "Delta2 3% (Display)" },
                    { id: "#Delta2ProvvigioneFissa_03",         label: "Delta2 3% (Hidden)" },
                    { id: "#TotProvvigioneFissa_03Display",     label: "Tot Fissa 3% (Display)" },
                    { id: "#TotProvvigioneFissa_03",            label: "Tot Fissa 3% (Hidden)" },
                    { id: "#ValQuotaFissa_1_5Display",          label: "Quota Fissa 1,5% (Display)" },
                    { id: "#ValQuotaFissa_1_5",                 label: "Quota Fissa 1,5% (Hidden)" },
                    { id: "#ValQuotaFissa_03Display",           label: "Quota Fissa 3% (Display)" },
                    { id: "#ValQuotaFissa_03",                  label: "Quota Fissa 3% (Hidden)" },
                    { id: "#TotaleFissoProvvigioneDisplay",     label: "Totale Fisso Provvigione (Display)" },
                    { id: "#TotaleFissoProvvigione",            label: "Totale Fisso Provvigione (Hidden)" },
                    { id: "#DeltaResiduoVariabileDisplay",      label: "Delta Residuo (Display)" },
                    { id: "#DeltaResiduoVariabile",             label: "Delta Residuo (Hidden)" },
                    { id: "#Perc_Delta_ProvvigioneDisplay",     label: "% Delta Provvigione (Display)" },
                    { id: "#Perc_Delta_Provvigione",            label: "% Delta Provvigione (Hidden)" },
                    { id: "#TotaleVariabileProvvigioneDisplay", label: "Totale Variabile (Display)" },
                    { id: "#TotaleVariabileProvvigione",        label: "Totale Variabile (Hidden)" },
                    { id: "#TotaleSommaProvvigioniDisplay",     label: "Totale Somma Provvigioni (Display)" },
                    { id: "#TotaleSommaProvvigioni",            label: "Totale Somma Provvigioni (Hidden)" },
                    { id: "#TotaleProvvigioneDaFatturareDisplay", label: "Totale Da Fatturare (Display)" },
                    { id: "#TotaleProvvigioneDaFatturare",      label: "Totale Da Fatturare (Hidden)" }
                ];

                let riepilogo = {};
                campi.forEach(campo => {
                    const raw    = $(campo.id).val();
                    const parsed = safeField(campo.id);
                    riepilogo[campo.label] = parsed;
                    if (raw === undefined) {
                        console.error("️ CAMPO MANCANTE: " + campo.id);
                    } else {
                        log(campo.label + ": HTML=[" + raw + "] | Interpretato=[" + parsed + "]");
                    }
                });
                console.table(riepilogo);
                log("=== FINE DEBUG COMPLETO ===");
            }

